ENDSECTION
MOVED_0A20_SIZE = moved_0a20_end - &0A20
ASSERT MOVED_0A20_SIZE <= &2E0, "moved_0a20 overruns &0CFF by ", MOVED_0A20_SIZE - &2E0   \ decision 40: to &0CFF

\ ---- Step 2 layer 4: run once from entry_point, carried in the save arena (decision 33) ----
\ unpack_for_play: the player's compiled sprite kinds that live in HAZEL (tools/compiled.py) copied
\ into it from their carriers - part A in bank 5's music area, part B here - and then the front
\ end's tunes unpacked into that area (src/music_packed.6502, ZX02). HAZEL is the filing system's
\ workspace, released by mgame_relocate's *TAPE; the MOS leaves it paged in (ACCCON's Y bit) through
\ play, which this sets too. Nothing reads HAZEL after the start but the scroll's mountain layer,
\ &C300 on (tools/hazelwatch.mjs, tools/hazelreach.mjs), below HAZEL_ORG.
zxsrc = &C0                         \ the depacker's zero page, and the copy's (the filing system's,
zxdst = &C2                         \ free after *TAPE; the renderer's scratch later)
zxofs = &C4
zxbit = &C5
zxwrk = &C6
up_n  = &C8
.unpack_for_play
{
    SEI
    LDA acccon
    ORA #&08                        \ Y: HAZEL at &C000-&DFFF
    STA acccon
    CLI
    LDA #&05                        \ bank 5: part A's carrier, and the tunes' place
    STA os_ram_copy_of_currently_selected_rom
    STA romsel
    LDA #LO(hazel_a_load)
    STA zxsrc
    LDA #HI(hazel_a_load)
    STA zxsrc + 1
    LDA #LO(HAZEL_ORG)
    STA zxdst
    LDA #HI(HAZEL_ORG)
    STA zxdst + 1
    LDA #LO(hazel_a_end - HAZEL_ORG)
    STA up_n
    LDA #HI(hazel_a_end - HAZEL_ORG)
    STA up_n + 1
    JSR copy
    LDA #LO(hazel_b_load)           \ part B, from here, after part A
    STA zxsrc
    LDA #HI(hazel_b_load)
    STA zxsrc + 1
    LDA #LO(hazel_b_end - hazel_a_end)
    STA up_n
    LDA #HI(hazel_b_end - hazel_a_end)
    STA up_n + 1
    JSR copy
    LDA #LO(music_packed)           \ the tunes, over part A's carrier
    STA zxsrc
    LDA #HI(music_packed)
    STA zxsrc + 1
    LDA #LO(title_screen_music_data)
    STA zxdst
    LDA #HI(title_screen_music_data)
    STA zxdst + 1
    JSR zx_unpack
    LDA #&04
    STA os_ram_copy_of_currently_selected_rom
    STA romsel
    JSR zero_render_vars            \ decision 32: the renderer's variables (bank 4, ROMSEL &04)
    RTS
.copy                               \ up_n bytes from (zxsrc) to (zxdst), both moved on
    LDY #0
.each
    LDA up_n
    ORA up_n + 1
    BEQ done
    LDA (zxsrc),Y
    STA (zxdst),Y
    INC zxsrc
    BNE src_on
    INC zxsrc + 1
.src_on
    INC zxdst
    BNE dst_on
    INC zxdst + 1
.dst_on
    LDA up_n
    BNE low
    DEC up_n + 1
.low
    DEC up_n
    JMP each
.done
    RTS
}
.zx_unpack
    ZX02_DEPACKER
    ASSERT * <= &4000 - GAME_DOWN, "the start-up code carried in the save arena overruns it by ", * - (&4000 - GAME_DOWN)
.arena_carried_end                  \ decision 33: the end of what the file carries in the arena
    SKIP (&4000 - GAME_DOWN) - *
save_arena_end = *

.resident_end         \ everything above is in memory for the whole game; the screen starts at &4000
    ASSERT resident_end <= &4000, "resident code and data overrun the screen by ", resident_end - &4000, " bytes"
.hazel_b_load
SECTION hazel_b, org = hazel_a_end, cmos = TRUE
    INCLUDE "compiled_hazel_b.6502"
\ Decision 40: read-only tables only play reads (HAZEL is paged in through play), from the main block,
\ placed so that no read crosses a page: player_helicopter_types_vertical_speed (read from 5 below
\ it) .. player_helicopters_initial_x_high (read from 24 below) in one page from LO = 5, then the
\ mover type tables with the page boundary at the start of the tenth.
    SKIP (&105 - LO(*)) AND &FF
