.moved_0a20_load     \ step 2 (RAM for cycles 4): carried in the save arena (decision 33), copied to &0A20 at start-up
SECTION moved_0a20, org = &0A20, cmos = TRUE
\ &0982-&0CFF is never read or written after start-up but by the game (front end and play, 50,000
\ frames, 2026-10-17); &0A00-&0A1F is kept clear: the relocation test builds read it as the ground.
\ Decision 40: the section fills the hole to &0CFF (times_78 is in HAZEL) and the level tables are in it.

\ multiply_by_78: A x &4E as multiply_A_by_X_2f1e with X = &4E leaves everything: the result,
\ multiplicand and multiplier_low 0, multiplier_high &4E, A = result_high, X = &4E, Y = 0, C clear,
\ Z set, N clear (V is never read). The tables are made at start-up.
.multiply_by_78
    TAX
    LDA times_78_lo,X
    STA result_low
    LDA times_78_hi,X
    STA result_high
    STZ multiplicand                \ 65C02 opcode
    STZ multiplier_low
    LDX #&4E
    STX multiplier_high
    CLC
    LDY #&00
    RTS

\ rows_up: subtract_Y_rows_from_screen_address_in_AX's rows (unused_0076 of them, 1 or more) in
\ a step each: those inside the cell, the whole cells, and the last cell's crossing by the
\ original's own subtract_delta_from_screen_address_in_AX. It leaves what the row-at-a-time loop
\ leaves: A = Y = the address's low byte, X its high byte, unused_0076 0, Z set, N clear; if it
\ crossed a cell, delta_low/high &79/&02 and C and V as that last crossing left them; if not, C
\ and V as they came.
.rows_up
    PHP                             \ C and V for the rows that stay in the cell
    STA ru_lo
    AND #&07                        \ the line
    CMP unused_0076
    BCC ru_cross                    \ the rows reach past the cell's top
    LDA ru_lo                       \ inside the cell (C set: line >= rows)
    SBC unused_0076
    STA ru_lo
    PLP
    BRA ru_done                     \ 65C02 opcode
.ru_cross                           \ A = the line. d = rows - line - 1: the rows below the cell
    EOR #&FF                        \ above's bottom line when it is reached
    CLC
    ADC unused_0076
    STA ru_d
    PLA                             \ (not these flags: the crossing sets them)
    LDA ru_d
    LSR A
    LSR A
    LSR A
    TAY                             \ the whole cells before the last crossing
    LDA #&79                        \ step 2 (grind): subtract_delta_from_screen_address_in_AX's
    STA delta_low                   \ &0279 inlined; its delta_low/high as it leaves them
    LDA #&02
    STA delta_high
    LSR A                           \ 1: unused_0076's last row, counted off below (C: SEC next)
    STA unused_0076
    LDA ru_lo
    AND #&F8                        \ line 0 of this cell, then up those cells
    SEC
    SBC ru_cells_lo,Y
    STA ru_lo                       \ L1, a multiple of 8 (ru_cells_lo is &00 or &80)
    TXA
    SBC ru_cells_hi,Y
    CMP #&40                        \ round the 16K screen
    BCS ru_in_ring
    ADC #&40
.ru_in_ring
    TAX
    LDA ru_d                        \ then &0279 up, and up the rest of the rows inside that cell:
    AND #&07                        \ (L1 - &79) AND &F8 = L1 EOR &80, with its line 7 - (d AND 7)
    EOR #&07
    EOR ru_lo
    CMP #&80                        \ C: no borrow from L1 - &79 (L1 >= &79 is L1 >= &80)
    EOR #&80                        \ (EOR keeps C)
    TAY
    TXA
    SBC #&02                        \ as the subroutine's SBC delta_high: the same N V Z C
    CMP #&40                        \ round the 16K screen
    BCS ru_in_ring_2
    ADC #&40
.ru_in_ring_2
    TAX
.ru_end
    TYA
    DEC unused_0076                 \ 0: Z set, N clear
    RTS
.ru_done                            \ the rows inside the cell: A = the low byte
    TAY
    LDA #&01
    STA unused_0076
    BRA ru_end                      \ 65C02 opcode
.ru_cells_lo                        \ n character rows: n * &280
    EQUB &00, &80, &00, &80, &00, &80, &00, &80
.ru_cells_hi
    EQUB &00, &02, &05, &07, &0A, &0C, &0F, &11
.ru_lo
    EQUB &00
.ru_d
    EQUB &00
\ Decision 40: the level tables, from the main block. Read-only, and read only when a mover or a
\ trigger comes up (under 0.05 times a pass on both measured games), so their page crossings cost
\ nothing measurable and they follow the code with no gap.
.trigger_points_x_low_table
