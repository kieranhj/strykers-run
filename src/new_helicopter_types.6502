\ new_helicopter_types.6502 - the enemy helicopters' types by the level's byte (cut from src/game.6502:
\ moved_0a20, or HAZEL with HUD_RUPTURE, or the main block on the Model B's gameplay disc, decision 76)
.new_helicopter_types
    EQUB &85    \ MOVER_TYPE_ENEMY | MOVER_TYPE_HELICOPTER_WITH_MISSILE
    EQUB &86    \ MOVER_TYPE_ENEMY | MOVER_TYPE_HELICOPTER
    EQUB &96    \ MOVER_TYPE_ENEMY | MOVER_TYPE_GREEN_WHITE_HELICOPTER
    EQUB &87    \ MOVER_TYPE_ENEMY | MOVER_TYPE_HELICOPTER_WITH_SOLDIER
    EQUB &97    \ MOVER_TYPE_ENEMY | MOVER_TYPE_GREEN_WHITE_CRAFT_ONE
    EQUB &9A    \ MOVER_TYPE_ENEMY | MOVER_TYPE_GREEN_WHITE_HELICOPTER_WITH_MISSILE
    EQUB &99    \ MOVER_TYPE_ENEMY | MOVER_TYPE_FLYING_SCOOTER
    EQUB &98    \ MOVER_TYPE_ENEMY | MOVER_TYPE_GREEN_WHITE_CRAFT_TWO
