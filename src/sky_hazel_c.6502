\ sky_hazel_c.6502 - SKY_HELI (src/sky.6502): the image builder, in HAZEL at &C200 (where the kind
\ cache's slot 1 offsets were: free in this build; times_78 is below it, the mountains above),
\ carried in the file after hazel_b and copied in by unpack_for_play.

\ (SKY_BLK_LO/HI, SKY_RB: bank 4's sky_blk_lo/hi and sky_rb, or with MODEL_B bank 5's and main RAM's copies)
\ sky_build: helicopter sky_s's image: body sprite sky_body's pixels (draw_column's table: its
\ colour and flip) at their places in the rectangle sky_geom has set (line sky_L, the blocks), sky
\ everywhere else. Run when the kind changes (sky_image).
.sky_build
{
    LDA sky_s
    ASL A
    ASL A
    TAX
    LDA SKY_BLK_LO,X
    STA w_ptr
    LDA SKY_BLK_HI,X
    STA w_ptr + 1
    LDA #0
    TAY
.zero1
    STA (w_ptr),Y
    INY
    BNE zero1
    INC w_ptr + 1
    LDY #SKY_IMG_SIZE - 256
.zero2
    DEY
    STA (w_ptr),Y
    BNE zero2
    LDA sky_plo
    STA pix + 1
    LDA sky_phi
    STA pix + 2
IF MODEL_B = 0                      \ (MODEL_B: the caller has set p_ptr: bank 4's table is not in reach)
    LDX sky_body
    LDA straight_sprite_lo,X
    STA p_ptr
    LDA straight_sprite_hi,X
    STA p_ptr + 1
ENDIF
    STZ_Y sky_c                     \ 65C02 opcode: the sprite's column (hand: Y = 0, zero2's exit; MODEL_B enters through call_b5, which the analysis cannot follow)
.column
    LDA sky_c                       \ 8 * the image's column: j + 1, j = c, or 11 - c flipped
    BIT dm_flip
    BPL unflipped
    EOR #&FF
    CLC
    ADC #SKY_COLS
.unflipped
    INC_A_CLC                       \ 65C02 opcode
    ASL A
    ASL A
    ASL A
    STA sky_j8
    LDY #1
    LDA (p_ptr),Y                   \ the count
    BEQ next_col
    STA sky_n
    CLC
IF NMOS
    DEY                             \ NMOS: Y 1 -> 0, dead after
    ADC (p_ptr),Y
ELSE
    ADC (p_ptr)                     \ 65C02 opcode: + the first row
ENDIF
    DEC_A_SEC                       \ 65C02 opcode: the top row r, its data first
    STA sky_tmp
    LDA sky_L
    SEC
    SBC sky_tmp                     \ L - r
    BCC above
    STA sky_line                    \ in the bottom row
    STZ_LDA sky_bq                  \ 65C02 opcode
    BRA_CS placed                   \ 65C02 opcode
.above
    EOR #&FF                        \ r - (L + 1)
    TAY
    AND #&07
    EOR #&07
    STA sky_line                    \ 7 - its rows into the row
    TYA
    LSR A
    LSR A
    LSR A
    INC_A_CLC                       \ 65C02 opcode
    STA sky_bq
.placed
    JSR row_ptr
    LDA p_ptr                       \ the indices, from the top row down
    STA src + 1
    LDA p_ptr + 1
    STA src + 2
    LDA sky_n                       \ the loop ends at X = 2 + count (C clear: row_ptr's high byte add)
    ADC #2
    STA cnt_ba44 + 1
    LDX #2                          \ src is p_ptr itself: X from 2 skips the column's header
.byte
.src
    LDA &FFFF,X                     \ self-modified: the column's indices
    TAY
.pix
    LDA &FFFF,Y                     \ self-modified: the pixel table
    LDY sky_line
    STA (w_ptr),Y
    INX
    INY
    CPY #8
    BCC same_cell
    DEC sky_bq                      \ the line below is the character row below's first
    JSR row_ptr
    LDY #0
.same_cell
    STY sky_line
.cnt_ba44
    CPX #&FF                        \ self-modified: 2 + the count
    BNE byte
.next_col
    LDY #1                          \ on 2 + count
    LDA (p_ptr),Y
    INC_A_CLC                       \ 65C02 opcode: count + 1, then + 1 more by the carry
    SEC
    ADC p_ptr
    STA p_ptr
    BCC same_page
    INC p_ptr + 1
.same_page
    INC sky_c
    LDA sky_c
    CMP #SKY_COLS
    BEQ built
    JMP column
.built
    RTS
.row_ptr                            \ w_ptr = character row sky_bq's block + 8j (keeps X)
    LDY sky_bq
    LDA SKY_RB,Y
    LDY sky_s
    BEQ h0
    ORA #4
.h0
    TAY
    LDA SKY_BLK_LO,Y
    CLC
    ADC sky_j8
    STA w_ptr
    LDA SKY_BLK_HI,Y
    ADC #0
    STA w_ptr + 1
    RTS
}
