.title_screen
    JSR give_irq_back               \ step 2: was JSR clear_title_screen, which this ends in
    LDA #&0C                        \ R12: Displayed screen start address register (high)
    STA crtc_reg                    \ video register number
    LDA #&08
    STA crtc_data                   \ video register value
    LDA #&07                        \ R7: Vertical sync position
    STA crtc_reg                    \ video register number
    LDA #&20
    STA crtc_data                   \ video register value
    LDA #&06                        \ R6: Vertical displayed register
    STA crtc_reg                    \ video register number
    LDA #&19
    STA crtc_data                   \ video register value
    LDA #&06                        \ MOVER_TYPE_HELICOPTER
    STA firing_mover_type
    LDA #&08
    STA scrolltext_cooldown
    LDA #&07                        \ Set colour 0 to black
    STA ula_palette                 \ video ULA palette register
    LDA #&61                        \ Set colour 6 to cyan
    STA ula_palette                 \ video ULA palette register
    LDA #LO(scrolltext_text)        \ &8fc1 = scrolltext_text
    STA &89
    LDA #HI(scrolltext_text)
    STA scrolltext_address_high
    JSR initialise_scrolltext_buffer
    JSR update_scrolltext
    LDA irq1v
    STA previous_irq1_vector_for_title_screen_low
    LDA irq1v + 1
    STA previous_irq1_vector_for_title_screen_high
    SEI
    LDA #LO(title_screen_irq1_handler)\ &88b5 = title_screen_irq1_handler
    STA irq1v
    LDA #HI(title_screen_irq1_handler)
    STA irq1v + 1
    CLI
    JSR check_for_high_score        \ Returns carry clear if score ranked
    LDA #&7F
    STA title_screen_cooldown
    BCC high_score_screen
.display_title_screen
    LDA #&7F
    STA title_screen_cooldown
    LDX #HI(title_screen_text)      \ &8a2d = title_screen_text
    LDY #LO(title_screen_text)
    JSR plot_title_screen_text
.title_screen_loop
    LDX #&AD                        \ C                                         # If the C, H, R, I and S keys are pressed,
    JSR check_for_title_screen_keypress
    BNE skip_observer_mode
    LDX #&AB                        \ H
    JSR check_for_title_screen_keypress
    BNE skip_observer_mode
    LDX #&CC                        \ R
    JSR check_for_title_screen_keypress
    BNE skip_observer_mode
    LDX #&DA                        \ I
    JSR check_for_title_screen_keypress
    BNE skip_observer_mode
    LDX #&AE                        \ S
    JSR check_for_title_screen_keypress
    BNE skip_observer_mode
.enable_observer_mode
    LDA #&05
    STA observer_mode               \ Set to non-zero to enable observer mode
.skip_observer_mode
    LDA title_screen_cooldown
    BMI to_high_score_screen
    LDA os_most_recently_pressed_key
    CMP #&30                        \ "1"
    BCC not_one_or_two
    SEC
    SBC #&30                        \ "1"
    BNE not_one
    JMP prepare_to_start_game
.not_one
    CMP #&02                        \ "2"
    BCS title_screen_loop
    JSR define_controls
    BRA display_title_screen        \ 65C02 opcode
.to_high_score_screen
    LDA #&50
    STA title_screen_cooldown
.high_score_screen
    JSR display_high_scores
.high_score_screen_loop
    LDA title_screen_cooldown
    BPL high_score_screen_loop
    BRA display_title_screen        \ 65C02 opcode
.not_one_or_two
    CMP #&11                        \ "3"
    BEQ read_instructions
    CMP #&13                        \ "5"
    BEQ toggle_sound
    CMP #&12                        \ "4"
    BNE title_screen_loop
.toggle_music
    LDA title_screen_text + 115
    CMP #&17                        \ "F"
    BEQ enable_music
.disable_music
    LDA #&17                        \ "N"
    STA title_screen_text + 115
    LDA #&25                        \ " "
    STA title_screen_text + 116
    STA music_muted
    LDA #&0D                        \ Disable event
    LDX #&05                        \ interval timer crossing zero
    JSR osbyte                      \ OSBYTE
    LDA #&0F                        \ Flush buffers
    LDX #&00                        \ flush all buffers
    JSR osbyte                      \ OSBYTE
    JMP display_title_screen
.enable_music
    LDA #&0F                        \ "F"
    STA title_screen_text + 115
    STA title_screen_text + 116
    STZ music_muted
    JSR start_title_screen_music
    JMP display_title_screen

.toggle_sound
    LDA title_screen_text + 130
    CMP #&17
    BNE disable_sound
.enable_sound
    LDA #&0F                        \ "F"
    STA title_screen_text + 130
    STA title_screen_text + 131
    STZ sound_muted                 \ 65C02 opcode
    JMP display_title_screen
.disable_sound
    LDA #&17                        \ "N"
    STA title_screen_text + 130
    LDA #&25                        \ "O"
    STA title_screen_text + 131
    STA sound_muted
    JMP display_title_screen

.read_instructions
    LDX #HI(instructions_text_one)  \ &8d90 = instructions_text_one
    LDY #LO(instructions_text_one)
    JSR plot_title_screen_text
    JSR get_keypress
    LDX #HI(instructions_text_two)  \ &8e80 = instructions_text_two
    LDY #LO(instructions_text_two)
    JSR plot_title_screen_text
    JSR get_keypress
    LDX #HI(instructions_text_three)\ &8f68 = instructions_text_three
    LDY #LO(instructions_text_three)
    JSR plot_title_screen_text
    JSR get_keypress
    JMP display_title_screen

.prepare_to_start_game
    SEI
    LDA previous_irq1_vector_for_title_screen_low
    STA irq1v
    LDA previous_irq1_vector_for_title_screen_high
    STA irq1v + 1
    CLI
    LDA #&0D                        \ Disable event
    LDX #&05                        \ interval timer crossing zero
    JSR osbyte                      \ OSBYTE
    LDA #&0F                        \ Flush buffers
    LDX #&00                        \ flush all buffers
    JSR osbyte                      \ OSBYTE
    LDA #&01                        \ Set colour 0 to cyan
    STA ula_palette                 \ video ULA palette register
    LDA #&67                        \ Set colour 6 to black
    STA ula_palette                 \ video ULA palette register
    JMP take_irq_for_play           \ step 2: was JMP start_game, which this ends in

.instructions_text_one
    EQUB &00, &43, &03    \ at &4300, colour &03 (RR)
    EQUB &1D, &11, &0E, &25, &16, &12, &1C, &1C, &12, &18, &17, &2F    \ "THE MISSION:"
    EQUB &FE    \ end of string
    EQUB &80, &47, &3C    \ at &4780, colour &3c (CC)
    EQUB &0A, &25, &20, &0E, &0A, &14, &17, &0E, &1C, &1C, &25, &11, &0A, &1C, &25, &0B    \ "A WEAKNESS HAS BEEN FOUND"
    EQUB &0E, &0E, &17, &25, &0F, &18, &1E, &17, &0D
    EQUB &FE    \ end of string
    EQUB &80, &4C, &3C    \ at &4c80, colour &3c (CC)
    EQUB &12, &17, &25, &1D, &11, &0E, &25, &0E, &17, &0E, &16, &22, &25, &0D, &0E, &0F    \ "IN THE ENEMY DEFENCES."
    EQUB &0E, &17, &0C, &0E, &1C, &27
    EQUB &FE    \ end of string
    EQUB &80, &51, &3C    \ at &5180, colour &3c (CC)
    EQUB &1D, &11, &12, &1C, &25, &12, &17, &1D, &0E, &15, &15, &12, &10, &0E, &17, &0C    \ "THIS INTELLIGENCE MUST BE"
    EQUB &0E, &25, &16, &1E, &1C, &1D, &25, &0B, &0E
    EQUB &FE    \ end of string
    EQUB &80, &56, &3C    \ at &5680, colour &3c (CC)
    EQUB &0C, &18, &17, &1F, &0E, &22, &0E, &0D, &25, &1D, &18, &25, &16, &0A, &12, &17    \ "CONVEYED TO THE MAIN H.Q."
    EQUB &25, &11, &27, &1A, &27
    EQUB &FE    \ end of string
    EQUB &80, &5B, &3C    \ at &5b80, colour &3c (CC)
    EQUB &12, &16, &16, &0E, &0D, &12, &0A, &1D, &0E, &15, &22, &27, &25, &0B, &0E, &0C    \ "IMMEDIATELY. BECAUSE OF"
    EQUB &0A, &1E, &1C, &0E, &25, &18, &0F
    EQUB &FE    \ end of string
    EQUB &80, &60, &3C    \ at &6080, colour &3c (CC)
    EQUB &1D, &11, &0E, &25, &17, &0A, &1D, &1E, &1B, &0E, &25, &18, &0F, &25, &1D, &11    \ "THE NATURE OF THE"
    EQUB &0E
    EQUB &FE    \ end of string
    EQUB &80, &65, &3C    \ at &6580, colour &3c (CC)
    EQUB &12, &17, &0F, &18, &1B, &16, &0A, &1D, &12, &18, &17, &31, &25, &12, &1D, &25    \ "INFORMATION, IT CAN NOT"
    EQUB &0C, &0A, &17, &17, &18, &1D, &25
    EQUB &FE    \ end of string
    EQUB &80, &6A, &3C    \ at &6a80, colour &3c (CC)
    EQUB &0B, &0E, &25, &1D, &1B, &0A, &17, &1C, &16, &12, &1D, &1D, &0E, &0D, &25, &18    \ "BE TRANSMITTED OVER THE"
    EQUB &1F, &0E, &1B, &25, &1D, &11, &0E
    EQUB &FE    \ end of string
    EQUB &80, &6F, &3C    \ at &6f80, colour &3c (CC)
    EQUB &0A, &12, &1B, &20, &0A, &1F, &0E, &1C, &27    \ "AIRWAVES."
    EQUB &FF    \ end of text

.instructions_text_two
    EQUB &80, &42, &3C    \ at &4280, colour &3c (CC)
    EQUB &22, &18, &1E, &31, &25, &0C, &18, &16, &16, &0A, &17, &0D, &0E, &1B, &25, &13    \ "YOU, COMMANDER JOHN"
    EQUB &18, &11, &17
    EQUB &FE    \ end of string
    EQUB &80, &47, &3C    \ at &4780, colour &3c (CC)
    EQUB &1C, &1D, &1B, &22, &14, &0E, &1B, &31, &25, &11, &0A, &1F, &0E, &25, &0B, &0E    \ "STRYKER, HAVE BEEN CHOSEN"
    EQUB &0E, &17, &25, &0C, &11, &18, &1C, &0E, &17
    EQUB &FE    \ end of string
    EQUB &80, &4C, &3C    \ at &4c80, colour &3c (CC)
    EQUB &0F, &18, &1B, &25, &1D, &11, &12, &1C, &25, &16, &12, &1C, &1C, &12, &18, &17    \ "FOR THIS MISSION. THE MAIN"
    EQUB &27, &25, &1D, &11, &0E, &25, &16, &0A, &12, &17
    EQUB &FE    \ end of string
    EQUB &80, &51, &3C    \ at &5180, colour &3c (CC)
    EQUB &11, &27, &1A, &27, &25, &11, &18, &20, &0E, &1F, &0E, &1B, &25, &12, &1C, &25    \ "H.Q. HOWEVER IS SEVERAL"
    EQUB &1C, &0E, &1F, &0E, &1B, &0A, &15
    EQUB &FE    \ end of string
    EQUB &80, &56, &3C    \ at &5680, colour &3c (CC)
    EQUB &16, &12, &15, &0E, &1C, &25, &0A, &20, &0A, &22, &25, &18, &1F, &0E, &1B, &25    \ "MILES AWAY OVER ENEMY"
    EQUB &0E, &17, &0E, &16, &22
    EQUB &FE    \ end of string
    EQUB &80, &5B, &3C    \ at &5b80, colour &3c (CC)
    EQUB &1D, &0E, &1B, &1B, &12, &1D, &18, &1B, &22, &27    \ "TERRITORY."
