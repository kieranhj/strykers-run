\ ;     chan  vol   pitch dur
.sound_data_a280
    EQUB &10, &00, &02, &00, &00, &00, &02, &00    \ &00                                 # Title screen channel 0
    EQUB &12, &00, &03, &00, &00, &00, &02, &00    \ &08                                 # Title screen channel 2
    EQUB &13, &00, &04, &00, &00, &00, &02, &00    \ &10                                 # Title screen channel 3
    EQUB &11, &00, &01, &00, &00, &00, &02, &00    \ &18                                 # Title screen channel 1
    EQUB &13, &00, &0A, &00, &00, &00, &05, &00    \ &20                                 # High score channel 3
    EQUB &11, &00, &00, &00, &00, &00, &05, &00    \ &28                                 # High score channel 1
    EQUB &12, &00, &00, &00, &00, &00, &05, &00    \ &30                                 # High score channel 2

.timer_block
    EQUB &FF, &FF, &FF, &FF, &FF

.start_title_screen_music
    LDA music_muted
    BNE leave_a2e7
    LDX #&01
    STX channel_one_envelope
    DEX                             \ 0
    STX music_address_low
    LDA #HI(title_screen_music_data)\ &9300 = title_screen_music_data
    STA music_address_high
    LDA #LO(title_screen_music_event_handler)\ &a305 = title_screen_music_event_handler
    STA evntv
    LDA #HI(title_screen_music_event_handler)
    STA evntv + 1
.enable_interval_timer_events
    LDA #&0E                        \ Enable event
    LDX #&05                        \ interval timer crossing zero
    JSR osbyte                      \ OSBYTE
.write_timer_block
    LDX #LO(timer_block)            \ &a2b8 = timer_block
    LDY #HI(timer_block)
    LDA #&04                        \ Write interval timer
    JMP (wordv)
.leave_a2e7
    RTS

.start_high_score_music
    LDA music_muted
    BNE leave_a2e7
    LDA #LO(high_score_music_data)
    STA music_address_low
    LDA #HI(high_score_music_data)  \ &a100 = high_score_music_data
    STA music_address_high
    LDA #&C0
    STA high_score_music_notes_remaining
    LDA #LO(high_score_music_event_handler)\ &a393 = high_score_music_event_handler
    STA evntv
    LDA #HI(high_score_music_event_handler)
    STA evntv + 1
    BNE enable_interval_timer_events\ Always branches

.title_screen_music_event_handler
    PHP
    TXA
    PHA
    TYA
    PHA
    LDA #&F6
    STA timer_block
    LDX music_address_high
    ASSERT LO(title_screen_music_data) = 0   \ envelopes change at whole pages into the tune
    CPX #HI(title_screen_music_data + &700)
    BNE not_envelope_five
    LDA #&05
    STA channel_one_envelope
.not_envelope_five
    CPX #HI(title_screen_music_data + &900)
    BNE not_envelope_one
    LDA #&01
    STA channel_one_envelope
.not_envelope_one
    LDY #&00
    LDA (music_address),Y
    BEQ skip_channel_zero
    STA sound_data_a280 + 4         \ sound_data + &00 + 4 (pitch)
    JSR title_screen_play_sound
.skip_channel_zero
    LDA #&03
    STA sound_data_a280 + 10        \ sound_data + &08 + 2 (volume)
    LDY #&01
    LDA (music_address),Y
    TAX
    BEQ skip_channel_two
    INX
    BNE not_silent_channel_two
    STX sound_data_a280 + 10        \ sound_data + &08 + 2 (volume)
.not_silent_channel_two
    STA sound_data_a280 + 12        \ sound_data + &08 + 4 (pitch)
    JSR title_screen_play_sound
.skip_channel_two
    LDA #&04
    STA sound_data_a280 + 18        \ sound_data + &10 + 2 (volume)
    LDY #&02
    LDA (music_address),Y
    TAX
    BEQ skip_channel_three
    INX
    BNE not_silent_channel_three
    STX sound_data_a280 + 18        \ sound_data + &10 + 2 (volume)
.not_silent_channel_three
    STA sound_data_a280 + 20        \ sound_data + &10 + 4 (pitch)
    JSR title_screen_play_sound
.skip_channel_three
    LDA channel_one_envelope
    STA sound_data_a280 + 26        \ sound_data + &18 + 2 (volume)
    LDY #&03
    LDA (music_address),Y
    TAX
    BEQ skip_channel_one
    INX
    BNE not_silent_channel_one
    STX sound_data_a280 + 26        \ sound_data + &18 + 2 (volume)
.not_silent_channel_one
    STA sound_data_a280 + 28        \ sound_data + &18 + 4 (pitch)
    JSR title_screen_play_sound
.skip_channel_one
    JSR write_timer_block
    LDA music_address
    CLC
    ADC #&04
    STA music_address
    BCC not_end_of_title_screen_music
    INC music_address_high
    LDA music_address_high
    ASSERT LO(high_score_music_data) = 0     \ the title tune ends where the high score tune starts
    CMP #HI(high_score_music_data)
    BNE not_end_of_title_screen_music
    LDA #HI(title_screen_music_data + &200)  \ and loops back to its third page
    STA music_address_high
.not_end_of_title_screen_music
    PLA
    TAY
    PLA
    TAX
    PLP
    RTS

.high_score_music_event_handler
    PHP
    TXA
    PHA
    TYA
    PHA
    LDA #&F0
    STA timer_block
    LDY #&00
    LDA (music_address),Y
    BEQ set_channel_one_envelope
    LDA #&0A
.set_channel_one_envelope
    STA sound_data_a280 + 42        \ sound_data + &28 + 2 (volume)
    STA sound_data_a280 + 50        \ sound_data + &30 + 2 (volume)
    LDA (music_address),Y
    STA sound_data_a280 + 44        \ sound_data + &28 + 4 (pitch)
    CLC
    ADC #&30
    STA sound_data_a280 + 52        \ sound_data + &30 + 4 (pitch)
    LDX #LO(sound_data_a280 + &28)
    JSR high_score_play_sound
    LDX #LO(sound_data_a280 + &30)
    JSR high_score_play_sound
    LDY #&01
    LDA (music_address),Y
    STA sound_data_a280 + 36        \ sound_data + &20 + 4 (pitch)
    LDX #LO(sound_data_a280 + &20)
    JSR high_score_play_sound
    JSR write_timer_block
    LDA music_address_low
    CLC
    ADC #&02
    STA music_address_low
    BCC skip_page_a3da
    INC music_address_high
.skip_page_a3da
    DEC high_score_music_notes_remaining
    BNE not_end_of_high_score_music
    LDA #LO(high_score_music_data)
    STA music_address_low
    LDA #HI(high_score_music_data)  \ &a100 = high_score_music_data
    STA music_address_high
.not_end_of_high_score_music
    PLA
    TAY
    PLA
    TAX
    PLP
    RTS

.title_screen_play_sound
    ASSERT (LO(sound_data_a280) AND &1F) = 0   \ ORA builds sound_data + Y * 8
    TYA
    ASL A
    ASL A
    ASL A
    ORA #LO(sound_data_a280)
    TAX
.high_score_play_sound
    LDA #&07
    LDY #HI(sound_data_a280)        \ &a280 = sound_data
    JMP (wordv)


\ ---- Step 2, layer 1: the interrupt during play (decisions 14-17) ----------------------------
\ The title, high scores, instructions and define controls run under the MOS as the original
\ did (their music is MOS interval-timer events, their keys the MOS's &EC, and OSBYTE 19). In
\ play, irq1_handler keeps vsync and User VIA T1 from the MOS, and System VIA T1, its 100 Hz
\ tick, is off: the game's effects are src/lib/sfx50.6502's, run at vsync (decision 25). Both
\ calls run with bank 5 paged in.

RND_SEED = &7A31                    \ decision 17: every game starts the generator here

\ Entered once per game, from prepare_to_start_game, in place of its JMP start_game (bank 5
\ grows only at its end: its music is page-aligned). ORDER MATTERS: irq_owned goes on before the
\ MOS is told to ignore vsync, or a vsync handed to a MOS that ignores it is never acknowledged.
.take_irq_for_play
    LDA #LO(RND_SEED)
    STA rnd_seed_low
    LDA #HI(RND_SEED)
    STA rnd_seed_high
    SEI
    LDA sysvia_ier                  \ the MOS's keyboard (CA2), ADC (CB1) and 100 Hz tick (T1)
    AND #&51                        \ enables, for later
    STA saved_sysvia_ier_bits
    LDA #&51                        \ CA2 and CB1 off: in play the keyboard is read direct
    STA sysvia_ier                  \ (decision 16) and the ADC is unused; T1 off: irq1_handler
                                    \ plays the effects at vsync (decision 25)
    JSR sfx_silence                 \ the MOS's notes stop where they are: silence them
    LDA #&FF
    STA irq_owned                   \ vsync is ours from the next one
    LDA field_count
    STA pass_start
    CLI
    LDA #&E9                        \ System VIA IRQ mask &0279: clear bit 1, so a vsync that
    LDX #&00                        \ arrives while irq1_handler is chaining the 100 Hz tick
    LDY #&FD                        \ is left for irq1_handler, not taken by the MOS
    JSR osbyte                      \ OSBYTE (new = old AND Y EOR X; X = old)
    STX saved_sysvia_irq_mask
    LDA #&B2                        \ keyboard semaphore &0242 = 0: the 100 Hz tick no longer
    LDX #&00                        \ scans the keyboard
    LDY #&00
    JSR osbyte                      \ OSBYTE
    STX saved_keyboard_semaphore
    JMP start_game

\ Called at the start of every title_screen in place of clear_title_screen, which it ends in;
\ does nothing else until take_irq_for_play has run.
\ The reverse, in reverse order: the MOS takes vsync back before irq1_handler stops taking it.
.give_irq_back
    BIT irq_owned
    BPL leave_give_irq_back
    LDA #&B2
    LDX saved_keyboard_semaphore
    LDY #&00
    JSR osbyte                      \ OSBYTE
    LDA #&E9
    LDX saved_sysvia_irq_mask
    LDY #&00
    JSR osbyte                      \ OSBYTE
    SEI
    LDA saved_sysvia_ier_bits
    ORA #&80
    STA sysvia_ier
    STZ irq_owned                   \ 65C02 opcode
    JSR sfx_silence                 \ and ours: the MOS has the chip back
    CLI
.leave_give_irq_back
    JMP clear_title_screen

.saved_sysvia_ier_bits
    EQUB &00
.saved_sysvia_irq_mask
    EQUB &00
.saved_keyboard_semaphore
    EQUB &00
