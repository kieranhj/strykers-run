\ bank5.6502 - sideways RAM bank 5 (DATA2, from &8400): title screen, high scores, music
\
\ Created once by tools/disasm2baron.py from reference/strykers-run-enhanced-disassembly.txt
\ (lines starting "\ " carry the disassembly's annotations). Hand-maintained from here on.
\ This file is INCLUDEd inside its SECTION by src/main.6502.

\ ; data4
\ ; FFFF1000 FFFF1000 1FFA                                            # Loaded into bank 5 at &8400 - &a3f9

.title_screen_font_data
    EQUB &00, &FE, &F2, &C2, &C2, &FE    \ &00 : "0"
    EQUB &00, &00, &FE, &F0, &00, &00    \ &01 : "1"
    EQUB &00, &F2, &F2, &D2, &D2, &DE    \ &02 : "2"
    EQUB &00, &C0, &D2, &D2, &D2, &FE    \ &03 : "3"
    EQUB &00, &1E, &10, &FC, &F0, &10    \ &04 : "4"
    EQUB &00, &DE, &D2, &D2, &D2, &F2    \ &05 : "5"
    EQUB &00, &FE, &E8, &C8, &C8, &F8    \ &06 : "6"
    EQUB &00, &02, &C2, &F2, &3E, &0E    \ &07 : "7"
    EQUB &00, &FE, &F2, &D2, &D2, &FE    \ &08 : "8"
    EQUB &00, &1E, &12, &12, &F2, &FE    \ &09 : "9"
    EQUB &00, &FF, &F9, &19, &19, &FF    \ &0a : "A"
    EQUB &00, &FF, &F9, &C9, &CF, &F8    \ &0b : "B"
    EQUB &00, &FF, &F1, &C1, &C1, &C0    \ &0c : "C"
    EQUB &00, &FF, &F1, &C1, &C3, &FE    \ &0d : "D"
    EQUB &00, &FF, &F9, &C9, &C9, &C0    \ &0e : "E"
    EQUB &00, &FF, &F9, &09, &09, &01    \ &0f : "F"
    EQUB &00, &FF, &F1, &C1, &CB, &FA    \ &10 : "G"
    EQUB &00, &FF, &F8, &08, &08, &FF    \ &11 : "H"
    EQUB &00, &C1, &FF, &F9, &C1, &00    \ &12 : "I"
    EQUB &00, &E0, &C0, &C0, &F8, &FF    \ &13 : "J"
    EQUB &00, &FF, &F8, &34, &62, &C1    \ &14 : "K"
    EQUB &00, &FF, &F8, &C0, &C0, &C0    \ &15 : "L"
    EQUB &00, &FF, &F3, &06, &03, &FF    \ &16 : "M"
    EQUB &00, &FF, &F9, &01, &01, &FF    \ &17 : "N"
    EQUB &00, &FF, &F9, &C1, &C1, &FF    \ &18 : "O"
    EQUB &00, &FF, &F9, &09, &09, &0F    \ &19 : "P"
    EQUB &00, &FF, &F9, &C1, &61, &BF    \ &1a : "Q"
    EQUB &00, &FF, &F9, &09, &39, &CF    \ &1b : "R"
    EQUB &00, &CF, &C9, &C9, &C9, &F9    \ &1c : "S"
    EQUB &00, &03, &F3, &FF, &03, &03    \ &1d : "T"
    EQUB &00, &FF, &F8, &C0, &C0, &FF    \ &1e : "U"
    EQUB &00, &3F, &78, &E0, &60, &3F    \ &1f : "V"
    EQUB &00, &7F, &F8, &20, &E0, &7F    \ &20 : "W"
    EQUB &00, &E7, &3C, &18, &3C, &E7    \ &21 : "X"
    EQUB &00, &3F, &3C, &F0, &30, &3F    \ &22 : "Y"
    EQUB &00, &F1, &D9, &CD, &C7, &C3    \ &23 : "Z"
    EQUB &34, &34, &34, &34, &34, &34    \ &24 : "="
    EQUB &00, &00, &00, &00, &00, &00    \ &25 : " "
    EQUB &7E, &C3, &BD, &A5, &C3, &7E    \ &26 : "(c)"
    EQUB &00, &00, &C0, &C0, &00, &00    \ &27 : "."
    EQUB &00, &18, &18, &18, &18, &18    \ &28 : "-"
    EQUB &00, &30, &18, &0C, &18, &30    \ &29 : "^"
    EQUB &00, &06, &0C, &18, &30, &60    \ &2a : "\"
    EQUB &00, &6E, &F3, &D9, &CD, &7E    \ &2b : "@"
    EQUB &00, &FF, &C1, &C1, &C1, &C1    \ &2c : "["
    EQUB &C0, &C0, &C0, &C0, &C0, &C0    \ &2d : "_"
    EQUB &00, &00, &36, &76, &00, &00    \ &2e : ";"
    EQUB &00, &00, &34, &34, &00, &00    \ &2f : ":"
    EQUB &00, &C1, &C1, &C1, &C1, &FF    \ &30 : "]"
    EQUB &00, &00, &30, &70, &00, &00    \ &31 : ","
    EQUB &00, &60, &30, &18, &0C, &06    \ &32 : "/"

.plot_title_screen_character    \ # Called with X = character
    STA &CD
    LDA #&06
    JSR multiply_A_by_X_85ef
    LDA result_low
    LDY result_high
    CLC
    ADC #LO(title_screen_font_data) \ &8400 = title_screen_font_data
    BCC skip_page_8543
    INY
.skip_page_8543
    STA font_address_low
    TYA
    CLC
    ADC #HI(title_screen_font_data)
    STA font_address_high
    LDX #&00
.plot_title_screen_character_column_loop
font_address_low = * + 1
font_address_high = * + 2
    LDA mover_types_first_sprite_animation_offsets + 26,X
\ #     actually LDA font_address,X
    STA &CB
    LDY #&07
.plot_title_screen_character_row_loop
    LDA #&00
    ROL &CB
    BCC set_pixel_value_8560
text_colour = * + 1
    LDA #&03
\ #     actually LDA text_colour
    AND &CD
.set_pixel_value_8560
    STA &CA
    LDA &CD
    EOR #&FF
    AND (text_screen_address),Y
    EOR &CA
    STA (text_screen_address),Y
    DEY
    BPL plot_title_screen_character_row_loop
    LDA &CD
    EOR #&FF
    STA &CD
    BPL skip_page_8582
    LDA text_screen_address_low
    CLC
    ADC #&08
    STA text_screen_address_low
    BCC skip_page_8582
    INC &CF
.skip_page_8582
.not_next_byte_8582
    INX
    CPX #&06
    BNE plot_title_screen_character_column_loop
    RTS

.clear_title_screen
    LDA #&13                        \ Wait for vertical retrace
    JSR osbyte                      \ OSBYTE
    LDA #&40
    STA clear_title_screen_loop + 2
    LDX #&00
.clear_title_screen_loop    \ # Wipe &4000 - &7fff
    STZ &4000,X                     \ *** 65C02 opcode
\ #     actually STZ wipe_address,X
    INX
    BNE clear_title_screen_loop
    INC clear_title_screen_loop + 2
    BPL clear_title_screen_loop
    RTS

.clear_part_of_title_screen
    LDA #&40                        \ ***
    STA screen_address_high         \ ***
    STZ screen_address_low          \ *** 65C02 opcode
    LDY #&00                        \ ***
    LDA #&00                        \ ***
.clear_part_of_display_title_screen    \ ***
    STA (screen_address),Y          \ *** Wipe &4000 - &71ff
    INY                             \ ***
    BNE clear_part_of_display_title_screen\ ***
    INC screen_address_high         \ ***
    LDX screen_address_high         \ ***
    CPX #&72                        \ ***
    BCC clear_part_of_display_title_screen\ ***
    RTS                             \ ***

.plot_title_screen_text
    STX text_address_high
    STY text_address_low
    JSR clear_part_of_title_screen  \ ***
    LDY #&00
.plot_title_screen_text_loop
    LDA (text_address),Y            \ Get two bytes for screen address
    STA text_screen_address_low
    INY
    LDA (text_address),Y
    STA &CF
    INY
    LDA (text_address),Y            \ Get byte for colour
    STA text_colour
    LDA #&AA
    STA &CD
    JSR plot_title_screen_text_string_loop
    INY
    CMP #&FF                        \ &ff indicates end of text
    BNE plot_title_screen_text_loop
    RTS
.plot_title_screen_text_string_loop
    INY
    LDA (&C2),Y                     \ Get byte for character
    BPL not_end_of_string_85e3      \ &fe indicates end of string, &ff end of text
    RTS
.not_end_of_string_85e3
    STY text_offset
    TAX
    LDA &CD
    JSR plot_title_screen_character
    LDY text_offset
    BNE plot_title_screen_text_string_loop\ Always branches

.multiply_A_by_X_85ef
    STA multiplicand
    STX multiplier_low
    LDA #&00
    STA result_low
    STA result_high
    STA multiplier_high
    LDY #&08
.multiply_A_by_X_loop_85fd
    LSR multiplicand
    BCC consider_next_bit_860e
    CLC
    LDA multiplier_low
    ADC result_low
    STA result_low
    LDA multiplier_high
    ADC result_high
    STA result_high
.consider_next_bit_860e
    ASL multiplier_low
    ROL multiplier_high
    DEY
    BNE multiply_A_by_X_loop_85fd
    RTS

.define_controls
    LDX #&00
    STX key_offset
    INX
    STX unused                      \ Unused variable
    LDX #HI(define_controls_text)
    LDY #LO(define_controls_text)
    JSR plot_title_screen_text      \ Write "DEFINE CONTROLS"
    STY text_offset
.define_controls_loop
    LDY text_offset
    JSR plot_title_screen_text_loop \ Write next control
    STY text_offset
    JSR get_keypress
    LDY key_offset
    CMP #&70                        \ ESCAPE
    BNE not_escape
    JMP display_title_screen
.not_escape
    STA keycode
    TAX
    EOR #&FF
    STA keys,Y
    TXA
    LSR A
    LSR A
    LSR A
    LSR A
    LDX #&06
    JSR multiply_A_by_X_85ef
    LDA keycode
    SEC
    SBC result_low
    TAX                             \ X = keycode - ((keycode DIV 16) * 6)
    LDA key_translation_table,X
    BMI is_long_name
    TAX
    ASL A
    BMI is_function_key
.is_character    \ # &00 - &32 writes character
    LDA &CD
    JSR plot_title_screen_character
    BEQ finished_writing_key        \ Always branches
.is_function_key    \ # &40 - &49 writes F followed by number
    STX keycode
    LDX #&0F                        \ "F"
    LDA &CD
    JSR plot_title_screen_character
    LDA keycode
    AND #&3F
    TAX
    LDA &CD
    JSR plot_title_screen_character
    BEQ finished_writing_key        \ Always branches
.is_long_name    \ # &80 - &ff writes long character name
    AND #&7F
    STA keycode
.write_key_loop
    LDY keycode
    LDX key_names,Y
    BMI finished_writing_key
    LDA &CD
    JSR plot_title_screen_character
    INC keycode
    BNE write_key_loop
.finished_writing_key
    LDY text_offset
    INC key_offset
    LDA key_offset
    CMP #&08
    BCC define_controls_loop

.get_keypress
    LDX #&FF                        \ SHIFT                                     # Wait for SHIFT, CTRL and other keys to be released
    JSR check_for_title_screen_keypress
    BEQ get_keypress
    LDX #&FE                        \ CTRL
    JSR check_for_title_screen_keypress
    BEQ get_keypress
    LDA os_most_recently_pressed_key
    BNE get_keypress
.get_keypress_loop
    LDX #&FF                        \ SHIFT
    JSR check_for_title_screen_keypress
    BNE not_shift
    LDA #&00                        \ Return zero to indicate SHIFT pressed
    RTS
.not_shift
    LDX #&FE                        \ CTRL
    JSR check_for_title_screen_keypress
    BNE not_ctrl
    LDA #&01                        \ Return one to indicate CTRL pressed
    RTS
.not_ctrl
    LDA os_most_recently_pressed_key
    BEQ get_keypress_loop
    AND #&7F                        \ Return key pressed
    RTS

.check_for_title_screen_keypress
    LDY #&FF
    LDA #&81                        \ Scan for a particular key
    JSR osbyte                      \ OSBYTE
    CPX #&FF
    RTS

.check_for_high_score    \ *** # &86cb - &a3f7 is extra code and data
    STZ rank                        \ 65C02 opcode
.check_for_high_score_rank_loop
    LDA rank
    LDX #&06
    JSR multiply_A_by_X_85ef
    LDX result_low
    LDY #&00
.check_for_high_score_digit_loop
    LDA high_scores,X
    CMP game_over_text + 20,Y
    BCC new_high_score
    BNE consider_next_rank
    INY
    INX
    CPY #&06
    BCC check_for_high_score_digit_loop
    BRA consider_next_rank          \ 65C02 opcode
.new_high_score
    LDA rank
    CMP #&07
    BEQ finished_shuffling_scores
    LDX #&29                        \ (6 * 7) - 1
.shuffle_scores_loop
    LDA high_scores,X
    STA high_scores + 6,X
    CPX result_low
    BEQ finished_shuffling_scores
    DEX
    BRA shuffle_scores_loop         \ 65C02 opcode
.finished_shuffling_scores
    LDX result_low
    LDY #&00
.insert_score_loop
    LDA game_over_text + 20,Y
    STA high_scores,X
    INX
    INY
    CPY #&06
    BCC insert_score_loop
    LDA #&12
    LDX rank
    JSR multiply_A_by_X_85ef
    LDA #LO(high_score_names)       \ &895c = high_score_names
    CLC
    ADC result_low
    STA name_address_low
    LDA #HI(high_score_names)
    ADC result_high
    STA name_address_high
    BRA well_done_screen            \ 65C02 opcode
.consider_next_rank
    INC rank
    LDA rank
    CMP #&08
    BCC check_for_high_score_rank_loop
    JMP start_title_screen_music    \ Leave with carry set to indicate score didn't rank
.leave_with_carry_clear_8730
    JSR start_title_screen_music
    CLC                             \ Leave with carry clear to indicate score ranked
    RTS

.well_done_screen
    JSR start_high_score_music
    LDA rank
    CMP #&07
    BEQ finished_shuffling_names
    LDX #&7D                        \ (18 * 7) - 1
.shuffle_names_loop
    LDA high_score_names,X
    STA high_score_names + 18,X
    CPX result_low
    BEQ finished_shuffling_names
    DEX
    BRA shuffle_names_loop          \ 65C02 opcode
.finished_shuffling_names
    LDY #&11
    LDA #&25                        \ " "
.wipe_name_loop
    STA (name_address),Y
    DEY
    BPL wipe_name_loop
    LDX #HI(well_done_text)         \ &8a06 = well_done_text
    LDY #LO(well_done_text)
    JSR plot_title_screen_text
    LDA #&FF
    STA &7F
.enter_name_loop
    JSR get_keypress
    CMP #&49                        \ ENTER
    BEQ leave_with_carry_clear_8730
    CMP #&59                        \ DELETE
    BNE not_delete
.delete_pressed
    LDA #&25
    LDX &7F
    BMI enter_name_loop
    JSR add_character_to_name
    LDX &7F
    DEX
    CPX #&FE
    BEQ enter_name_loop
    STX &7F
    BRA enter_name_loop             \ 65C02 opcode
.not_delete
    STA &CC
    LSR A
    LSR A
    LSR A
    LSR A
    LDX #&06
    JSR multiply_A_by_X_85ef
    LDA keycode
    CMP #&62                        \ SPACE
    BNE not_space
    LDA #&25                        \ " "
    BRA consider_adding_character   \ 65C02 opcode
.not_space
    SEC
    SBC result_low
    TAX
    LDA key_translation_table,X
    BMI enter_name_loop
    TAX
    ASL A
    BMI enter_name_loop
    TXA
.consider_adding_character
    LDX &7F
    INX
    CPX #&12
    BCS enter_name_loop
    STX &7F
    JSR add_character_to_name
    BRA enter_name_loop             \ 65C02 opcode

.add_character_to_name
    PHA
    LDY &7F
    STA (name_address),Y
    LDA #&18
    JSR multiply_A_by_X_85ef
    LDA result_low
    CLC
    ADC #&E0
    STA text_screen_address_low
    LDA result_high
    ADC #&60
    STA &CF
    LDA #&AA
    PLX                             \ 65C02 opcode
    JMP plot_title_screen_character

.display_high_scores
    JSR clear_part_of_title_screen
    LDA #&42
    STA &CF
    STA row_screen_address_high
    LDA #&90
    STA text_screen_address_low
    STA row_screen_address_low
    STZ score_offset                \ 65C02 opcode
    STZ &7D                         \ 65C02 opcode
    LDA #&07
    STA ranks_remaining
.display_high_scores_rank_loop
    LDA #&3C                        \ CC
    STA text_colour
    LDA #&05
    STA unused_0076 + 1
.write_high_score_loop
    LDY score_offset
    LDA high_scores,Y
    INC score_offset
    TAX
    LDA #&AA
    JSR plot_title_screen_character
    DEC unused_0076 + 1
    BPL write_high_score_loop
    LDX #&27                        \ "."
    LDA #&AA
    JSR plot_title_screen_character
    LDX #&27                        \ "."
    LDA #&AA
    JSR plot_title_screen_character
    LDA #&11
    STA unused_0076 + 1
    LDA #&03
    STA text_colour
.write_high_score_name_loop
    LDY &7D
    LDA high_score_names,Y
    INC &7D
    TAX
    LDA #&AA
    JSR plot_title_screen_character
    DEC unused_0076 + 1
    BPL write_high_score_name_loop
    LDA row_screen_address_high
    CLC
    ADC #&05
    STA &CF
    STA row_screen_address_high
    LDA row_screen_address_low
    STA text_screen_address_low
    DEC ranks_remaining
    BPL display_high_scores_rank_loop
    RTS

.scroll_scrolltext
    LDA #&74
    STA &C6
    STA &C8
    LDA #&88                        \ &7488
    STA source_address_low
    LDA #&80                        \ &7480
    STA target_address_low
    LDX #&4E
.scroll_scrolltext_column_loop
    LDY #&07
.scroll_scrolltext_byte_loop
    LDA (source_address),Y
    STA (target_address),Y
    DEY
    BPL scroll_scrolltext_byte_loop
    LDA source_address_low
    CLC
    ADC #&08
    STA source_address_low
    BCC skip_page_source
    INC &C6
.skip_page_source
    LDA target_address_low
    CLC
    ADC #&08
    STA target_address_low
    BCC skip_page_targeth
    INC &C8
.skip_page_targeth
    DEX
    BPL scroll_scrolltext_column_loop
    RTS

.update_scrolltext
    JSR scroll_scrolltext
    LDY scrolltext_buffer_offset
    LDX #&00
.copy_column_of_buffer_to_screen_loop
    LDA scrolltext_buffer,Y
    STA &76F8,X
    INY
    INX
    CPX #&08
    BCC copy_column_of_buffer_to_screen_loop
    STY scrolltext_buffer_offset
    CPY #&18
    BCC leave_88b4
.initialise_scrolltext_buffer
    STZ scrolltext_buffer_offset    \ 65C02 opcode
    LDA #LO(scrolltext_buffer)      \ &89ee = scrolltext_buffer
    STA text_screen_address_low
    LDA #HI(scrolltext_buffer)
    STA &CF
    LDA #&3C                        \ CC
    STA text_colour
    LDA (scrolltext_address)        \ 65C02 opcode
    TAX
    LDA #&AA
    JSR plot_title_screen_character
    LDA &89
    LDX &8A
    INC A                           \ 65C02 opcode
    BNE skip_page_88a4
    INX
.skip_page_88a4
    CPX #HI(scrolltext_text + 669)  \ &925e = end_of_scrolltext
    BNE not_end_of_scrolltext
    CMP #LO(scrolltext_text + 669)
    BNE not_end_of_scrolltext
    LDX #HI(scrolltext_text)        \ &8fc1 = scrolltext_text
    LDA #LO(scrolltext_text)
.not_end_of_scrolltext
    STX &8A
    STA &89
.leave_88b4
    RTS

.title_screen_irq1_handler
    PHX                             \ 65C02 opcode
    PHY                             \ 65C02 opcode
    LDA irq_accumulator
    PHA
    LDA sysvia_ifr                  \ System VIA interrupt flag register
    AND #&82
    CMP #&82                        \ &80 set if an interrupt occurred, &02 if v-sync
    BNE leave_title_screen_irq1_handler
.is_vsync
    DEC scrolltext_cooldown
    BPL leave_title_screen_irq1_handler
    LDA result_low                  \ Also used for source_address_low
    PHA
    LDA result_high                 \ Also used for source_address_high
    PHA
    LDA multiplicand                \ Also used for target_address_low
    PHA
    LDA multiplier_low              \ Also used for target_address_high
    PHA
    LDA &CD
    PHA
    LDA &CB
    PHA
    LDA &CA
    PHA
    LDA text_screen_address_low     \ Also used for screen_address_low
    PHA
    LDA &CF                         \ Also used for screen_address_high
    PHA
    LDA multiplier_high
    PHA
    LDA font_address_low
    PHA
    LDA font_address_high
    PHA
    LDA text_colour
    PHA
    LDA #&03
    STA scrolltext_cooldown
    JSR update_scrolltext
    DEC title_screen_cooldown
    PLA
    STA text_colour
    PLA
    STA font_address_high
    PLA
    STA font_address_low
    PLA
    STA multiplier_high
    PLA
    STA &CF
    PLA
    STA text_screen_address_low
    PLA
    STA &CA
    PLA
    STA &CB
    PLA
    STA &CD
    PLA
    STA multiplier_low
    PLA
    STA multiplicand
    PLA
    STA result_high
    PLA
    STA result_low
.leave_title_screen_irq1_handler
    PLA
    STA irq_accumulator
    PLY                             \ 65C02 opcode
    PLX                             \ 65C02 opcode
    JMP (previous_irq1_vector_for_title_screen_low)

.high_scores
    EQUB &00, &01, &00, &00, &00, &00    \ 010000
    EQUB &00, &00, &09, &00, &00, &00    \ 009000
    EQUB &00, &00, &08, &00, &00, &00    \ 008000
    EQUB &00, &00, &07, &00, &00, &00    \ 007000
    EQUB &00, &00, &06, &00, &00, &00    \ 006000
    EQUB &00, &00, &05, &00, &00, &00    \ 005000
    EQUB &00, &00, &04, &00, &00, &00    \ 004000
    EQUB &00, &00, &03, &00, &00, &00    \ 003000

.high_score_names
    EQUB &1C, &1E, &19, &0E, &1B, &12, &18, &1B, &25, &25, &1C, &18, &0F, &1D, &20, &0A, &1B, &0E    \ "SUPERIOR  SOFTWARE"
    EQUB &1C, &1E, &19, &0E, &1B, &12, &18, &1B, &25, &25, &1C, &18, &0F, &1D, &20, &0A, &1B, &0E    \ "SUPERIOR  SOFTWARE"
