\ draw_column.6502 - the renderer's column loop (render.6502 includes it, where ren_draw_sprite falls
\ into it). MODEL_B builds (decision 73) also assemble it in bank 5, in a scope of its own, to draw the
\ sprites that live there (ANDY's, on the Master): its mask and pixel operands are its own copy's.
.draw_column
{
    BRA_JMP each                    \ 65C02 opcode (NMOS: a JMP, C not being 1 when the flipped part's INC_A_CLC falls in)
.empty
    LDA col_ptr                     \ an empty column: 2 bytes
    CLC
    ADC #2
    STA col_ptr
    BCS empty_hi                    \ the page crossed (rare)
.to_next
    JMP next
.empty_hi
    INC col_ptr + 1
    BRA_CS to_next                  \ 65C02 opcode
.unflipped_j                        \ (after JMP next: reached only from clip_test)
    LDA ds_n
    SEC
    SBC ds_c
    BRA_JMP have_j                  \ 65C02 opcode
.clip_test                          \ j = n - c unflipped, c - 1 flipped (c = columns left)
    BIT dm_flip
    BPL unflipped_j
    LDA ds_c
    DEC_A_SEC                       \ 65C02 opcode
.have_j
    CMP dm_jmin
    BCC to_next                     \ left of the viewport
    CMP dm_jmax
    BCC visible                     \ not right of it: j < jmax...
    BEQ visible                     \ ...or j = jmax
    JMP next
.each
    LDY #1
    LDA (col_ptr),Y                 \ the count
    BEQ empty
    DEC_A_SEC                       \ 65C02 opcode: count - 1, the record's and the cell loop's
    STA rows_m1
    LDY #8
    STA (v_ptr),Y                   \ the record: count - 1 (then the address)
    LDA ds_line                     \ the lowest byte's line: the part's line - the first row
    SEC                             \ drawn (below 0: a cell up for each 8)
IF NMOS
    LDY #0                          \ NMOS: Y dead (each reloads it)
    SBC (col_ptr),Y
ELSE
    SBC (col_ptr)                   \ 65C02 opcode
ENDIF
    TAX
    LDA rows_m1                     \ col_ptr on to the next column: 2 + count bytes (the data
    SEC                             \ is found back from there)
    ADC #2
    ADC col_ptr
    STA col_ptr
    BCC on_same_page
    INC col_ptr + 1
.on_same_page
    BIT ds_clip
    BMI clip_test
.visible
    LDA b_ptr                       \ the cell of the column's bottom...
    STA s_ptr
    LDA b_ptr + 1
    STA s_ptr + 1
    TXA                             \ ...raised by its first row
    BMI up_cell                     \ negative (about 1 column in 8): a cell up for each 8, out of line
.raised                             \ A = X = the line of the lowest byte drawn
    ORA s_ptr                       \ the record's address
    LDY #9
    STA (v_ptr),Y
    LDY #10                         \ (LDY, not INY: the BCC below must start its next instruction on a page)
    LDA s_ptr + 1
    STA (v_ptr),Y
    LDA v_ptr                       \ the cells after it
    CLC
    ADC #11
    STA v_ptr
    BCC save_on_page                \ C = 0 on the common path
    INC v_ptr + 1
    CLC                             \ (the page-crossing path: C was 1)
    BRA_CC save_on_page             \ 65C02 opcode
.up_cell                            \ X = the line, negative: a cell up for each 8
    LDA s_ptr
    SEC
    SBC #&80
    STA s_ptr
    LDA s_ptr + 1
    SBC #&02                        \ C = 1 after this: the ring's high byte is 3 or more
    ORA #&40                        \ round the 16K: &3D-&3F (below the ring) -> &7D-&7F
    STA s_ptr + 1
    TXA
    SBC #&F8                        \ + 8 (C = 1); carry out when it reaches 0 or more
    TAX
    BCC up_cell
    BRA_CS raised                   \ 65C02 opcode: A = X = the line
.save_on_page                       \ C = 0 here (TXA, TAY, EOR leave it)
    \ the data: the byte for line Y of the first cell is data[count - 1 - (line - Y)], so
    \ d_ptr = the column + 2 + count - 1 - line = col_ptr - 1 - line = col_ptr + (line EOR &FF) - &100
    TXA
    TAY                             \ Y = the line
    EOR #&FF
    ADC col_ptr
    STA d_ptr
    LDA col_ptr + 1
    ADC #&FF
    STA d_ptr + 1
.cell                               \ Y = the line it starts on: does the column end in this cell?
    TYA
    SBC rows_m1                     \ line - (rows left - 1) (C = 1 already: the ADC #&FF above carried, col_ptr + 1 being 1 or more)
    BCS last_cell                   \ 0 or more: it ends here
    EOR #&FF                        \ no: rows left after this cell, less 1: rows - line - 2
    STA rows_m1
.byte                               \ down to line 0
    LDA (d_ptr),Y                   \ the pixel/mask index
    TAX
    LDA (s_ptr),Y
    STA (v_ptr),Y                   \ saved
mask_operand = * + 1
    AND &FFFF,X                     \ self-modified: the mask table for the flip
pix_operand = * + 1
    EOR &FFFF,X                     \ self-modified: the pixel table for the colour and flip
    STA (s_ptr),Y
    DEY
    BPL byte
    LDA d_ptr                       \ the next cell: the data 8 back (C = 0 from the cell test:
    SBC #7                          \ the byte loop leaves C alone, so 7 + 1)...
    STA d_ptr
    BCS data_same_page
    DEC d_ptr + 1
    SEC                             \ C = 1 on both paths
.data_same_page
    LDA v_ptr                       \ ...the save block 8 on (C = 1: 7 + 1)...
    ADC #7
    STA v_ptr
    BCC save_same_page
    INC v_ptr + 1
    CLC                             \ C = 0 on both paths
    BRA_CC save_same_page           \ 65C02 opcode
.ede5_more                          \ C = 0: the column goes on in the next cell (rare: out of the common path)
    EOR #&FF                        \ rows left after this cell, less 1
    STA rows_m1
    BRA_CC byte                     \ 65C02 opcode (C = 0, as the byte loop needs)
.save_same_page
    LDA s_ptr                       \ ...the screen a character row up (C = 0: &7F + 1)...
    SBC #&7F
    STA s_ptr
    LDA s_ptr + 1
    SBC #&02
    ORA #&40                        \ ...round the 16K: &3D-&3F (below the ring) -> &7D-&7F
    STA s_ptr + 1
    LDY #7                          \ ...from its bottom line: the cell test inline (C = 1, as
    TYA                             \ the ring's high byte is 3 or more)
    SBC rows_m1                     \ line - (rows left - 1)
    BCC ede5_more                   \ below 0: not the last cell (the last cell is the common case: falls through)
.last_cell                          \ A = line - rows left + 1: the last line drawn
    DEC_A_SBC                       \ 65C02 opcode: the line below it
    STA ede5_stop_imm               \ self-modified: the CPY below's operand (stop_y's zero page byte, no longer read)
.part_byte
    LDA (d_ptr),Y
    TAX
    LDA (s_ptr),Y
    STA (v_ptr),Y
mask_operand_2 = * + 1
    AND &FFFF,X                     \ self-modified, as mask_operand
pix_operand_2 = * + 1
    EOR &FFFF,X                     \ self-modified, as pix_operand
    STA (s_ptr),Y
    DEY
ede5_stop_imm = * + 1
    CPY #0                          \ self-modified: the line below the last one drawn (set at .last_cell)
    BNE part_byte
.next_c                             \ C = 1: the loop's CPY found Y = stop_y, or .next set it
    DEC ds_c
    BEQ done
    BIT dm_flip                     \ the next column's bottom
    BPL step_forward
    LDA b_ptr                       \ flipped: back 8 (C = 1)
    SBC #8
    STA b_ptr
    BCC step_back_hi
    JMP each
.next                               \ v_ptr: this column's last cell (the next record 8 on)
    SEC                             \ (from empty and clip_test: carry either way)
    BRA_CS next_c                   \ 65C02 opcode
.step_forward
    LDA b_ptr                       \ on 8 (C = 1)
    ADC #7
    STA b_ptr
    BCS forward_hi
    JMP each
.step_back_hi
    DEC b_ptr + 1                   \ the high byte down a page: &40 -> &3F -> &7F (round the 16K)
    LDA #&40
IF NMOS
    ORA b_ptr + 1                   \ NMOS: A = &40
    STA b_ptr + 1
ELSE
    TSB b_ptr + 1
ENDIF
    BRA_CC to_each                  \ 65C02 opcode
.forward_hi
    INC b_ptr + 1                   \ up a page: &7F -> &80 -> &40 (round the 16K)
    BPL to_each
    LSR b_ptr + 1
.to_each
    JMP each
.done
    RTS
}
