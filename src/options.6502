\ options.6502 - GAMEPLAY_OPTIONS (decision 46; docs/briefs/gameplay-shield.md): "6 GAME RULES" on
\ the title screen, a screen to set the lives (1-9 or infinite), how far a death rewinds the view,
\ the timer (off, counting up, counting down), and the shield's hits and recharge (decision 50),
\ kept for the session. In bank 5 with the front
\ end, after its music (the hooks before it are the same size as what they replace, so the music
\ stays page-aligned). start_game (shield_new_game, run with bank 5 paged) copies the settings in.

OPT_INFINITE = 10                   \ opt_lives for infinite lives: lives shows the glyph lives_digits has at 10

.opt_lives          EQUB LIVES_START
.opt_respawn        EQUB 0          \ an index into opt_respawn_columns: 40 (KC, 2026-10-21)
.opt_timer          EQUB GAMEPLAY_TIMER   \ 0 off, 1 counting up, 2 counting down
.opt_hits           EQUB 1          \ decision 50: an index into opt_hits_unit: 2 hits (decision 44's)
.opt_recharge       EQUB 1          \ an index into opt_recharge_passes: 5 seconds (decision 44's)
IF GAMEPLAY_RUN
.opt_run_time       EQUB 0          \ decision 52: an index into opt_run_drain: 5 seconds (KC, 2026-10-21)
.opt_run_charge     EQUB 1          \ an index into opt_run_give: 10 seconds
.opt_run_drain_lo                   \ 8.8 a pass: RUN_FULL over 5, 10, 15, 20 seconds, and off (0)
    EQUB LO(2560 DIV 5), LO(2560 DIV 10), LO((2560 + 7) DIV 15), LO(2560 DIV 20), 0
.opt_run_drain_hi
    EQUB HI(2560 DIV 5), HI(2560 DIV 10), HI((2560 + 7) DIV 15), HI(2560 DIV 20), 0
ENDIF
.opt_limit          EQUB 3          \ decision 55: an index into opt_limit_hi/lo: 10 minutes (decision 47's)
.opt_limit_hi                       \ the limit in BCD seconds: 3, 5, 8, 10, 15 minutes
    EQUB &01, &03, &04, &06, &09
.opt_limit_lo
    EQUB &80, &00, &80, &00, &00
.opt_respawn_columns
    EQUB 40, 80, 120, 160
.opt_hits_unit                      \ a bullet's damage: a full shield (SHIELD_FULL, 50) takes 1, 2, 3, 4, 6
    EQUB 50, 25, 17, 13, 9
.opt_hits_digit                     \ what the screen shows for each
    EQUB 1, 2, 3, 4, 6
.opt_recharge_passes                \ 2, 5, 8, 10 seconds of the design speed (25 passes)
    EQUB 50, 125, 200, 250

.option_value                       \ a value's text: where, colour, four characters, the end
    EQUB 0, 0, &3F, 0, 0, 0, 0, &FF

\ options_title: the title's text, and the sixth line (display_title_screen's LDX/LDY/JSR, replaced)
.options_title
    LDX #HI(title_screen_text)
    LDY #LO(title_screen_text)
    JSR plot_title_screen_text
    LDX #HI(options_title_line)
    LDY #LO(options_title_line)
    JMP plot_more

\ options_key: the title's keys from "2" up (its CMP #&02 / BCS title_screen_loop, replaced): A = the
\ key's internal number - &30. "2" defines the controls as before; "6" (&34) the game rules
.options_key
    CMP #&02
    BCS not_two
    JMP title_two
.not_two
    AND #&7F
    CMP #&04                        \ "6": internal key &34
    BEQ options_screen
    JMP title_screen_loop

\ options_high_score: the title's check_for_high_score, but an infinite-lives game ended by ESCAPE
\ (not at the headquarters: game_completed 0) does not go on the table (KC, 2026-10-20)
.options_high_score
    LDA opt_lives
    CMP #OPT_INFINITE
    BNE ranked
    LDA game_completed
    BNE ranked
    SEC                             \ carry set: not ranked
    RTS
.ranked
    JMP check_for_high_score

.options_screen
{
    LDX #HI(options_text)
    LDY #LO(options_text)
    JSR plot_title_screen_text
.show
    LDA #LO(OPT_LIVES_AT)           \ the three values, each four characters in its place
    LDY #HI(OPT_LIVES_AT)
    JSR value
    LDA opt_respawn
    ASL A
    ASL A
    TAX                             \ 4 characters a setting
    LDA #LO(OPT_RESPAWN_AT)
    LDY #HI(OPT_RESPAWN_AT)
    JSR value_x
    LDA opt_timer
    ASL A
    ASL A
    ADC #timer_names - values
    TAX
    LDA #LO(OPT_TIMER_AT)
    LDY #HI(OPT_TIMER_AT)
    JSR value_x
    LDX opt_hits                    \ decision 50: a digit
    LDA opt_hits_digit,X
    TAX
    LDA #LO(OPT_HITS_AT)
    LDY #HI(OPT_HITS_AT)
    JSR value_digit
    LDA opt_recharge
    ASL A
    ASL A
    ADC #recharge_names - values
    TAX
    LDA #LO(OPT_RECHARGE_AT)
    LDY #HI(OPT_RECHARGE_AT)
    JSR value_x
    LDA opt_limit                   \ decision 55
    ASL A
    ASL A
    ADC #limit_names - values
    TAX
    LDA #LO(OPT_LIMIT_AT)
    LDY #HI(OPT_LIMIT_AT)
    JSR value_x
IF GAMEPLAY_RUN
    LDA opt_run_time                \ decision 52
    ASL A
    ASL A
    ADC #run_names - values
    TAX
    LDA #LO(OPT_RUN_AT)
    LDY #HI(OPT_RUN_AT)
    JSR value_x
    LDA opt_run_charge
    ASL A
    ASL A
    ADC #run_names - values
    TAX
    LDA #LO(OPT_CHARGE_AT)
    LDY #HI(OPT_CHARGE_AT)
    JSR value_x
ENDIF
.key
    JSR get_keypress
    CMP #&70                        \ ESCAPE: back to the title
    BNE not_escape
    JMP display_title_screen
.not_escape
    CMP #&30                        \ "1": the lives, 1-9 then infinite
    BNE not_lives
    LDA opt_lives
    INC A                           \ 65C02 opcode
    CMP #OPT_INFINITE + 1
    BCC lives_ok
    LDA #1
.lives_ok
    STA opt_lives
    JMP show
.not_lives
    CMP #&31                        \ "2": the rewind, 40 / 80 / 120 / 160 columns
    BNE not_respawn
    LDA opt_respawn
    INC A
    AND #3
    STA opt_respawn
    JMP show
.not_respawn
    CMP #&12                        \ "4": the shield's hits, 1 / 2 / 3 / 4 / 6 (decision 50)
    BNE not_hits
    LDA opt_hits
    INC A
    CMP #5
    BCC hits_ok
    LDA #0
.hits_ok
    STA opt_hits
    JMP show
.not_hits
    CMP #&13                        \ "5": the recharge, 2 / 5 / 8 / 10 seconds
    BNE not_recharge
    LDA opt_recharge
    INC A
    AND #3
    STA opt_recharge
    JMP show                        \ (out of a branch's reach)
.not_recharge
    CMP #&15                        \ "8": the timer's limit, 3 / 5 / 8 / 10 / 15 minutes (decision 55)
    BNE not_limit
    LDA opt_limit
    INC A
    CMP #5
    BCC limit_ok
    LDA #0
.limit_ok
    STA opt_limit
    JMP show
.not_limit
IF GAMEPLAY_RUN
    CMP #&34                        \ "6": the run time, 5 / 10 / 15 / 20 seconds or off (decision 52)
    BNE not_run_time
    LDA opt_run_time
    INC A
    CMP #5
    BCC run_time_ok
    LDA #0
.run_time_ok
    STA opt_run_time
    JMP show
.not_run_time
    CMP #&24                        \ "7": the run charge, 5 / 10 / 15 / 20 seconds
    BNE not_run_charge
    LDA opt_run_charge
    INC A
    AND #3
    STA opt_run_charge
    JMP show
.not_run_charge
ENDIF
    CMP #&11                        \ "3": the timer, off / up / down
    BEQ timer_key
    JMP key
.timer_key
    LDA opt_timer
    INC A
    CMP #3
    BCC timer_ok
    LDA #0
.timer_ok
    STA opt_timer
    JMP show

\ value: the lives' four characters (a digit and three spaces, or INF); value_x: X the respawn's or
\ the timer's four, from values. A/Y: where on the screen
.value_x
    STA option_value
    STY option_value + 1
    LDY #0
.copy
    LDA values,X
    STA option_value + 3,Y
    INX
    INY
    CPY #4
    BNE copy
    BRA plot_value                  \ 65C02 opcode
.value_digit                        \ X: the digit
    STA option_value
    STY option_value + 1
    TXA
    BRA digit                       \ 65C02 opcode
.value
    STA option_value
    STY option_value + 1
    LDA opt_lives
    CMP #OPT_INFINITE
    BNE digit
    LDY #0
.copy_inf
    LDA lives_inf,Y
    STA option_value + 3,Y
    INY
    CPY #4
    BNE copy_inf
    BRA plot_value
.digit
    STA option_value + 3            \ the digit, then three spaces
    LDA #&25
    STA option_value + 4
    STA option_value + 5
    STA option_value + 6
.plot_value
    LDX #HI(option_value)
    LDY #LO(option_value)
}
.plot_more                          \ more text (X/Y its address) without clearing the screen first
    STX text_address_high
    STY text_address_low
    LDY #0
    JMP plot_title_screen_text_loop

OPT_LINE        = &4000 + 96        \ a setting's line: its row's first byte + 96 (the values at character 13)
OPT_VALUE       = OPT_LINE + 13 * 24
OPT_LIVES_AT    = OPT_VALUE + 3 * &280
OPT_RESPAWN_AT  = OPT_VALUE + 5 * &280
OPT_TIMER_AT    = OPT_VALUE + 7 * &280
OPT_HITS_AT     = OPT_VALUE + 9 * &280            \ decision 50
OPT_RECHARGE_AT = OPT_VALUE + 11 * &280
OPT_RUN_AT      = OPT_VALUE + 13 * &280            \ decision 52
OPT_CHARGE_AT   = OPT_VALUE + 15 * &280
OPT_LIMIT_AT    = OPT_VALUE + 17 * &280            \ decision 55
