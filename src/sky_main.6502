\ sky_main.6502 - SKY_HELI (src/sky.6502): its colder half (take_off's, the column checks, the
\ image's kind) and its per-screen state, in main RAM where the kind cache's builder was. &3000 on
\ is per screen: the renderer draws with ACCCON's X bit set for the shadow screen, so each screen
\ has its own image and state at these addresses (render_reset copies main to shadow at each
\ game's start, the code with it: what the code modifies of itself it sets before it runs, on the
\ screen it runs on).

\ sky_room: put_on's: room for a save block below helicopter 1's image (the end of the arena), made
\ if not (compact), X = back. C set if there is none even then (a scene heavier than any played):
\ the block may run into the image, which is dropped, and nothing goes in sky mode.
.sky_room
{
    JSR test
    BCC ok
    JSR compact
    JSR test
    BCC ok
    LDA #&FF
    STA sky_k + 1
.ok
    RTS
.test
    LDX back
    LDA arena_top_lo,X
    CMP #LO(SKY_IMG1 - MAX_BLOCK + 1)
    LDA arena_top_hi,X
    SBC #HI(SKY_IMG1 - MAX_BLOCK + 1)
    RTS
}

\ sky_erase_old: helicopter sky_s's rectangle on this screen zeroed (the sky it covered); it is no
\ longer in sky mode here. Keeps sky_H.
.sky_erase_old
{
    LDA sky_H
    PHA
    JSR sky_old_geom
    JSR sky_zero
    LDX sky_s
    STZ sky_on,X                    \ 65C02 opcode
    PLA
    STA sky_H
    RTS
}

\ sky_old_geom: helicopter sky_s's old rectangle's geometry (sky_geom), its columns drawn
.sky_old_geom
    LDX sky_s
    LDA sky_h,X
    STA sky_H
    LDA sky_ojl,X
    STA sky_d1
    LDA sky_ojh,X
    STA sky_d2
    LDA sky_adr_hi,X
    PHA
    LDA sky_adr_lo,X
    PLX                             \ 65C02 opcode
    JMP sky_geom                    \ (it was drawn: none runs past &7FFF)

\ sky_image: the image for this kind held (built if not): the body sprite, the line, the pixel
\ table (colour and flip), the height (the blocks it uses)
.sky_image
{
    LDA draw_column.pix_operand
    STA sky_plo
    LDA draw_column.pix_operand + 1
    STA sky_phi
    LDA sky_s                       \ sky_k: the kind's 5 bytes, each per helicopter
    ORA #2 * 4
    TAY
    LDX #4
.each
    LDA sky_body,X
    CMP sky_k,Y
    BNE build
    DEY
    DEY
    DEX
    BPL each
    RTS
.build
    LDA sky_s
    ORA #2 * 4
    TAY
    LDX #4
.copy
    LDA sky_body,X
    STA sky_k,Y
    DEY
    DEY
    DEX
    BPL copy
    JMP sky_build
}

\ ---- the rectangle ------------------------------------------------------------------------
\ sky_row: X = a character row: s_ptr its first drawn cell; sky_n its lines, sky_skip 8 - them, Y
\ its last drawn column's top byte; Z set if it is a whole row
.sky_row
    LDA sky_rl,X
    STA s_ptr
    LDA sky_rh,X
    STA s_ptr + 1
    LDA sky_rt,X
    ORA sky_ry,X
    TAY
    LDA sky_rn,X
    STA sky_n
    DEC A                           \ 65C02 opcode: n is 1 to 8, so 8 - n = (n - 1) EOR 7
    EOR #7
    STA sky_skip                    \ (A = 8 - n and Z for the caller: no reload)
    RTS
    SKIP 1                          \ (so the code after stays at its addresses)

\ sky_draw: helicopter sky_s's image over the rectangle's columns drawn: a whole character row four
\ bytes a loop, a part row's cells from an entry into eight lines unrolled
.sky_draw
{
    LDA sky_s                       \ the OR below: 4 for helicopter 1 (sky_s is 0 or 1), 0 for helicopter 0
    ASL A
    ASL A
    STA g93_or + 1                  \ self-modified
    LDA sky_d1
    ASL A
    ASL A
    ASL A
    STA sky_j8
    LDX #0
    CLC                             \ (clear to the add below: next_row's CPX leaves it so, X below sky_nq)
.row
    STX sky_q
    LDA sky_rb,X                    \ the image: its block, + 8 * the first column drawn
.g93_or
    ORA #0                          \ self-modified: sky_s * 4
    TAY
    LDA sky_blk_lo,Y
    ADC sky_j8
    STA d_ptr
    LDA sky_blk_hi,Y
    ADC #0
    STA d_ptr + 1
    LDA d_ptr                       \ + the entry's first column
    CLC
    ADC sky_rc,X
    STA d_ptr
    BCC rc_ok
    INC d_ptr + 1
.rc_ok
    JSR sky_row
    BNE part
    LDA d_ptr                       \ a whole row: the four copies' operands set from the pointers
    STA sdw_l1 + 1
    STA sdw_l2 + 1
    STA sdw_l3 + 1
    STA sdw_l4 + 1
    LDA d_ptr + 1
    STA sdw_l1 + 2
    STA sdw_l2 + 2
    STA sdw_l3 + 2
    STA sdw_l4 + 2
    LDA s_ptr
    STA sdw_s1 + 1
    STA sdw_s2 + 1
    STA sdw_s3 + 1
    STA sdw_s4 + 1
    LDA s_ptr + 1
    STA sdw_s1 + 2
    STA sdw_s2 + 2
    STA sdw_s3 + 2
    STA sdw_s4 + 2
.sdw_l1
    LDA &FFFF,Y                     \ self-modified: the image
.sdw_s1
    STA &FFFF,Y                     \ self-modified: the screen
    DEY
.sdw_l2
    LDA &FFFF,Y
.sdw_s2
    STA &FFFF,Y
    DEY
.sdw_l3
    LDA &FFFF,Y
.sdw_s3
    STA &FFFF,Y
    DEY
.sdw_l4
    LDA &FFFF,Y
.sdw_s4
    STA &FFFF,Y
    DEY
    BPL sdw_l1
    BMI next_row                    \ (always)
.part                               \ A = 8 - lines: in at line8 + 5 * that
    ASL A
    ASL A
    ADC sky_skip                    \ (C clear: 4 * at most 7)
    ADC #LO(line8)
    STA cell + 1
    LDA #HI(line8)
    ADC #0
    STA cell + 2
.cell
    JMP &FFFF                       \ self-modified: the entry
.line8
FOR k = 1..8
    LDA (d_ptr),Y
    STA (s_ptr),Y
    DEY
NEXT
    TYA                             \ the cell to the left's top (negative: none)
    SEC
    SBC sky_skip
    TAY
    BPL cell
.next_row
    LDX sky_q
    INX
    CPX sky_nq
    BEQ done
    JMP row
.done
    RTS
}

\ sky_zero: the rectangle's columns drawn zeroed
.sky_zero
{
    LDX #0
.row
    STX sky_q
    JSR sky_row
    BNE cell
    LDA #0
.whole
    STA (s_ptr),Y
    DEY
    BPL whole
    BMI next_row                    \ (always)
.cell
    LDX sky_n
    LDA #0
.line
    STA (s_ptr),Y
    DEY
    DEX
    BNE line
    TYA
    SEC
    SBC sky_skip
    TAY
    BPL cell
.next_row
    LDX sky_q
    INX
    CPX sky_nq
    BNE row
    RTS
}

\ ---- per screen ----
    ASSERT * >= &3000
.sky_on         SKIP 2              \ per helicopter: non-zero, drawn here in sky mode
.sky_adr_lo     SKIP 2              \ its rectangle: the bottom left byte, the rows
.sky_adr_hi     SKIP 2
.sky_h          SKIP 2
.sky_ojl        SKIP 2              \ its columns drawn (as its image numbers them)
.sky_ojh        SKIP 2
.sky_k          SKIP 2 * 5          \ the image's kind (sky_body to sky_H), each per helicopter: body
                                    \ sprite (&FF: none), line, pixel table, height

.sky_img0       SKIP SKY_IMG_SIZE   \ helicopter 0's image (1's: SKY_IMG1), a block a character row
