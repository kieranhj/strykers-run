\ font.6502 - the in-game font: INCLUDEd by game.6502, before the mover sprites in the
\ shipping build and after them in the relocation test builds (BUGS.md #2).

.font_data    \ # start with A, 60 = " ", six bytes per character
    EQUB &FF, &F9, &19, &19, &FF, &00    \ &00 : "A"
    EQUB &FF, &F9, &C1, &C1, &C0, &00    \ &06 : "C"
    EQUB &FF, &F9, &C1, &C3, &FE, &00    \ &0c : "D"
    EQUB &FF, &F9, &C9, &C9, &C0, &00    \ &12 : "E"
    EQUB &00, &C1, &FF, &F9, &C1, &00    \ &18 : "I"
    EQUB &FF, &F8, &0C, &36, &C3, &00    \ &1e : "K"
    EQUB &FF, &F8, &C0, &C0, &C0, &00    \ &24 : "L"
    EQUB &FF, &F3, &06, &03, &FF, &00    \ &2a : "M"
    EQUB &FF, &F9, &01, &01, &FF, &00    \ &30 : "N"
    EQUB &FF, &F9, &C1, &C1, &FF, &00    \ &36 : "O"
    EQUB &FF, &F9, &19, &19, &1F, &00    \ &3c : "P"
    EQUB &FF, &F9, &19, &19, &EF, &00    \ &42 : "R"
    EQUB &CF, &CD, &C9, &F9, &F8, &00    \ &48 : "S"
    EQUB &01, &01, &FF, &F9, &01, &00    \ &4e : "T"
    EQUB &3F, &78, &C0, &60, &3F, &00    \ &54 : "U" or "V"
    EQUB &3F, &38, &E0, &20, &3F, &00    \ &5a : "Y"
    EQUB &00, &00, &00, &00, &00, &00    \ &60 : " "
    EQUB &FF, &F9, &C1, &DB, &F8, &00    \ &66 : "G"
    EQUB &00, &FE, &F2, &C2, &C2, &FE    \ &6c : "0"
    EQUB &00, &00, &FE, &F0, &00, &00    \ &72 : "1"
    EQUB &00, &F2, &F2, &D2, &D2, &DE    \ &78 : "2"
    EQUB &00, &C0, &D2, &D2, &D2, &FE    \ &7e : "3"
    EQUB &00, &1E, &10, &FC, &F0, &10    \ &84 : "4"
    EQUB &00, &DE, &D2, &D2, &D2, &F2    \ &8a : "5"
    EQUB &00, &FE, &E8, &C8, &C8, &F8    \ &80 : "6"
    EQUB &00, &02, &C2, &F2, &3E, &0E    \ &96 : "7"
    EQUB &00, &FE, &F2, &D2, &D2, &FE    \ &9c : "8"
    EQUB &00, &1E, &12, &12, &F2, &FE    \ &a2 : "9"
