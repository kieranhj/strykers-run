\ sfx50.6502 - a small 50 Hz sound effect driver for the SN76489 (step 2 layer 3, decision 25).
\
\ Call sfx_tick once a field (from the vsync interrupt, interrupts off). An effect is a list of
\ ramps, made by tools/sfx50.py: over N fields the channel's period (or noise control) and its
\ amplitude each change by a fixed step a field. 6 bytes a ramp:
\   N (0: the end - the channel is silenced), period low, period high, period step (signed),
\   amplitude * 16 + 8, amplitude step (signed, sixteenths)
\ and tables sfx_effect_lo / sfx_effect_hi of their addresses.
\
\ To start effect E on chip channel C (0-2 tone, 3 noise), from anywhere: STA E + 1 into
\ sfx_request + C. The driver takes it at its next tick, replacing what the channel was playing.
\ sfx_request (4 bytes) is the caller's, somewhere the interrupt always sees; everything else
\ is here. sfx_silence stops all four channels and forgets them.
\
\ The chip is written as the MOS writes it: System VIA port A all outputs, the byte, then the
\ addressable latch's line 0 (the chip's write enable) low and high again, with the MOS's delays.
\ Interrupts must be off (sfx_tick runs in the interrupt; sfx_silence turns them off itself).
\ Needs sysvia_ddra, sysvia_ora_nh, sysvia_orb (os.6502) and a 65C02 (STZ, BRA, INC A).

.sfx_tick
{
    LDA sfx_request                 \ any request this tick? (most ticks have none: 19 cycles, not 28)
    ORA sfx_request + 1
    ORA sfx_request + 2
    ORA sfx_request + 3
    BEQ sfx_t_req_none
    LDX #3                          \ the requests first, all four channels (no effect's first ramp
.sfx_t_req_each                     \ is empty, so this writes nothing to the chip)
    LDA sfx_request,X
    BEQ sfx_t_req_next
    STZ sfx_request,X               \ (a request in between these two is lost: the next replaces it)
    TAY                             \ E + 1: the tables are read one byte early
    LDA sfx_effect_lo - 1,Y
    STA sfx_ptr_lo,X
    LDA sfx_effect_hi - 1,Y
    STA sfx_ptr_hi,X
    STA sfx_noise_written,X         \ the noise control is written when it changes: not yet (an address's high byte, never 0-7)
    JSR sfx_next_ramp
.sfx_t_req_next
    DEX
    BPL sfx_t_req_each
.sfx_t_req_none
    LDX #3                          \ then each channel's step
.channel
    LDA sfx_n,X
    BEQ next
    JSR sfx_output
    LDA sfx_dp,X                    \ the period steps (16 bits, the step sign-extended)
    BPL up
    CLC                             \ the step negative (its high byte &FF): a carry leaves the high byte
    ADC sfx_p_lo,X
    STA sfx_p_lo,X
    BCS sfx_pa_clc
    DEC sfx_p_hi,X                  \ no carry: the high byte less 1
    BRA sfx_pa_c0                   \ 65C02 opcode; C = 0
.up
    CLC
    ADC sfx_p_lo,X
    STA sfx_p_lo,X
    BCC sfx_pa_c0                   \ C = 0
    INC sfx_p_hi,X
.sfx_pa_clc
    CLC
.sfx_pa_c0
    LDA sfx_dv,X                    \ the amplitude steps, kept between 0 and 15
    BMI down
    ADC sfx_v,X                     \ (C = 0 on every path here)
    BCC v_known
    LDA #&F8
    BNE v_known                     \ always
.down
    ADC sfx_v,X
    BCS v_known
    LDA #0
.v_known
    STA sfx_v,X
    DEC sfx_n,X
    BNE next
    JSR sfx_next_ramp
.next
    DEX
    BPL channel
    RTS
}

\ X = channel: its next ramp, from sfx_ptr; at the end, the channel is silenced.
.sfx_next_ramp
{
    LDA sfx_ptr_lo,X
    STA ramp + 1
    LDA sfx_ptr_hi,X
    STA ramp + 2
    LDY #0
    JSR ramp
    BEQ ended
    STA sfx_n,X
    LDA sfx_ptr_hi,X                \ the other five bytes inline: each load's operand is the ramp's
    STA nr_c1_b1 + 2                \ page and the byte's offset, Y the ramp's low byte (a page is
    STA nr_c1_b2 + 2                \ crossed exactly where ramp's LDA &FFFF,Y would cross one)
    STA nr_c1_b3 + 2
    STA nr_c1_b4 + 2
    STA nr_c1_b5 + 2
    LDY sfx_ptr_lo,X
.nr_c1_b1
    LDA &FF01,Y                     \ self-modified: the ramp's page
    STA sfx_p_lo,X
.nr_c1_b2
    LDA &FF02,Y                     \ self-modified: the ramp's page
    STA sfx_p_hi,X
.nr_c1_b3
    LDA &FF03,Y                     \ self-modified: the ramp's page
    STA sfx_dp,X
.nr_c1_b4
    LDA &FF04,Y                     \ self-modified: the ramp's page
    STA sfx_v,X
.nr_c1_b5
    LDA &FF05,Y                     \ self-modified: the ramp's page
    STA sfx_dv,X
    TYA                             \ the next ramp, 6 bytes on (Y = sfx_ptr_lo)
    CLC
    ADC #6
    STA sfx_ptr_lo,X
    BCC same_page
    INC sfx_ptr_hi,X
.same_page
    RTS
.ended
    STZ sfx_n,X
    LDA sfx_channel_bits,X
    ORA #&9F                        \ attenuation 15: off
    BRA sfx_write                   \ 65C02 opcode
.ramp
    LDA &FFFF,Y                     \ self-modified: this ramp
    RTS
}

\ X = channel: its period (or noise control) and amplitude to the chip.
.sfx_output
{
    CPX #3
    BEQ noise
    LDA sfx_p_lo,X                  \ tone: the latch byte with the period's low 4 bits...
    AND #&0F
    ORA sfx_channel_bits,X
    JSR sfx_write
    JSR sfx_write.ddra_set_c046b    \ the high byte, ready in A from the low byte's write (DDRA still &FF); this
    CMP sfx_noise_written,X         \ write's pulse works the amplitude out: A = v >> 4. What the chip has (a tone
    BEQ sfx_write.g1_rts             \ channel's slot of the noise control's array; a request left a high byte,
    STA sfx_noise_written,X         \ never 0-15): unchanged, nothing to send
    EOR g1_att_bits,X                \ the chip takes attenuation, &10: an amplitude latch byte: (n EOR &1F) OR channel
    BRA sfx_write.ddra_set_c046b    \ 65C02 opcode
.g1_att_bits
    EQUB &9F, &BF, &DF, &FF         \ channel bits OR &1F
.amplitude
    LDA sfx_v,X
    LSR A
    LSR A
    LSR A
    LSR A
    EOR g1_att_bits,X
noise = sfx_write.noise             \ after sfx_write's RTS
}
    \ falls through
\ A to the chip, as MOS 3.20 writes it (&F5E6). Keeps X. The byte for the next write is worked out
\ while the write enable is low (the MOS's delay there): after sfx_write, A = a tone's high byte (from the
\ period just stepped); after ddra_set_c046b, A = the amplitude v >> 4. Meant for sfx_output's tone; other
\ callers ignore A. No wait after the write enable goes high (the MOS's LDY #4 loop, 21 cycles; the lines
\ below it are no longer reached): the next write enable falls at least 20 cycles later (a tone's low byte,
\ its high byte: an RTS, a JSR and two stores), the chip needing 32 of its 4 MHz clocks, 16 cycles.
.sfx_write
{
    LDY #&FF
    STY sysvia_ddra
    STA sysvia_ora_nh
    STZ sysvia_orb                  \ latch line 0 low: write enable
    LDA sfx_p_hi,X                  \ a tone's high byte: the period >> 4: C = bit 0 of the period's high byte,
    LSR A                           \ A = its bit 1 in bit 0 with the low byte's bits 7-4 above (the rest
    EOR sfx_p_lo,X                  \ of the low nibble is dropped below)
    AND #&01
    EOR sfx_p_lo,X
    ROR A                           \ the two bits of the high byte enter at the top and the low byte's
    ROR A                           \ high nibble comes down beside them: &00 &00 h1 h0 l7-l4
    LSR A
    LSR A
    BRA g1_fin                       \ 65C02 opcode
.ddra_set_c046b                     \ entered with DDRA already &FF (sfx_output's tone)
    STA sysvia_ora_nh
    STZ sysvia_orb                  \ latch line 0 low: write enable
    LDA sfx_v,X                     \ the amplitude, n = v >> 4
    LSR A
    LSR A
    LSR A
    LSR A
.g1_fin
    LDY #&08
    STY sysvia_orb                  \ and high again
.g1_rts
    RTS
.wait_low
    DEY
    BNE wait_low
    LDA #&08
    STA sysvia_orb                  \ and high again (Y is still 0)
    RTS
.noise                              \ sfx_output's noise channel (its BEQ noise lands here)
    LDA sfx_p_lo,X                  \ noise: only when it changes (writing it restarts the noise)
    AND #&07
    CMP sfx_noise_written,X
    BEQ sfx_output.amplitude
    STA sfx_noise_written,X
    ORA #&E0
    JSR sfx_write
    BRA sfx_output.amplitude        \ 65C02 opcode
}

\ All four channels off, and forgotten (requests too).
.sfx_silence
{
    PHP
    SEI
    LDX #3
.each
    STZ sfx_request,X
    JSR sfx_next_ramp.ended         \ its channel off and forgotten (ends in sfx_write: Y = 0)
    DEX
    BPL each
    PLP
    RTS
}

.sfx_channel_bits                   \ the chip's channel in a latch byte: tone 0-2, noise
    EQUB &80, &A0, &C0, &E0
.sfx_ptr_lo
    SKIP 4
.sfx_ptr_hi
    SKIP 4
.sfx_n
    EQUB 0, 0, 0, 0
.sfx_p_lo
    SKIP 4
.sfx_p_hi
    SKIP 4
.sfx_dp
    SKIP 4
.sfx_v
    SKIP 4
.sfx_dv
    SKIP 4
.sfx_noise_written
    SKIP 4
.sfx_t
    SKIP 1
