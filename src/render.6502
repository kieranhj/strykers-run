\ render.6502 - step 2 layer 2: the renderer. Runs in sideways RAM bank 4, after the bank's
\ sprite data (bank 4 is paged whenever movers are drawn, so plot_mover can be called from here;
\ src/game.6502's render_pass and render_start page it in and jump here).
\
\ The game's logic no longer draws (decision 20): plot_mover's own calls work everything out but
\ write nothing, the player's save-under is gone from the logic, and the scroll hands its new edge
\ column here (history_push) instead of writing it. Once a pass's logic is done, render brings a
\ screen up to date from what it RECORDS that screen shows (layer 3: masked, decision 24):
\   1. which movers come off: shown in another state than the live one, or overlapping a column
\      the scroll writes or leaves, or the lives digit about to be redrawn
\   2. which go on: live, on screen, and not shown (or coming off)
\   3. any shown mover overlapping one of those comes off and goes back on too, so overlapping
\      movers are always drawn in slot order (the player last) and taken off in reverse
\   4. off: each one's save block put back, the player first, then from the last slot down
\   5. the scroll: each edge column this screen has not had, oldest first, with the screen
\      start, viewport and lives digit that went with it
\   6. on: each drawn through its mask from the straight sprite data (ANDY and bank 4), saving
\      what it covers into a save block in the screen's arena (save_arena, main or shadow RAM)
\ Records are per screen: index = slot + 64 * screen. Screen 0 is main RAM, screen 1 the Master's
\ shadow RAM, at the same addresses (&4000-&7FFF); the vsync interrupt shows each in turn.

REN_BASE    = &B400 + PAD_START     \ workspace above the code and data (DATA1 ASSERTs it), to &C000;
                                    \ not in the file
rec_type    = REN_BASE + &000       \ movers_type_and_colour as drawn
rec_frame   = REN_BASE + &080       \ movers_frame_and_flip
rec_xl      = REN_BASE + &100       \ movers_x_low
rec_xh      = REN_BASE + &180       \ movers_x_high; &FF = nothing drawn
rec_y       = REN_BASE + &200       \ movers_y
rec_sl      = REN_BASE + &280       \ movers_screen_address_low
rec_sh      = REN_BASE + &300       \ movers_screen_address_high
hist0       = REN_BASE + &400       \ the edge column history: two columns of 200 bytes
hist1       = REN_BASE + &500
save_start_lo = REN_BASE + &600     \ per screen and slot (index = slot + 64 * screen): the mover's
save_start_hi = REN_BASE + &680     \ save block in that screen's save_arena (start_hi 0: none)
save_end_lo = REN_BASE + &700
save_end_hi = REN_BASE + &780
zp_save     = REN_BASE + &800       \ the game's zero page, kept while the renderer draws
rec_wxl     = REN_BASE + &900       \ per record: where it was drawn, in the world - its column
rec_wxh     = REN_BASE + &980       \ and its y, from the screen address it was drawn at, not
rec_wy      = REN_BASE + &A00       \ movers_x/y (BUGS #7): world_of_address
ASSERT zp_save + &100 <= &C000 AND rec_wy + &80 <= &C000

MOVER_SLOTS = &22                   \ MOVER_LAST + 1
save_ptr    = &9C                   \ zero page, free since layer 2 (&9C/&9D)
\ zero page the renderer may use freely (restore_game_zp gives the logic back what it reads)
d_ptr       = &C0                   \ the sprite data, (d_ptr),Y
s_ptr       = &C2                   \ the screen's character cell, (s_ptr),Y
v_ptr       = &C4                   \ the save block, (v_ptr),Y
stop_y      = &C6                   \ the Y a segment's byte loop stops at
col_ptr     = &C7                   \ the sprite column being drawn (&C7/&C8)
b_ptr       = &C9                   \ the cell of a sprite column's bottom (&C9/&CA)
rows_m1     = &CB                   \ a column's rows still to do, less 1
ds_c        = &CC                   \ a part's columns left
ds_line     = &CD                   \ the line in the cell of a part's bottom
MAX_BLOCK   = &2A0                  \ more than any mover's save block: 636 bytes at most (tools/sprites.py stats)

\ =============================================================================================
\ history_push: the scroll has built a new edge column in column_buffer (update_screen pages
\ bank 4 and jumps here). Keep it, with the view it belongs to, for each screen to apply.
\ =============================================================================================
.history_push
{
    \ layer 3 (D): the column into its slot, 8 bytes a time. A push with no scroll since the
    \ last (the original's, after a hostile collision) pushes the last column again: from its
    \ slot, since column_buffer may hold the next scroll's, built ahead (src/prebuild.6502).
    LDA col_fresh
    BNE fresh
    JMP repush
.fresh
    STZ col_fresh                   \ 65C02 opcode
    LDX hist_next
    LDA hist_dst_hi,X
    STA dst1 + 2
    STA dst2 + 2
    STA dst3 + 2
    STA dst4 + 2
    STA dst5 + 2
    STA dst6 + 2
    STA dst7 + 2
    STA dst8 + 2
    LDX #200
    LDA pre_use                     \ the prebuilt column (src/prebuild.6502), whose rows 24-199
    BEQ copy                        \ are already in this slot: only the ground's rows
    LDA pre_hist
    BEQ copy
    DEC A                           \ 65C02 opcode
    CMP hist_next
    BNE copy
    LDX #24
.copy
    LDA column_buffer - 1,X
.dst1
    STA hist0 - 1,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 2,X
.dst2
    STA hist0 - 2,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 3,X
.dst3
    STA hist0 - 3,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 4,X
.dst4
    STA hist0 - 4,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 5,X
.dst5
    STA hist0 - 5,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 6,X
.dst6
    STA hist0 - 6,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 7,X
.dst7
    STA hist0 - 7,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 8,X
.dst8
    STA hist0 - 8,X                 \ self-modified: hist0 or hist1
    TXA
    SEC
    SBC #8
    TAX
    BNE copy
.pushed
    STZ pre_hist                    \ 65C02 opcode: the slot is this push's now
    LDX hist_next
.header                             \ X = the slot
    LDA edge_screen_address_low
    STA hist_edge_lo,X
    LDA edge_screen_address_high
    STA hist_edge_hi,X
    LDA screen_start_address_low
    STA hist_ss_lo,X
    LDA screen_start_address_high
    STA hist_ss_hi,X
    LDA crtc_start_address_low
    STA hist_crtc_lo,X
    LDA crtc_start_address_high
    STA hist_crtc_hi,X
    LDA viewport_left_low
    STA hist_vl_lo,X
    LDA viewport_left_high
    STA hist_vl_hi,X
    LDA viewport_right_low
    STA hist_vr_lo,X
    LDA viewport_right_high
    STA hist_vr_hi,X
    \ the direction: viewport_left moved by +1 (right) or -1 (left) since the last push
    LDA viewport_left_low
    SEC
    SBC last_vl_lo
    TAY
    LDA viewport_left_high
    SBC last_vl_hi
    BNE went_left
    CPY #1
    BEQ went_right
.went_left
    LDA #&FF
    BNE set_dir                     \ always
.went_right
    LDA #1
.set_dir
    STA hist_dir,X
    LDA viewport_left_low
    STA last_vl_lo
    LDA viewport_left_high
    STA last_vl_hi
    INC hist_seq
    LDA hist_seq
    STA hist_seqs,X
    TXA
    EOR #1
    STA hist_next
    RTS
.repush
    LDX hist_next
    LDA hist_dst_hi,X
    STA rp_dst + 2
    TXA
    EOR #1
    TAX
    LDA hist_dst_hi,X
    STA rp_src + 2
    LDX #200
.rp_loop
.rp_src
    LDA hist0 - 1,X                 \ self-modified: the last slot
.rp_dst
    STA hist0 - 1,X                 \ self-modified: this one
    DEX
    BNE rp_loop
    JMP pushed
}

\ =============================================================================================
\ render_reset: a game has started (render_start in src/game.6502). scroll_into_world has written the scenery into the screen;
\ nothing else is drawn there yet.
\ =============================================================================================
.render_reset
{
    LDX #127
    LDA #&FF
.clear_records
    STA rec_xh,X
    DEX
    BPL clear_records
    LDX #127                        \ no save blocks
    LDA #0
.no_blocks
    STA save_start_hi,X
    DEX
    BPL no_blocks
IF SKY_MODE
    JSR sky_reset                   \ no helicopter in sky mode, no image held (src/sky.6502), in
                                    \ main RAM: the copy below gives shadow the same
ELSE
    LDX #KC_SLOTS - 1               \ layer 4: no kinds built (src/kindcache.6502), none in use,
    LDA #&FF                        \ none asked for: the front end may have used HAZEL
.no_kinds
    STA kc_sprite,X
    STZ kc_ref,X                    \ 65C02 opcode
    DEX
    BPL no_kinds
    STA kc_want
    STZ kb_active                   \ 65C02 opcode: no build under way
ENDIF
    LDX #1
.each_screen
    LDA #LO(save_arena)             \ each screen's arena empty
    STA arena_top_lo,X
    LDA #HI(save_arena)
    STA arena_top_hi,X
    LDA hist_seq
    STA buf_seq,X
    LDA #&FF
    STA buf_lives,X
    JSR view_to_buffer
    DEX
    BPL each_screen
    LDA viewport_left_low
    STA last_vl_lo
    LDA viewport_left_high
    STA last_vl_hi
    STZ flip_pending
    STZ shown_screen
    \ the shadow screen starts as a copy of main, and shadow &3000-&3FFF as a copy of the code
    \ and data there: the renderer runs the plotters with the CPU seeing shadow RAM
    LDA acccon
    AND #&FA                        \ X = 0, D = 0: main, for the CPU and the video
    STA acccon
    STA acc_main
    ORA #&04
    STA acc_shadow
    STZ save_ptr
    LDA #&30
    STA save_ptr + 1
    LDY #0
.copy
    LDA (save_ptr),Y
    LDX acc_shadow
    STX acccon
    STA (save_ptr),Y
    LDX acc_main
    STX acccon
    INY
    BNE copy
    INC save_ptr + 1
    BPL copy                        \ up to &7FFF
    RTS
}

\ ---- the view: the zero-page values the plotter and the lives read ---------------------------
.view_to_buffer                     \ X = screen: the live view becomes that screen's
    LDA screen_start_address_low
    STA buf_ss_lo,X
    LDA screen_start_address_high
    STA buf_ss_hi,X
    LDA crtc_start_address_low
    STA buf_crtc_lo,X
    LDA crtc_start_address_high
    STA buf_crtc_hi,X
    LDA viewport_left_low
    STA buf_vl_lo,X
    LDA viewport_left_high
    STA buf_vl_hi,X
    LDA viewport_right_low
    STA buf_vr_lo,X
    LDA viewport_right_high
    STA buf_vr_hi,X
    RTS

.buffer_to_view                     \ X = screen: that screen's view becomes the live one
    LDA buf_ss_lo,X
    STA screen_start_address_low
    LDA buf_ss_hi,X
    STA screen_start_address_high
    LDA buf_crtc_lo,X
    STA crtc_start_address_low
    LDA buf_crtc_hi,X
    STA crtc_start_address_high
    LDA buf_vl_lo,X
    STA viewport_left_low
    LDA buf_vl_hi,X
    STA viewport_left_high
    LDA buf_vr_lo,X
    STA viewport_right_low
    LDA buf_vr_hi,X
    STA viewport_right_high
    RTS

.history_to_view                    \ X = history slot: the view after that scroll becomes live
    LDA hist_ss_lo,X
    STA screen_start_address_low
    LDA hist_ss_hi,X
    STA screen_start_address_high
    LDA hist_crtc_lo,X
    STA crtc_start_address_low
    LDA hist_crtc_hi,X
    STA crtc_start_address_high
    LDA hist_vl_lo,X
    STA viewport_left_low
    LDA hist_vl_hi,X
    STA viewport_left_high
    LDA hist_vr_lo,X
    STA viewport_right_low
    LDA hist_vr_hi,X
    STA viewport_right_high
    RTS

\ =============================================================================================
\ render: bring screen `back` up to date with the live game state
\ =============================================================================================
.render
{
    JSR prebuild                    \ RAM for cycles 1: the next scroll column, if there is time
IF SKY_MODE = 0
    INC kc_clock                    \ layer 4: a big part's kind asked for, built if there is time
    JSR kc_build                    \ (src/kindcache.6502)
ENDIF
    JSR wait_for_flip               \ the hidden screen is the one the last frame went to until
    JSR save_game_zp                \ it is shown (decision 26)
    LDA shown_screen                \ draw into the screen not being shown
    EOR #1
    STA back
    BEQ set_boff
    LDA #64
.set_boff
    STA boff
    JSR cpu_sees_back               \ ACCCON X: &3000-&7FFF is that screen's RAM
    LDX #2                          \ the logic's current view goes in slot 2 of buf_*
    JSR view_to_buffer

    \ ---- the scrolls this screen has not had: 0, 1 or 2, oldest first ----
    LDX back
    LDA hist_seq
    SEC
    SBC buf_seq,X
    STA pending_n
    LDA hist_next
    EOR #1
    STA pending_slot + 1            \ the newest
    LDX pending_n
    CPX #2
    BNE one_or_none
    LDA hist_next                   \ two: the older is the slot to be written next
    STA pending_slot
    JMP zones
.one_or_none
    STA pending_slot                \ one: only the newest
.zones
    \ ---- the zone: the columns the scroll writes or leaves, and the lives digit's ----
    STZ zone_n
    STZ lz_n                        \ 65C02 opcode: the lives digit's, as ranges (add_lives_zone)
    LDX pending_n
    BEQ no_scroll_zone
    LDY #0                          \ Y = which pending entry
    CPX #2
    BEQ add_entries
    INY                             \ one pending: it is pending_slot + 1 as well as + 0
.add_entries
    LDX pending_slot,Y
    JSR add_scroll_zone
    INY
    CPY #2
    BNE add_entries
.no_scroll_zone
    \ the lives digit is redrawn if the screen scrolls or the count changed: the four columns
    \ from the left edge, at the view it ends up with (and at the first scroll's, if two)
    STZ lives_redraw
    LDX back
    LDA buf_lives,X
    CMP HUD_KEY                     \ lives, or with GAMEPLAY_SHIELD hud_serial (the digit and the bar)
    BNE redraw_lives
    LDA pending_n
    BEQ lives_done
.redraw_lives
    DEC lives_redraw                \ &FF
    LDA buf_vl_lo + 2
    LDX buf_vl_hi + 2
    JSR add_lives_zone
    LDA pending_n
    CMP #2
    BNE lives_done
    LDX pending_slot
    LDA hist_vl_lo,X
    PHA
    LDA hist_vl_hi,X
    TAX
    PLA
    JSR add_lives_zone
.lives_done

    \ ---- 1. what comes off: shown here and stale (another state than the live slot, or in
    \ the zone). need: bit 7 take off, bit 6 put on ----
    STZ act_n                       \ and the list of slots that matter: shown here or live
    LDA boff                        \ the records' x high for this screen: rec_xh + boff
    ORA #LO(rec_xh)
    STA classify_xh
    ASSERT (LO(rec_xh) AND &40) = 0 AND LO(rec_xh) + 64 + MOVER_SLOTS <= &100
    LDX #0
.classify
    STZ need,X
classify_xh = * + 1
    LDA rec_xh,X                    \ self-modified: rec_xh + boff
    INC A                           \ &FF: nothing drawn here (65C02 opcode)
    BNE shown_y
    LDA movers_x_high,X
    BMI classified                  \ nothing shown, nothing there
    \ RAM for cycles 4: not shown here, and its x cannot put it on the screen (its high byte past
    \ the right edge's, or more than one below the left edge's: widths are under 256), so it
    \ cannot go on (mark_to_draw's check_if_mover_is_on_screen) and nothing else lists it
    CMP viewport_right_high
    BEQ near_screen
    BCS classified                  \ right of the screen
.near_screen
    INC A                           \ 65C02 opcode
    CMP viewport_left_high
    BCS listed                      \ not left of it
    BRA classified                  \ 65C02 opcode: left of it
.shown_y
    STX ren_i                       \ read back after span_in_zone (the shown path only)
    TXA                             \ Y = slot + boff for .shown (slot < 64: OR is the add)
    ORA boff
    TAY
.shown
IF DEBUG_FULLREDRAW
    BRA stale                       \ the oracle: everything comes off and goes back on
ENDIF
    JSR record_differs              \ (keeps X, Y)
    BNE stale
    LDA rec_wxl,Y                   \ where it was drawn (BUGS #7)
    STA span_x_lo
    LDA rec_wxh,Y
    STA span_x_hi
    LDA rec_type,Y
    AND #&7F                        \ width_of_type_A, inline
    TAX
    LDA mover_types_width_table,X
    JSR span_in_zone
    LDX ren_i                       \ (keeps C) X = ren_i on every path into stale and listed
    BCC listed
.stale
    LDA #&80
    STA need,X
.listed
    LDY act_n
    TXA
    STA act,Y
    INC act_n
.classified                         \ X = ren_i on every path in
    INX
    CPX #MOVER_SLOTS
    BNE classify

    \ ---- 2. what goes on; 3. what overlaps it comes off and goes back on too ----
    JSR mark_to_draw
    JSR close_over_overlaps

    \ ---- 4. take off: the player first (drawn last), then the movers from the last slot down ----
    LDX #0
    JSR take_off
    LDY act_n
    BEQ taken_off
.taking_off
    DEY
    STY ren_k
    LDX act,Y
    BEQ taken_off                   \ the player: first in the list, already off
    LDA need,X                      \ take_off's own first test, inline: most entries stay as they are
    BPL toff_skip_f
    JSR take_off
.toff_skip_f
    LDY ren_k
    BNE taking_off
.taken_off

    \ ---- 5. the scroll, oldest column first, each with its view and the lives digit ----
    LDA pending_n
    BEQ scrolled
    LSR A                           \ pending_n 1 or 2 -> Y 1 or 0
    EOR #1
    TAY
.apply_entries
    STY ren_k
    LDX pending_slot,Y
    JSR history_to_view             \ (keeps X, Y; changes only A): the view after this scroll
    LDA hist_seqs,X
    LDY back
    STA buf_seq,Y
    LDA HUD_KEY
    STA buf_lives,Y
    JSR write_column                \ X = the slot still
    JSR ren_plot_lives
    LDY ren_k
    BNE view_restore_f
    INY
    BRA apply_entries               \ 65C02 opcode
    SKIP 2                         \ keeps the code after it where it was
.view_restore_f
    LDX #2                          \ the logic's view again (history_to_view changed it); with nothing scrolled it never did
    JSR buffer_to_view
.scrolled
    LDX back                        \ buf_*[back] is never read: view_to_buffer's stores were dead
    LDA buf_lives,X
    CMP HUD_KEY
    BEQ lives_drawn
    JSR ren_plot_lives
    LDX back
    LDA HUD_KEY
    STA buf_lives,X
.lives_drawn

    \ ---- 6. put on: slot order, the player last; ANDY paged over bank 4's first 4K ----
    LDA #&84
    STA os_ram_copy_of_currently_selected_rom
    STA romsel
    LDY #0
    LDA act                         \ the player (slot 0) goes on last: when listed, it is first
    BNE put_on_test
    INY
.put_on_test
    CPY act_n                       \ (unsigned: act_n may be 0 with a stale player entry)
    BCS put_on_player
.putting_on
    LDX act,Y
    BIT need,X                      \ V = bit 6, it goes on: put_on's own test, done here
    BVC next_put_on
    PHY                             \ 65C02 opcode
    JSR put_on.going_on
    PLY                             \ 65C02 opcode
.next_put_on
    INY
    CPY act_n
    BCC putting_on
.put_on_player
    LDX #0
    JSR put_on
    LDA #&04
    STA os_ram_copy_of_currently_selected_rom
    STA romsel
.player_done
    LDA back                        \ for the vsync interrupt to show, at the pass lock's field
    STA flip_screen
    LDA crtc_start_address_high
    STA flip_crtc_hi
    LDA crtc_start_address_low
    STA flip_crtc_lo
    JSR cpu_sees_main
    JMP restore_game_zp
}

\ ---- ACCCON's X bit: which RAM the CPU sees at &3000-&7FFF (D, which the video shows, is the
\ vsync interrupt's). Read, change, write with interrupts off: the interrupt writes ACCCON too.
.cpu_sees_back
    LDA back
    BEQ cpu_sees_main
    SEI
    LDA acccon
    ORA #&04
    BNE set_acccon                  \ always
.cpu_sees_main
    SEI
    LDA acccon
    AND #&FB
.set_acccon
    STA acccon
    CLI
    RTS

\ ---- wait_for_flip: until the vsync interrupt has shown the last frame (decision 26: the logic
\ of the next pass runs meanwhile, and the renderer waits here) -------------------------------
.wait_for_flip
{
    BIT flip_pending
    BMI wait_for_flip
    RTS
}

\ ---- render_to_main: the game is over (or observer mode left): the newest frame on the main
\ screen, shown, so the game over text and the title go where the original put them.
.render_to_main
{
    JSR wait_for_flip               \ a flip still to come happens first
    LDA shown_screen
    BEQ done                        \ main is shown, and newest
    JSR render                      \ draws into main, the hidden one
    SEI
    LDX #&0C                        \ R12/R13 now: the text follows at once
    STX crtc_reg
    LDA crtc_start_address_high
    STA crtc_data
    INX
    STX crtc_reg
    LDA crtc_start_address_low
    STA crtc_data
    LDA acccon
    AND #&FE                        \ D = 0: the video shows main
    STA acccon
    STZ shown_screen
    STZ flip_pending
    CLI
.done
    RTS
}

\ ---- ren_plot_lives: the lives digit at the screen start, as plot_lives leaves it (its bytes do
\ not depend on what was there: src/lives_digits.6502, from tools/livesdigits.py) -------------
.ren_plot_lives
{
IF GAMEPLAY_SHIELD
\ decision 44: the top line's HUD_COLUMNS cells are hud_buffer (src/shield.6502 builds it: the
\ digit, then the bar, the timer), HUD_BYTES in a row unless they can pass &8000 (page &7F only:
\ from &7Exx they end by &7F7F). A byte column a turn, rows 1-7: row 0 is 0 in every column of the
\ HUD and, under it, on the screen (the top pixel row: no scenery reaches it anywhere in the world,
\ tools/worldmap.py; a mover over the HUD comes off before this and goes on after). 72 cycles a
\ column for 94
    LDA screen_start_address_high
    CMP #&7F
    BEQ hud_by_cell
    STA hud_r1 + 2
    STA hud_r2 + 2
    STA hud_r3 + 2
    STA hud_r4 + 2
    STA hud_r5 + 2
    STA hud_r6 + 2
    STA hud_r7 + 2
    LDA screen_start_address_low    \ a multiple of 8: + 1 .. + 7 by ORA and EOR
    ORA #1
    STA hud_r1 + 1
    EOR #3                          \ + 2
    STA hud_r2 + 1
    ORA #1                          \ + 3
    STA hud_r3 + 1
    EOR #7                          \ + 4
    STA hud_r4 + 1
    ORA #1                          \ + 5
    STA hud_r5 + 1
    EOR #3                          \ + 6
    STA hud_r6 + 1
    ORA #1                          \ + 7
    STA hud_r7 + 1
    LDY #HUD_BYTES - 8
    SEC
.hud_column
    LDA hud_buffer + 1,Y
.hud_r1
    STA &4001,Y                     \ self-modified, as are the six below: the screen start + 1 .. + 7
    LDA hud_buffer + 2,Y
.hud_r2
    STA &4002,Y
    LDA hud_buffer + 3,Y
.hud_r3
    STA &4003,Y
    LDA hud_buffer + 4,Y
.hud_r4
    STA &4004,Y
    LDA hud_buffer + 5,Y
.hud_r5
    STA &4005,Y
    LDA hud_buffer + 6,Y
.hud_r6
    STA &4006,Y
    LDA hud_buffer + 7,Y
.hud_r7
    STA &4007,Y
    TYA                             \ C = 1: the column before
    SBC #8
    TAY
    BCS hud_column
    RTS
.hud_by_cell
    LDA #LO(hud_buffer)
    STA d_ptr
    LDA #HI(hud_buffer)
    STA d_ptr + 1
    JMP cells
ELSE
    LDA screen_start_address_high   \ the 4 cells are 32 bytes in a row unless they can pass
    CMP #&7F                        \ &8000 (page &7F only): then one copy, self-modified
    BEQ by_cell
    STA fast_dst + 2
    LDA screen_start_address_low
    STA fast_dst + 1
    LDA lives                       \ lives_digits + 32 * (lives AND 15)
    ASL A
    ASL A
    ASL A
    ASL A
    ASL A                           \ A = 32 * (lives AND 7), C = lives bit 3
    TAX
    LDA #HI(lives_digits)
    ADC #0                          \ + bit 3 (C = 0 after: HI(lives_digits) < &FF)
    STA fast_src + 2
    TXA
    ADC #LO(lives_digits)
    STA fast_src + 1
    BCC fast_src_same_page
    INC fast_src + 2
.fast_src_same_page
    LDY #31
.fast_row
.fast_src
    LDA lives_digits,Y              \ self-modified: the digit's 32 bytes
.fast_dst
    STA &4000,Y                     \ self-modified: the screen start
    DEY
    BPL fast_row
    RTS
.by_cell                            \ round the 16K screen, a cell at a time
    LDA lives                       \ d_ptr = lives_digits + 32 * (lives AND 15)
    ASL A
    ASL A
    ASL A
    ASL A
    ASL A                           \ A = 32 * (lives AND 7), C = lives bit 3
    TAX
    LDA #HI(lives_digits)
    ADC #0                          \ + bit 3 (C = 0 after: HI(lives_digits) < &FF)
    STA d_ptr + 1
    TXA
    ADC #LO(lives_digits)
    STA d_ptr
    BCC digit_same_page
    INC d_ptr + 1
.digit_same_page
ENDIF
.cells                              \ d_ptr the bytes
    LDA screen_start_address_low
    STA s_ptr
    LDA screen_start_address_high
    STA s_ptr + 1
    LDX #LIVES_ZONE_COLUMNS         \ 4 byte columns of 8 rows (with GAMEPLAY_SHIELD, HUD_COLUMNS)
.column
    LDY #7
.row
    LDA (d_ptr),Y
    STA (s_ptr),Y
    DEY
    BPL row
    LDA d_ptr
    CLC
    ADC #8
    STA d_ptr
    BCC data_same_page
    INC d_ptr + 1
.data_same_page
    LDA s_ptr                       \ the next cell across, round the 16K screen
    CLC
    ADC #8
    STA s_ptr
    BCC screen_same_page
    LDA s_ptr + 1
    INC A                           \ 65C02 opcode
    BPL in_ring
    LDA #&40
.in_ring
    STA s_ptr + 1
.screen_same_page
    DEX
    BNE column
    RTS
}
IF GAMEPLAY_SHIELD = 0              \ (the HUD's renderer copies hud_buffer: src/shield_hi.6502 makes the digit)
INCLUDE "lives_digits.6502"
ENDIF

\ ---- write_column: X = history slot. The original update_screen's loop, from the history:
\ 200 bytes down the column, a character row (8 bytes) at a time, unrolled (layer 3, D) -----
.write_column
{
    LDA hist_edge_lo,X
    STA edge_screen_address_low
    LDA hist_edge_hi,X
    STA edge_screen_address_high
    LDA hist_src_hi,X               \ the slot: the 8 operands' high byte
    CMP src0 + 2                    \ the 8 always hold one value: unchanged, nothing to write
    BEQ same_slot
    STA src0 + 2
    STA src1 + 2
    STA src2 + 2
    STA src3 + 2
    STA src4 + 2
    STA src5 + 2
    STA src6 + 2
    STA src7 + 2
.same_slot
    LDX #&C8                        \ the history's bytes from the top: X - 1 - line
.group
    LDY #0
.src0
    LDA hist0 - 1 - 0,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src1
    LDA hist0 - 1 - 1,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src2
    LDA hist0 - 1 - 2,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src3
    LDA hist0 - 1 - 3,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src4
    LDA hist0 - 1 - 4,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src5
    LDA hist0 - 1 - 5,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src6
    LDA hist0 - 1 - 6,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src7
    LDA hist0 - 1 - 7,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    TXA
    SEC
    SBC #8
    BEQ done
    TAX
    LDA edge_screen_address_low     \ down a character row: &280, round the 16K screen
    ADC #&7F                        \ C = 1 from the SBC (X >= 16 here): + &80
    STA edge_screen_address_low
    LDA edge_screen_address_high
    ADC #&02
    BMI wrap                        \ the hot path falls through
    STA edge_screen_address_high
    BRA group                       \ 65C02 opcode
.wrap
    EOR #&C0                        \ &80-&82 -> &40-&42: - &40
    STA edge_screen_address_high
    BRA group                       \ 65C02 opcode
.done
    RTS
}
.hist_dst_hi                         \ history_push's operands' high byte, by slot
    EQUB HI(hist0 - 8), HI(hist1 - 8)
ASSERT HI(hist0 - 8) = HI(hist0 - 1) AND HI(hist1 - 8) = HI(hist1 - 1) AND LO(hist0) = LO(hist1)
ASSERT HI(column_buffer - 8) = HI(column_buffer - 1)
.hist_src_hi
    EQUB HI(hist0 - 1), HI(hist1 - 1)
ASSERT LO(hist0 - 1) = LO(hist1 - 1)
ASSERT HI(hist0 - 8) = HI(hist0 - 1) AND HI(hist1 - 8) = HI(hist1 - 1)   \ the 8 operands share a high byte

\ ---- the zone ---------------------------------------------------------------------------------
\ add_scroll_zone: X = history slot. A right scroll writes the column at the new right edge and
\ leaves the one at the old left edge (whose memory the new column reuses, a row up); a left
\ scroll the mirror image.
.add_scroll_zone
{
    LDA hist_dir,X
    BMI left
    LDA hist_vr_lo,X                \ right: arriving = new viewport_right
    STA zone_tmp_lo
    LDA hist_vr_hi,X
    STA zone_tmp_hi
    JSR add_zone_column
    LDA hist_vl_lo,X                \ leaving = new viewport_left - 1
    SEC
    SBC #1
    STA zone_tmp_lo
    LDA hist_vl_hi,X
    SBC #0
    STA zone_tmp_hi
    JMP add_zone_column
.left
    LDA hist_vl_lo,X                \ left: arriving = new viewport_left
    STA zone_tmp_lo
    LDA hist_vl_hi,X
    STA zone_tmp_hi
    JSR add_zone_column
    LDA hist_vr_lo,X                \ leaving = new viewport_right + 1
    CLC
    ADC #1
    STA zone_tmp_lo
    LDA hist_vr_hi,X
    ADC #0
    STA zone_tmp_hi
    JMP add_zone_column
}

\ add_lives_zone: A/X = a viewport_left (low/high); the LIVES_ZONE_COLUMNS columns the lives digit
\ covers, as one range kept by its last column (lz_lo/lz_hi): span_in_zone tests it in one go, where
\ it tested each column (about 30 cycles a column, for every mover it classified)
.add_lives_zone
{
    CLC
    ADC #LIVES_ZONE_COLUMNS - 1
    LDY lz_n
    STA lz_lo,Y
    TXA
    ADC #0
    STA lz_hi,Y
    INC lz_n
    RTS
}

.add_zone_column                    \ zone_tmp -> the list; keeps X and Y
{
    PHX
    LDX zone_n
    LDA zone_tmp_lo
    STA zone_lo,X
    LDA zone_tmp_hi
    STA zone_hi,X
    INC zone_n
    PLX
    RTS
}

\ span_in_zone: does [span_x - 1, span_x + A + 1] hold a zone column? C set if so. Keeps Y.
.span_in_zone
{
    CLC
    ADC #2
    STA span_w2
    LDA span_x_lo                   \ span_x -= 1 once (span_x is the caller's, dead after):
    BNE no_borrow                   \ then d = column - span_x
    DEC span_x_hi
.no_borrow
    DEC span_x_lo
    LDX zone_n
    BEQ lives
.each
    DEX
    LDA zone_hi,X                   \ d's high byte less 1 into span_d + 1 ...
    CLC
    SBC span_x_hi
    STA span_d + 1
    LDA zone_lo,X                   \ ... its low byte in A, C clear if it borrowed (ADC #0 below
    SEC                             \ makes span_d + 1 + C the high byte)
    SBC span_x_lo
    STA span_d
    LDA span_d + 1
    ADC #0
    BNE next                        \ outside: negative or too far
    LDA span_w2
    CMP span_d
    BCS hit                         \ d <= width + 2
.next
    TXA
    BNE each
.lives                              \ the lives digit's ranges: [last - (LIVES_ZONE_COLUMNS - 1), last] meets
    LDX lz_n                        \ [span_x - 1, span_x + A + 1] if 0 <= last - (span_x - 1) <=
    BEQ none                        \ A + 2 + LIVES_ZONE_COLUMNS - 1: the test above, the width widened
    LDA span_w2
    CLC
    ADC #LIVES_ZONE_COLUMNS - 1
    STA span_w2
.lz_each
    DEX
    LDA lz_hi,X
    CLC
    SBC span_x_hi
    STA span_d + 1
    LDA lz_lo,X
    SEC
    SBC span_x_lo
    STA span_d
    LDA span_d + 1
    ADC #0
    BNE lz_next
    LDA span_w2
    CMP span_d
    BCS hit
.lz_next
    TXA
    BNE lz_each
.none
    CLC
    RTS
.hit
    SEC
    RTS
}


\ ---- what goes on, and what overlaps it --------------------------------------------------
\ mark_to_draw: need bit 6 for every live slot on screen (the logic's view) that this screen
\ does not show, or is taking off.
.mark_to_draw
{
    LDA render.classify_xh          \ the records' x high for this screen: rec_xh + boff, as classify's operand has it
    STA c1_rec
    LDY act_n                       \ the list from its end (each slot is judged alone, so the order is free)
.each                               \ next's way back in: Y = the entry just done (it stored its index - 1), + 1
    DEY
    BMI done
    LDX act,Y
    LDA viewport_right_low          \ check_if_mover_is_on_screen's right edge, first and inline (a slot that
    CMP movers_x_low,X              \ is off the right changes nothing, shown or not, and most are): right - x,
    LDA viewport_right_high         \ 16 bits
    SBC movers_x_high,X
    BCC each                        \ x > right: not on screen
    LDA need,X
    BMI c1_cand                     \ coming off: goes back on if still there
c1_rec = * + 1
    LDA rec_xh,X                    \ self-modified: rec_xh + boff
    INC A                           \ 65C02 opcode: &FF (not shown) -> 0
    BNE each                        \ shown and staying
.c1_cand                            \ not shown here, or coming off: it may go on
    LDA movers_x_low,X              \ C = 1 from here to the JSR: the right test's
    STA mover_x_low
    LDA movers_x_high,X
    BMI each                        \ no mover in the slot
    PHY                             \ the index: the callee takes Y (the x high) and X (the type)
    TAY
    LDA movers_type_and_colour,X
    AND #&7F
    TAX
    JSR is_left_c1_3d13             \ the left edge, past check_if_mover_is_on_screen's right one: carry set if not
    PLY                             \ (keeps C)
    BCS each
    LDX act,Y                       \ the slot
    DEY                             \ next's index (it takes the INY and each the DEY)
    STY ren_k
    LDA need,X
    ORA #&40
    STA need,X
.next
    LDY ren_k
    INY
    BRA each                        \ 65C02 opcode
.done
    RTS
}

\ close_over_overlaps: a shown mover that overlaps one coming off or going on, drawn before it
\ (decision 37: below it, in the order movers are drawn), comes off and goes back on too, so
\ overlapping movers are always drawn in slot order and taken off in reverse (a mover's save block
\ holds what was under it, earlier movers included; one drawn after it, over it, holds its bytes in
\ its own save, so it can come off and go back on alone). Over a
\ short list of the slots that matter: each one shown or going on, with a rectangle covering
\ where it is shown and where it goes, a column and two rows to spare.
.close_over_overlaps
{
    STZ list_n
    LDY #0
.gather
    CPY act_n
    BEQ gathered
    STY ren_k
    LDX act,Y
    STX ren_i
    TXA                             \ C = 0: CPY act_n found Y < act_n
    ADC boff
    TAY
    LDA rec_xh,Y
    CMP #&FF
    BNE shown
    LDA need,X
    AND #&40
    BNE going_on
    LDY ren_k                       \ not listed: the loop's tail, kept in gather's page
    INY
    BRA gather                      \ 65C02 opcode
.going_on
    JSR list_live                   \ going on, not shown: where it goes
    BRA listed                      \ 65C02 opcode
.shown
    JSR list_recorded               \ where it is shown...
    LDX ren_i
    BIT need,X                      \ 65C02 opcode: V = need bit 6
    BVC listed
    JSR widen_by_live               \ ...and where it goes
.listed
    INC list_n
.not_listed
    LDY ren_k
    INY
    BRA gather                      \ 65C02 opcode
.gathered
.again
    STZ list_changed
    LDX #0
.each_a
    CPX list_n
    BEQ swept
    LDY list_slot,X
    LDA need,Y
    BNE next_a                      \ already coming off or going on
    LDY #0
.each_b
    CPY list_n
    BEQ next_a
    STY list_b
    LDA list_slot,Y
    TAY
    LDA need,Y
    BEQ next_b                      \ staying too: no reason
    TYA                             \ decision 37: only if b is drawn before a (below it). Over a,
    BEQ next_b                      \ b's save holds a's bytes, so b comes off and on alone. The
    CMP list_slot,X                 \ player (slot 0) is drawn last, over everything; the movers
    BCC below                       \ in slot order (C clear: b's slot below a's)
    LDY list_slot,X
    BNE next_b                      \ (a the player: b is below it)
.below
    LDY list_b
    JSR list_overlap                \ X, Y list entries: C set if they overlap
    BCC next_b
    LDY list_slot,X                 \ a overlaps b: a comes off and goes back on
    LDA #&C0
    STA need,Y
    STA list_changed
    BRA next_a                      \ 65C02 opcode
.next_b
    LDY list_b
    INY
    BRA each_b                      \ 65C02 opcode
.next_a
    INX
    BRA each_a                      \ 65C02 opcode
.swept
    LDA list_changed
    BNE again
    RTS
}

\ list entry list_n for slot ren_i: its recorded rectangle (Y = slot + boff)
.list_recorded
{
    TXA                             \ X = ren_i on entry (the one caller)
    LDX list_n
    STA list_slot,X
    LDA rec_type,Y
    AND #&7F
    STA list_type
    LDA rec_wxl,Y                   \ where it was drawn (BUGS #7)
    STA list_x_lo
    LDA rec_wxh,Y
    STA list_x_hi
    LDA rec_wy,Y
    JMP list_finish
}

\ list entry list_n for slot ren_i: its live rectangle
.list_live
{
    LDX list_n
    LDY ren_i
    TYA
    STA list_slot,X
    STY dm_slot                     \ world_of_address's slot (BUGS #10); put_on sets its own
    LDA movers_type_and_colour,Y
    AND #&7F
    STA list_type
    LDA movers_screen_address_low,Y \ where it will be drawn (BUGS #7), in the logic's view
    LDX movers_screen_address_high,Y
    JSR world_of_address
    LDA wa_x_lo
    STA list_x_lo
    LDA wa_x_hi
    STA list_x_hi
    LDX list_n
    LDA wa_y
}
    \ falls through
.list_finish                        \ A = y; list_type, list_x: entry X's rectangle
{
    SEC                             \ y1 = y - 2 (or 0)
    SBC #2
    BCC y_low
    STA list_y1,X
    LDY list_type
    ADC mover_types_height_table,Y  \ C set: y - 2 + height + 1
    BCS y2_top
    ADC #3                          \ y2 = y + height + 2 (or &FF)
    BCC y2_ok
    BCS y2_top                      \ always
.y_low                              \ y < 2: A = y - 2 + 256, C clear
    ADC #2                          \ A = y, C set
    STZ list_y1,X                   \ 65C02 opcode
    LDY list_type
    ADC mover_types_height_table,Y  \ y + height + 1
    BCS y2_top
    INC A                           \ 65C02 opcode
    BNE y2_ok                       \ wrapped to 0: y + height + 2 = 256
.y2_top
    LDA #&FF
    CLC
.y2_ok
    STA list_y2,X                   \ C clear on every path
    LDA list_x_lo                   \ x1 = x - 1
    SBC #0                          \ (C clear: the - 1)
    STA list_x1_lo,X
    LDA list_x_hi
    SBC #0
    STA list_x1_hi,X
    LDA list_x_lo                   \ x2 = x + width + 1
    SEC                             \ (the +1)
    ADC mover_types_width_table,Y
    STA list_x2_lo,X
    LDA list_x_hi
    ADC #0
    STA list_x2_hi,X
    RTS
}

\ widen entry list_n (slot ren_i, recorded) to cover its live rectangle as well
.widen_by_live
{
    LDA list_n
    PHA
    LDA #MOVER_SLOTS                \ build the live one in the spare entry...
    STA list_n
    JSR list_live
    PLX
    STX list_n                      \ ...and take the union
    LDY #MOVER_SLOTS
    LDA list_x1_lo,Y
    CMP list_x1_lo,X
    LDA list_x1_hi,Y
    SBC list_x1_hi,X
    BCS x1_kept
    LDA list_x1_lo,Y
    STA list_x1_lo,X
    LDA list_x1_hi,Y
    STA list_x1_hi,X
.x1_kept
    LDA list_x2_lo,X
    CMP list_x2_lo,Y
    LDA list_x2_hi,X
    SBC list_x2_hi,Y
    BCS x2_kept
    LDA list_x2_lo,Y
    STA list_x2_lo,X
    LDA list_x2_hi,Y
    STA list_x2_hi,X
.x2_kept
    LDA list_y1 + MOVER_SLOTS       \ Y = MOVER_SLOTS: absolute, as ,Y crosses a page
    CMP list_y1,X
    BCS y1_kept
    STA list_y1,X
.y1_kept
    LDA list_y2,Y
    CMP list_y2,X
    BCC y2_kept
    STA list_y2,X
.y2_kept
    RTS
}

\ list_overlap: entries X and Y. C set if each starts no later than the other ends, in x
\ (16 bits) and in y.
.list_overlap
{
    LDA list_x2_lo,Y                \ x1 of X <= x2 of Y
    CMP list_x1_lo,X
    LDA list_x2_hi,Y
    SBC list_x1_hi,X
    BCC no
    LDA list_x2_lo,X                \ x1 of Y <= x2 of X
    CMP list_x1_lo,Y
    LDA list_x2_hi,X
    SBC list_x1_hi,Y
    BCC no
    LDA list_y2,Y                   \ y1 of X <= y2 of Y
    CMP list_y1,X
    BCC no
    LDA list_y2,X                   \ y1 of Y <= y2 of X
    CMP list_y1,Y
    RTS                             \ C as it stands
.no
    CLC
    RTS
}

\ ---- take off and put on -------------------------------------------------------------------
\ take_off: X = slot. If it comes off and is shown here, put its save block back.
.take_off
{
    LDA need,X
    BPL out
    TXA
    ORA boff                        \ slot + boff: slot < &40, boff 0 or 64
    TAY
    LDA rec_xh,Y
    INC A                           \ 65C02 opcode: &FF, none recorded?
    BEQ out
IF SKY_MODE
    JSR sky_take_off                \ C set: a helicopter in sky mode, erased or left (keeps Y)
    LDA #0
    BCS sky_off
ENDIF
    JSR restore_block               \ returns Y = rb_index, A = 0
.sky_off
    DEC A                           \ 65C02 opcode: &FF
    STA rec_xh,Y
.out
    RTS
}

\ put_on: X = slot. If it goes on, draw it masked, saving what it covers, and record it.
.put_on
{
    BIT need,X                      \ 65C02 opcode: V = bit 6, going on
    BVS going_on
    RTS
.going_on
    STX dm_slot
    TXA
    ORA boff                        \ slot + boff: slot < &40, boff 0 or 64
    STA dm_index
    LDX back                        \ room for its block, or make some: arena_top + MAX_BLOCK
IF SKY_MODE
    JSR sky_room                    \ below helicopter 1's image (src/sky_main.6502; C set: none)
    BCS masked
    JSR sky_put_on                  \ C set: a helicopter drawn in sky mode (src/sky.6502), no
    BCC masked                      \ block (the room above arena_top its rotor's scratch)
    LDY dm_index
    LDA #0
    STA save_start_hi,Y
    LDX dm_slot
    JMP record_live                 \ X = slot, Y = slot + boff
.masked
    LDX back
ELSE
    LDA arena_top_lo,X              \ below the arena's end (the kind cache's slot 0 after it:
    CMP kc_arena_lim                \ src/kindcache.6502), as one 16-bit compare
    LDA arena_top_hi,X
    SBC kc_arena_lim + 1
    BCC room                        \ X = back
    JSR compact
    LDX back
    LDY #0
    JSR kc_room                     \ still none: slot 0 gives its room back (kc_arena_full), the
    BCC room                        \ arena up to save_arena_end, as before decision 36
    JSR kc_arena_full
    LDX back
ENDIF
.room
    LDY dm_index
    LDA arena_top_lo,X              \ the block starts at the arena's top: its header there,
    STA save_start_lo,Y             \ where parts 2 and 3 start (0: none)
    STA mark_part.header_lo
    SEC                             \ v_ptr = the start - 4: the first column's record goes at
    SBC #4                          \ v_ptr + 8, after the header (draw_column)
    STA v_ptr
    LDA arena_top_hi,X
    STA save_start_hi,Y
    STA mark_part.header_lo + 1
    SBC #0
    STA v_ptr + 1
    LDA v_ptr                       \ mark_part's base: the start - 8 (C = 1: the high byte did not borrow)
    SBC #4
    STA mark_part.base_lo
    LDA v_ptr + 1
    SBC #0
    STA mark_part.base_hi
    LDA arena_top_lo,X
    ADC #0                          \ C = 1 (no borrow above): the start + 1
    STA mark_part.header_hi
    LDA arena_top_hi,X
    ADC #0
    STA mark_part.header_hi + 1
    LDA #0
    LDY #7                          \ the header, at v_ptr + 4 to + 7
    STA (v_ptr),Y
    DEY
    STA (v_ptr),Y
    DEY
    STA (v_ptr),Y
    DEY
    STA (v_ptr),Y
    JSR draw_mover                  \ (draw_column moves v_ptr on)
    LDX back                        \ the block ends after the last cell: v_ptr + 8
    LDY dm_index
    LDA v_ptr
    CLC
    ADC #8
    STA arena_top_lo,X
    STA save_end_lo,Y
    LDA v_ptr + 1
    ADC #0
    STA arena_top_hi,X
    STA save_end_hi,Y
    LDX dm_slot
    JMP record_live                 \ X = slot, Y = slot + boff (its RTS returns from put_on)
}

\ mark_part2, mark_part3: the part about to be drawn starts at v_ptr + 8 (its first record),
\ as an offset from the block's start (base = the start - 8), into the block's header (put_on
\ set the operands). Keeps A and Y; X = 0 or 2 (both callers go straight on to
\ ren_draw_sprite, which sets X from A before reading it).
.mark_part3
    LDX #2
    BRA mark_part                   \ 65C02 opcode
.mark_part2
    LDX #0
.mark_part
{
    PHA
    LDA v_ptr
    SEC
base_lo = * + 1
    SBC #0                          \ self-modified: the block's start - 8
header_lo = * + 1
    STA &FFFF,X                     \ self-modified: the header
    LDA v_ptr + 1
base_hi = * + 1
    SBC #0
header_hi = * + 1
    STA &FFFF,X
    PLA
    RTS
}

\ ---- drawing a mover ----------------------------------------------------------------------
\ draw_mover: slot dm_slot, its sprites as plot_mover chooses them (one, two or three parts,
\ the second raised by sprites_y_offset and the third eight rows above that), clipped to the
\ viewport as the plotter clips (viewport_left to viewport_right inclusive), through the mask
\ and pixel tables for its colour and flip. Saves what it covers into the screen's arena.
.draw_mover
{
IF SKY_MODE
    JSR dm_setup                    \ the clip and the tables (sky_put_on's too): C set, nothing
    BCS no_parts                    \ to draw
    JMP parts_go
.no_parts
    RTS
.dm_setup
ENDIF
    LDX dm_slot
    LDA movers_type_and_colour,X
    STA dm_typecol
    AND #&7F
    STA dm_type
    LDA movers_frame_and_flip,X
    STA dm_flip                     \ bit 7
    AND #&3F
    STA dm_frame
    LDA movers_screen_address_low,X
    STA dm_scr_lo
    LDA movers_screen_address_high,X
    STA dm_scr_hi
    \ the visible columns, j from 0 at the mover's left: jmin = viewport_left - x if the mover
    \ starts left of it, else 0; jmax = viewport_right - x (255 if further)
    LDA viewport_left_low
    SEC
    SBC movers_x_low,X
    LDA viewport_left_high          \ (the low byte only for its borrow: left_of_view redoes it)
    SBC movers_x_high,X
    BCS left_of_view                \ viewport_left >= x
    STZ dm_jmin                     \ 65C02 opcode
.jmin_done
    LDA viewport_right_low
    SEC
    SBC movers_x_low,X
    STA dm_jmax
    LDA viewport_right_high
    SBC movers_x_high,X
    BCS not_right_of_view
IF SKY_MODE
    SEC
ENDIF
    RTS                             \ the mover starts right of the viewport
.left_of_view
    BEQ jmin_low                    \ high 0: the low byte is it
    LDA #&FF
    BRA jmin_store                  \ 65C02 opcode
.jmin_low
    LDA viewport_left_low           \ C set (BCS): the low byte again
    SBC movers_x_low,X
.jmin_store
    STA dm_jmin
    BRA jmin_done                   \ 65C02 opcode
.not_right_of_view
    BEQ jmax_done
    LDA #&FF
    STA dm_jmax
.jmax_done
    \ the tables: pixels by colour and flip, masks by flip (plot_mover and
    \ get_mover_type_and_colour's rules: most enemies white)
    LDY #HI(unflipped_green_pixel_table)
    LDA dm_typecol
    BPL green
    CMP #&85                        \ MOVER_TYPE_ENEMY | MOVER_TYPE_HELICOPTER_WITH_MISSILE
    BEQ green
    CMP #&95                        \ MOVER_TYPE_ENEMY | MOVER_TYPE_HEAVY_GUN and above
    BCS green
    CMP #&87                        \ MOVER_TYPE_ENEMY | MOVER_TYPE_HELICOPTER_WITH_SOLDIER
    BEQ green
    INY                             \ white: the next page
.green
    STY draw_column.pix_operand + 1
    STY draw_column.pix_operand_2 + 1
    BIT dm_flip
    BMI flipped
    LDA #LO(unflipped_green_pixel_table)
    STA draw_column.pix_operand
    STA draw_column.pix_operand_2
    LDA #LO(unflipped_mask_table)
    STA draw_column.mask_operand
    STA draw_column.mask_operand_2
    LDA #HI(unflipped_mask_table)
    STA draw_column.mask_operand + 1
    STA draw_column.mask_operand_2 + 1
    BRA parts                       \ 65C02 opcode
.flipped
    LDA #LO(flipped_green_pixel_table)
    STA draw_column.pix_operand
    STA draw_column.pix_operand_2
    LDA #LO(flipped_mask_table)
    STA draw_column.mask_operand
    STA draw_column.mask_operand_2
    LDA #HI(flipped_mask_table)
    STA draw_column.mask_operand + 1
    STA draw_column.mask_operand_2 + 1
.parts
IF SKY_MODE
    CLC
    RTS
.parts_go
ENDIF
    LDX dm_type                     \ part one: the animation's sprite, at the bottom
    LDA dm_frame
    CLC
    ADC mover_types_first_sprite_animation_offsets,X
    TAY
    LDA animation_table,Y
    LDY #0
    JSR ren_draw_sprite
    LDX dm_type
    LDA mover_types_parts,X
    CMP #&02
    BCS nothing                     \ one part
    LDA dm_frame                    \ part two: raised by sprites_y_offset
    ADC mover_types_second_sprite_offset,X    \ (C clear)
    TAY
    LDA sprites_y_offset,Y
    STA dm_raise
    TAY                             \ Y = the raise, for mark_part2 and ren_draw_sprite
    LDA dm_frame                    \ (C still clear: frame <= &3F plus an offset <= &1E)
    ADC mover_types_first_sprite_animation_offsets + &1C,X    \ the second parts' mover types
    TAX
    LDA animation_table,X
    JSR mark_part2
    JSR ren_draw_sprite
    LDX dm_type
    LDA mover_types_parts,X
    BEQ part_three                  \ three parts
.nothing
    RTS                             \ one part or two
.part_three
    LDA dm_raise                    \ part three: eight rows above part two
    CLC
    ADC #&08
    TAY
    LDA mover_types_third_sprite,X
    JSR mark_part3
}
    \ falls through: ren_draw_sprite draws part three and returns to draw_mover's caller

\ ren_draw_sprite: A = sprite, Y = rows it is raised. Each visible column of its straight data:
\ the first row drawn and the count, then the indices top-down. Flipped, column c of n is
\ drawn at j = n - 1 - c, as the plotter walks a flipped sprite's columns backwards. The
\ column's bottom steps 8 bytes a column (back 8 when flipped), round the 16K screen; its line
\ in the character cell is the same for every column of the part (ds_line), so draw_column
\ keeps the bottom's cell (b_ptr) and raises from there.
.ren_draw_sprite
{
    TAX
    STX ds_sprite
IF SKY_MODE = 0
    STY kc_raise                    \ (src/kindcache.6502: only a mover's first part, not raised)
ENDIF
    LDA straight_sprite_hi,X
    BNE known
    RTS                             \ an unused table entry
.known
    STA col_ptr + 1
    LDA straight_sprite_lo,X
    STA col_ptr
    LDA sprite_column_count,X
    STA ds_c                        \ columns left
    STA ds_n
    STZ ds_clip                     \ 65C02 opcode: whether any column can be clipped: not if
    LDX dm_jmin                     \ jmin is 0 and jmax n - 1 or more (X: the sprite, done with)
    BNE clips
    CMP dm_jmax                     \ A = n: no clip if n <= jmax
    BCC no_clip
    BEQ no_clip
.clips
    DEC ds_clip                     \ &FF
.no_clip
    LDA dm_scr_lo                   \ the part's bottom, raised once
    LDX dm_scr_hi                   \ Y: still the rows it is raised
    JSR raise_address
    STA b_ptr                       \ the cell (its line cleared below)
    AND #&07
    STA ds_line
    TRB b_ptr                       \ 65C02 opcode: b_ptr AND &F8
    STX b_ptr + 1
    LDA ds_clip                     \ step 2 layer 4: a part that cannot be clipped may be one of
    BNE generic                     \ the player's kinds compiled to code (tools/compiled.py), or
    LDA dm_slot                     \ a big part's kind built at run time (src/kindcache.6502,
IF SKY_MODE
    BNE generic
    JSR compiled_part
    BCS generic
ELSE
    BNE cached                      \ decision 36)
    JSR compiled_part
    BCC drawn                       \ (carry set: not a kind, or a row that would pass &7FFF)
.cached
    LDA ds_n
    CMP #KC_COLUMNS
    BNE generic
    JSR kc_part
    BCS generic                     \ not held (now asked for), or a row would pass &7FFF
ENDIF
.drawn
    RTS
.generic
    BIT dm_flip
    BPL draw_column.each
    LDA ds_c                        \ flipped: the bottom 8 * (n - 1) on
    DEC A                           \ 65C02 opcode
    ASL A
    ASL A
    ASL A
    CLC
    ADC b_ptr
    STA b_ptr
    BCC draw_column.each            \ the same page
    LDA b_ptr + 1
    INC A                           \ 65C02 opcode
    BPL flipped_in_ring
    LDA #&40                        \ &80: round the 16K screen
.flipped_in_ring
    STA b_ptr + 1
}
    \ falls through
\ draw_column: the part's columns from col_ptr, ds_c of them, each from its bottom's cell
\ b_ptr raised by its first row. Y = the line in the character cell indexes the screen (s_ptr =
\ the cell), the data and the save block together; each cell has 8 bytes of the save block (the
\ lines it does not draw are left unused), so moving up a cell is the data 8 back, the save
\ block 8 on and the screen a character row (&280) up. Saves each screen byte, then writes
\ (byte AND mask) EOR pixel, as the plotter does with the player. Each column's record (count
\ - 1, the lowest byte's address) goes 8 bytes after the last cell before it (v_ptr + 8: v_ptr
\ is that cell's base), its cells after the record; restore_block walks them the same way.
.draw_column
{
    BRA each                        \ 65C02 opcode
.empty
    LDA col_ptr                     \ an empty column: 2 bytes
    CLC
    ADC #2
    STA col_ptr
    BCS empty_hi                    \ the page crossed (rare)
.to_next
    JMP next
.empty_hi
    INC col_ptr + 1
    BRA to_next                     \ 65C02 opcode
.unflipped_j                        \ (after JMP next: reached only from clip_test)
    LDA ds_n
    SEC
    SBC ds_c
    BRA have_j                      \ 65C02 opcode
.clip_test                          \ j = n - c unflipped, c - 1 flipped (c = columns left)
    BIT dm_flip
    BPL unflipped_j
    LDA ds_c
    DEC A                           \ 65C02 opcode
.have_j
    CMP dm_jmin
    BCC to_next                     \ left of the viewport
    CMP dm_jmax
    BCC visible                     \ not right of it: j < jmax...
    BEQ visible                     \ ...or j = jmax
    JMP next
.each
    LDY #1
    LDA (col_ptr),Y                 \ the count
    BEQ empty
    DEC A                           \ 65C02 opcode: count - 1, the record's and the cell loop's
    STA rows_m1
    LDY #8
    STA (v_ptr),Y                   \ the record: count - 1 (then the address)
    LDA ds_line                     \ the lowest byte's line: the part's line - the first row
    SEC                             \ drawn (below 0: a cell up for each 8)
    SBC (col_ptr)                   \ 65C02 opcode
    TAX
    LDA rows_m1                     \ col_ptr on to the next column: 2 + count bytes (the data
    SEC                             \ is found back from there)
    ADC #2
    ADC col_ptr
    STA col_ptr
    BCC on_same_page
    INC col_ptr + 1
.on_same_page
    BIT ds_clip
    BMI clip_test
.visible
    LDA b_ptr                       \ the cell of the column's bottom...
    STA s_ptr
    LDA b_ptr + 1
    STA s_ptr + 1
    TXA                             \ ...raised by its first row
    BPL raised
.up_cell                            \ X = the line, negative: a cell up for each 8
    LDA s_ptr
    SEC
    SBC #&80
    STA s_ptr
    LDA s_ptr + 1
    SBC #&02
    CMP #&40
    BCS up_in_ring
    ADC #&40
.up_in_ring
    STA s_ptr + 1
    TXA
    CLC
    ADC #8
    TAX
    BCC up_cell
.raised                             \ A = X = the line of the lowest byte drawn
    ORA s_ptr                       \ the record's address
    LDY #9
    STA (v_ptr),Y
    INY
    LDA s_ptr + 1
    STA (v_ptr),Y
    LDA v_ptr                       \ the cells after it
    CLC
    ADC #11
    STA v_ptr
    BCC save_on_page                \ C = 0 on the common path
    INC v_ptr + 1
    CLC                             \ (the page-crossing path: C was 1)
.save_on_page                       \ C = 0 here (TXA, TAY, EOR leave it)
    \ the data: the byte for line Y of the first cell is data[count - 1 - (line - Y)], so
    \ d_ptr = the column + 2 + count - 1 - line = col_ptr - 1 - line = col_ptr + (line EOR &FF) - &100
    TXA
    TAY                             \ Y = the line
    EOR #&FF
    ADC col_ptr
    STA d_ptr
    LDA col_ptr + 1
    ADC #&FF
    STA d_ptr + 1
.cell                               \ Y = the line it starts on: does the column end in this cell?
    TYA
    SEC
    SBC rows_m1                     \ line - (rows left - 1)
    BCS last_cell                   \ 0 or more: it ends here
    EOR #&FF                        \ no: rows left after this cell, less 1: rows - line - 2
    STA rows_m1
.byte                               \ down to line 0
    LDA (d_ptr),Y                   \ the pixel/mask index
    TAX
    LDA (s_ptr),Y
    STA (v_ptr),Y                   \ saved
mask_operand = * + 1
    AND &FFFF,X                     \ self-modified: the mask table for the flip
pix_operand = * + 1
    EOR &FFFF,X                     \ self-modified: the pixel table for the colour and flip
    STA (s_ptr),Y
    DEY
    BPL byte
    LDA d_ptr                       \ the next cell: the data 8 back (C = 0 from the cell test:
    SBC #7                          \ the byte loop leaves C alone, so 7 + 1)...
    STA d_ptr
    BCS data_same_page
    DEC d_ptr + 1
    SEC                             \ C = 1 on both paths
.data_same_page
    LDA v_ptr                       \ ...the save block 8 on (C = 1: 7 + 1)...
    ADC #7
    STA v_ptr
    BCC save_same_page
    INC v_ptr + 1
    CLC                             \ C = 0 on both paths
.save_same_page
    LDA s_ptr                       \ ...the screen a character row up (C = 0: &7F + 1)...
    SBC #&7F
    STA s_ptr
    LDA s_ptr + 1
    SBC #&02
    ORA #&40                        \ ...round the 16K: &3D-&3F (below the ring) -> &7D-&7F
    STA s_ptr + 1
    LDY #7                          \ ...from its bottom line: the cell test inline (C = 1, as
    TYA                             \ the ring's high byte is 3 or more)
    SBC rows_m1                     \ line - (rows left - 1)
    BCS last_cell                   \ 0 or more: it ends here
    EOR #&FF                        \ no: rows left after this cell, less 1
    STA rows_m1
    BRA byte                        \ 65C02 opcode (C = 0, as the byte loop needs)
.last_cell                          \ A = line - rows left + 1: the last line drawn
    DEC A                           \ 65C02 opcode: the line below it
    STA stop_y
.part_byte
    LDA (d_ptr),Y
    TAX
    LDA (s_ptr),Y
    STA (v_ptr),Y
mask_operand_2 = * + 1
    AND &FFFF,X                     \ self-modified, as mask_operand
pix_operand_2 = * + 1
    EOR &FFFF,X                     \ self-modified, as pix_operand
    STA (s_ptr),Y
    DEY
    CPY stop_y
    BNE part_byte
.next_c                             \ C = 1: the loop's CPY found Y = stop_y, or .next set it
    DEC ds_c
    BEQ done
    BIT dm_flip                     \ the next column's bottom
    BPL step_forward
    LDA b_ptr                       \ flipped: back 8 (C = 1)
    SBC #8
    STA b_ptr
    BCC step_back_hi
    JMP each
.next                               \ v_ptr: this column's last cell (the next record 8 on)
    SEC                             \ (from empty and clip_test: carry either way)
    BRA next_c                      \ 65C02 opcode
.step_forward
    LDA b_ptr                       \ on 8 (C = 1)
    ADC #7
    STA b_ptr
    BCS forward_hi
    JMP each
.forward_hi
    LDA b_ptr + 1
    INC A                           \ 65C02 opcode
    BPL forward_in_ring
    LDA #&40
.forward_in_ring
    STA b_ptr + 1
    BRA to_each                     \ 65C02 opcode
.step_back_hi
    LDA b_ptr + 1
    DEC A                           \ 65C02 opcode
    CMP #&40
    BCS back_in_ring
    LDA #&7F
.back_in_ring
    STA b_ptr + 1
.to_each
    JMP each
.done
    RTS
}

.compiled_direct                    \ a kind in HAZEL: no bank to page
    JMP (compiled_vec)
.compiled_none                      \ compiled_part: not a kind (carry set)
    SEC
    RTS

\ compiled_part: the player's part (not clipped) as code, if its sprite, flip and line are one of
\ tools/compiled.py's kinds: the kind's code in its bank (through compiled_call), from the
\ part's bottom left cell (b_ptr), and an entry in the save block for restore_block: 11 bytes
\ as a column's record and cell, with count - 1 = &FF and the kind, then that cell's address.
\ Carry clear if drawn; set if not a kind, or if a row would run past &7FFF (nothing drawn: b_ptr
\ and ds_c are as the generic path wants them).
.compiled_part
{
    LDA dm_flip                     \ the kind from ck_index: sprite << 4 | flip << 3 | line,
    ASL A                           \ as (sprite << 1 | flip) << 3 | line: C = the flip (bit 7)
    LDA ds_sprite
    ROL A                           \ sprite << 1 | flip (every sprite is below &80)
    CMP #CK_SPRITES * 2
    BCS compiled_none
    ASL A                           \ C = 0 from here
    ASL A
    ASL A
    ORA ds_line
    TAY
    LDX ck_index,Y
    BMI compiled_none               \ &FF: not a kind
    STX ck_kind
    LDA b_ptr
    STA &C0
    LDA b_ptr + 1
    STA &C1
    LDA ck_draw_lo,X
    STA compiled_vec
    LDA ck_draw_hi,X
    STA compiled_vec + 1
    LDA ck_bank,X
    BEQ in_hazel                    \ bank 0: HAZEL, paged in through play
    LDX #&84                        \ ANDY and bank 4 again after
    JSR compiled_call
    BCS unsafe                      \ the banked kinds (the commoner) fall through
.called                             \ carry clear here from either path
    LDY #8                          \ its entry
    LDA #&FF
    STA (v_ptr),Y
    INY
    LDA ck_kind
    STA (v_ptr),Y
    LDA v_ptr                       \ carry still clear
    ADC #11
    STA v_ptr
    BCC on_page
    INC v_ptr + 1
    CLC                             \ carry clear to return
.on_page
    LDA &C0
    STA (v_ptr)                     \ 65C02 opcode
    LDY #1
    LDA &C1
    STA (v_ptr),Y
    RTS                             \ carry clear: drawn
.in_hazel
    JSR compiled_direct
    BCC called
.unsafe                             \ the code's row pointers used b_ptr and ds_c
    LDA &C0
    STA b_ptr
    LDA &C1
    STA b_ptr + 1
    LDA ds_n
    STA ds_c
    SEC
    RTS
}

\ up_a_cell: AX = a character cell's top line; returns AX = the bottom line of the cell above
\ (&279 lower, round the 16K screen), as the plotter moves up a group.
.up_a_cell
{
    SEC
    SBC #&79
    PHA
    TXA
    SBC #&02
    CMP #&40
    BCS in_ring
    ADC #&40
.in_ring
    TAX
    PLA
    RTS
}

\ raise_address: AX up Y rows (Y may be 0). A row up is one byte lower inside a cell; from a
\ cell's top line it is the cell above's bottom line.
.raise_address
{
    STA lo_imm                      \ RAM for cycles 4: in one step, not a cell at a time
    STY rows_imm                    \ self-modified: lo and rows into the operands below
    AND #&07                        \ the line in the cell
rows_imm = * + 1
    CMP #&00                        \ self-modified: rows
    BCC up
lo_imm = * + 1
    LDA #&00                        \ self-modified: lo. It stays in the cell (C = 1)
    SBC rows_imm
    RTS                             \ X is still hi
.up                                 \ d = rows - line - 1: 0 is the cell above's bottom line
    STX ra_hi
    EOR #&FF                        \ C = 0 from the BCC
    ADC rows_imm
    TAY
    EOR lo_imm                      \ lo AND &F8, OR the line it ends on: 7 - (d AND 7)
    AND #&07
    EOR #&07
    EOR lo_imm
    STA ra_lo
    TYA
    LSR A
    LSR A
    LSR A
    TAY                             \ cells up, less 1
    LDA ra_lo
    SEC
    SBC raise_cells_lo,Y
    STA ra_lo
    LDA ra_hi
    SBC raise_cells_hi,Y
    CMP #&40                        \ round the 16K screen
    BCS in_ring
    ADC #&40
.in_ring
    TAX
    LDA ra_lo
    RTS
}
.raise_cells_lo                     \ (n + 1) character rows: (n + 1) * &280
    EQUB &80, &00, &80, &00, &80, &00, &80, &00
.raise_cells_hi
    EQUB &02, &05, &07, &0A, &0C, &0F, &11, &14

\ ---- taking a mover off ------------------------------------------------------------------
\ restore_block: Y = slot + boff. Its save block, a part at a time from the last (parts of one
\ mover can overlap, so the bytes the later part saved go back first); within a part, its columns
\ in any order (they never overlap): each record (count - 1, address) and the cells after it, put
\ back on the screen as draw_column took them, walked as draw_column wrote them (v_ptr the last
\ cell before, the record at v_ptr + 8). Frees the block, popping the arena if it was the last.
.restore_block
{
    STY rb_index
    LDA save_end_lo,Y               \ the walk ends when v_ptr + 8 is the block's end
    SEC
    SBC #8
    STA rb_end
    LDA save_end_hi,Y
    SBC #0
    STA rb_end + 1
    LDA save_start_lo,Y             \ the header: where parts 2 and 3 start
    STA v_ptr
    LDA save_start_hi,Y
    STA v_ptr + 1
    LDY #3                          \ the four bytes, unrolled
    LDA (v_ptr),Y
    STA rb_part2 + 3
    DEY
    LDA (v_ptr),Y
    STA rb_part2 + 2
    DEY
    LDA (v_ptr),Y
    STA rb_part2 + 1
    LDA (v_ptr)                     \ 65C02 opcode
    STA rb_part2
    LDX #2                          \ part 3, then part 2: from its start to rb_end
.each_part
    LDA rb_part2,X
    ORA rb_part2 + 1,X
    BEQ no_part
    LDY rb_index                    \ v_ptr = its start - 8
    LDA save_start_lo,Y
    CLC
    ADC rb_part2,X
    STA v_ptr                       \ v_ptr is dead here: set to the result below
    LDA save_start_hi,Y
    ADC rb_part2 + 1,X
    STA rb_p8 + 1
    LDA v_ptr
    SEC
    SBC #8
    STA v_ptr
    PHA                             \ the part's start - 8 kept on the stack, not in rb_p8
    LDA rb_p8 + 1
    SBC #0
    STA v_ptr + 1
    PHA
    PHX
    JSR columns
    PLX
    PLA                             \ the part before ends where this one starts
    STA rb_end + 1
    PLA
    STA rb_end
.no_part
    DEX
    DEX
    BPL each_part
    LDY rb_index                    \ part 1: after the header, v_ptr = the start + 4 - 8
    LDA save_start_lo,Y
    SEC
    SBC #4
    STA v_ptr
    LDA save_start_hi,Y
    SBC #0
    STA v_ptr + 1
    JSR columns
    LDY rb_index
    JMP blocks_done
.columns                            \ the columns from v_ptr + 8 to rb_end + 8
    LDA v_ptr
    CMP rb_end
    BNE more
    LDA v_ptr + 1
    CMP rb_end + 1
    BNE more
    RTS
.cells_next_page                    \ v_ptr + 11 crossed a page (rare): off the hot path
    INC v_ptr + 1
    BRA cells_on_page               \ 65C02 opcode
.more
    LDY #10                         \ the record
    LDA (v_ptr),Y
    STA s_ptr + 1
    DEY
    LDA (v_ptr),Y
    TAX                             \ the address's low byte
    DEY
    LDA (v_ptr),Y
    BMI compiled                    \ &FF: a compiled part (ren_draw_sprite), X = its kind
    STA rows_m1                     \ count - 1
    LDA v_ptr                       \ the cells after it
    CLC
    ADC #11
    STA v_ptr
    BCS cells_next_page             \ the hot path falls through
.cells_on_page
    TXA
    AND #&F8
    STA s_ptr
    TXA
    AND #&07
    TAY
.cell                               \ as draw_column: does the column end in this cell?
    TYA
    SEC
    SBC rows_m1
    BCS last_cell
    EOR #&FF
    STA rows_m1
.byte
    LDA (v_ptr),Y
    STA (s_ptr),Y
    DEY
    BPL byte
    LDA s_ptr                       \ the next cell: the screen a character row up (C = 0 from
    SBC #&7F                        \ cell's SBC: this takes &80)...
    STA s_ptr
    LDA s_ptr + 1
    SBC #&02                        \ (high &40-&7F: no borrow, C = 1 after)
    AND #&3F                        \ ...round the 16K (&3D-&7D to &40-&7F)
    ORA #&40
    STA s_ptr + 1
    LDA v_ptr                       \ ...the save block 8 on (C = 1: ADC #7 adds 8)
    ADC #7
    STA v_ptr
    LDY #7
    BCC cell
    INC v_ptr + 1
    BRA cell                        \ 65C02 opcode
.last_cell                          \ rows_m1 = Y - the last line: rows_m1 + 1 bytes to put back
    LDX rows_m1                     \ (X is free in columns: .more reloads it)
.part_byte
    LDA (v_ptr),Y
    STA (s_ptr),Y
    DEY
    DEX
    BPL part_byte
    JMP columns
.compiled                           \ its entry: the kind, then the part's bottom left cell
IF SKY_MODE = 0
    CMP #KC_MARK                    \ (or a cached part's: src/kindcache.6502)
    BEQ cached
ENDIF
    LDA v_ptr
    CLC
    ADC #11
    STA v_ptr
    BCC kind_on_page
    INC v_ptr + 1
.kind_on_page
    LDA (v_ptr)                     \ 65C02 opcode
    STA &C0
    LDY #1
    LDA (v_ptr),Y
    STA &C1
    LDA ck_bank,X
    BEQ in_hazel                    \ bank 0: HAZEL
    LDY ck_restore_lo,X             \ Y, not A: A is the bank
    STY compiled_vec
    LDY ck_restore_hi,X
    STY compiled_vec + 1
    LDX #&04                        \ bank 4 again after
    JSR compiled_call
    JMP columns
.in_hazel                           \ straight into the kind: no JMP (compiled_vec)
    LDA ck_restore_lo,X
    STA hazel_restore + 1
    LDA ck_restore_hi,X
    STA hazel_restore + 2
.hazel_restore
    JSR hazel_restore               \ self-modified: the kind's restore
    JMP columns
IF SKY_MODE = 0
.cached                             \ X = the slot
    JSR kc_restore
    JMP columns
ENDIF
.blocks_done
    LDX back                        \ the block is free; the arena shrinks if it was the last
    LDA save_end_lo,Y
    CMP arena_top_lo,X
    BNE freed
    LDA save_end_hi,Y
    CMP arena_top_hi,X
    BNE freed
    LDA save_start_lo,Y
    STA arena_top_lo,X
    LDA save_start_hi,Y
    STA arena_top_hi,X
.freed
    LDA #0
    STA save_start_hi,Y
    RTS
}

\ compact: slide this screen's live save blocks down to the start of its arena, in address
\ order, and point arena_top after them. Blocks are only bytes, so they move freely. Each is
\ moved once (a mover drawn wholly clipped has an empty block, which can share its start
\ with the next). Layer 4 (late frames): the live blocks are listed once, sorted by start by
\ insertion (cp_list), not found by a scan of every slot for each block; and a block already
\ at the cursor (the arena's bottom ones, usually) is not copied onto itself.
.compact
{
    STZ cp_n                        \ 65C02 opcode: the list, empty
    LDA boff                        \ Y = slot + boff, over this screen's slots
    TAY
    CLC
    ADC #MOVER_SLOTS
    STA cp_stop
.gather
    LDA save_start_hi,Y
    BEQ gathered                    \ no block
    STY cp_y
    LDA save_start_lo,Y             \ its start
    STA cp_start_lo
    LDA save_start_hi,Y
    STA cp_start_hi
    LDX cp_n                        \ insertion: the entries starting after it move up one
.shift
    BEQ place                       \ X = 0: the front
    LDY cp_list - 1,X
    LDA cp_start_lo                 \ its start - the entry's: no borrow, it goes after the entry
    CMP save_start_lo,Y
    LDA cp_start_hi
    SBC save_start_hi,Y
    BCS place
    TYA
    STA cp_list,X
    DEX
    BRA shift                       \ 65C02 opcode
.place
    LDA cp_y
    STA cp_list,X
    INC cp_n
    TAY
.gathered
    INY
    CPY cp_stop
    BNE gather
    LDA #LO(save_arena)
    STA cp_cursor_lo
    LDA #HI(save_arena)
    STA cp_cursor_hi
    LDX #0
    STX cp_y                        \ cp_y now: the list's place
    BRA next_block                  \ 65C02 opcode
.all_moved
    LDX back
    LDA cp_cursor_lo
    STA arena_top_lo,X
    LDA cp_cursor_hi
    STA arena_top_hi,X
    RTS
.next_block
    LDX cp_y
    CPX cp_n
    BEQ all_moved
    INC cp_y
    LDY cp_list,X
    LDA save_start_lo,Y             \ move [start, end) to the cursor, upwards in address
    STA v_ptr
    LDA save_start_hi,Y
    STA v_ptr + 1
    LDA cp_cursor_lo
    STA s_ptr
    LDA cp_cursor_hi
    STA s_ptr + 1
    LDA save_end_lo,Y
    SEC
    SBC save_start_lo,Y
    STA cp_len_lo
    LDA save_end_hi,Y
    SBC save_start_hi,Y
    STA cp_len_hi
    LDA cp_cursor_lo
    STA save_start_lo,Y
    CLC
    ADC cp_len_lo
    STA save_end_lo,Y
    STA cp_next_lo
    LDA cp_cursor_hi
    STA save_start_hi,Y
    ADC cp_len_hi
    STA save_end_hi,Y
    STA cp_cursor_hi                \ the next block's cursor now: nothing reads cp_cursor_hi again
    LDA v_ptr                       \ already there: nothing to copy
    CMP s_ptr
    BNE copy
    LDA v_ptr + 1
    CMP s_ptr + 1
    BEQ moved
.copy
    LDY #0                          \ copy forward (the block only moves down), Y and the pointers
    LDX cp_len_hi                   \ as the byte loop had them: whole pages (rare: at the end, off
    BNE whole_pages                 \ the common path), then the rest
.rest
    LDA cp_len_lo                   \ the rest (Y = 0 up): an odd byte, then pairs
    LSR A
    TAX
    BCC odd_done                    \ (Z from TAX: no pairs)
    LDA (v_ptr),Y
    STA (s_ptr),Y
    INY
    CPX #0
.odd_done
    BEQ moved
.pairs
    LDA (v_ptr),Y
    STA (s_ptr),Y
    INY
    LDA (v_ptr),Y
    STA (s_ptr),Y
    INY
    DEX
    BNE pairs
.moved
    LDA cp_next_lo
    STA cp_cursor_lo
    JMP next_block
.whole_pages
    LDA (v_ptr),Y
    STA (s_ptr),Y
    INY
    BNE whole_pages
    INC v_ptr + 1
    INC s_ptr + 1
    DEX
    BNE whole_pages
    BRA rest                        \ 65C02 opcode
}

\ ---- records -----------------------------------------------------------------------------
\ X = slot (the live tables), Y = slot + boff (the records)
.record_differs                     \ Z clear if the record and the live slot differ; keeps X, Y
{
    LDA rec_type,Y
    CMP movers_type_and_colour,X
    BNE out
    LDA rec_frame,Y
    CMP movers_frame_and_flip,X
    BNE out
    LDA rec_xl,Y
    CMP movers_x_low,X
    BNE out
    LDA rec_xh,Y
    CMP movers_x_high,X
    BNE out
    LDA rec_y,Y
    CMP movers_y,X
    BNE out
    LDA rec_sl,Y
    CMP movers_screen_address_low,X
    BNE out
    LDA rec_sh,Y
    CMP movers_screen_address_high,X
.out
    RTS
}

.record_live                        \ the live slot is now what this screen shows
    LDA movers_type_and_colour,X
    STA rec_type,Y
    LDA movers_frame_and_flip,X
    STA rec_frame,Y
    LDA movers_x_low,X
    STA rec_xl,Y
    LDA movers_x_high,X
    STA rec_xh,Y
    LDA movers_y,X
    STA rec_y,Y
    LDA movers_screen_address_low,X
    STA rec_sl,Y
    LDA movers_screen_address_high,X
    STA rec_sh,Y
    PHY                             \ and where that is in the world (BUGS #7): the view in
    LDY movers_screen_address_low,X \ zero page is this screen's now; A = the high byte (rec_sh)
    TAX
    TYA
    JSR world_of_address
    PLY
    LDA wa_x_lo
    STA rec_wxl,Y
    LDA wa_x_hi
    STA rec_wxh,Y
    LDA wa_y
    STA rec_wy,Y
    RTS

\ world_of_address: AX = a screen address; wa_x (16 bits) and wa_y = the world column and the y
\ (movers_y's sense: &C7 at the top row) of that byte, by the view in zero page (its screen
\ start and viewport_left). A character row is &280 bytes: the row is guessed from the offset's
\ high byte (wa_rows_guess, out by at most one) and settled against wa_rows_base.
\ BUGS #10: a mover clipped at the view's left edge (x 1-11 left of viewport_left) has its
\ address left of its row's first column, which is the end of the row above (column 69-79) - or,
\ in the first row, the ring's hidden 48 columns past the last (row 25): placed there it would be
\ 80 columns right and 8 lines up. Column 69-79 is the row above only if the mover is not left of
\ the view (dm_slot = its slot: its x, 80 columns left of that place if it is); row 25 is always
\ the first row's left. Its place is then the address's column in the row below, left of the
\ view (draw_mover clips by x from the address, so it draws in that row). At the right edge
\ nothing wraps: a mover goes on only with x <= viewport_right, so its address is in its row
\ (BUGS #7's explosion, drawn 6 columns right of its x, could land at the start of the row
\ below, and would be placed there: where it is drawn).
.world_of_address
{
    SEC
    SBC screen_start_address_low
    STA wa_off
    TXA
    SBC screen_start_address_high
    AND #&3F                        \ round the 16K screen
    STA wa_off + 1
    TAX
    LDY wa_rows_guess,X
    LDA wa_off                      \ at or past the next row's start: that row
    CMP wa_rows_base_lo + 1,Y
    TXA                             \ wa_off + 1: X still holds it
    SBC wa_rows_base_hi + 1,Y
    BCC row_known
    INY
.row_known
    LDA wa_off                      \ the column: (offset - the row's start) / 8
    SEC
    SBC wa_rows_base_lo,Y
    PHA                             \ the offset in the row, low byte
    TXA                             \ X = wa_off + 1 still
    SBC wa_rows_base_hi,Y           \ high byte 0..2: the offset is under &280
    LSR A                           \ C = bit 0 of it, A = bit 1
    TAX
    PLA
    ROR A
    CPX #1                          \ C = bit 1
    ROR A
    LSR A                           \ the column, 0..&4F
    CMP #80 - 11                    \ BUGS #10: 69-79 may be a mover left of the view
    BCS late_column                 \ (and C clear on the way on, for the add)
.column_known
    ADC viewport_left_low
    STA wa_x_lo
    LDA viewport_left_high
    ADC #0
    STA wa_x_hi
.y_of_row
    TYA                             \ y = &C7 - (row * 8 + the line in the cell)
    ASL A
    ASL A
    ASL A                           \ C = 0: row <= 25
    EOR #&FF
    ADC #&C8                        \ &C7 - row * 8, its low 3 bits 111; C clear only for row 25
    BCC row_25
.y_known
    STA wa_y
    LDA wa_off
    AND #&07
    TRB wa_y                        \ less the line in the cell (65C02 opcode)
    RTS
.late_column                        \ A = the column, 69-79; C set
    CLC
    ADC viewport_left_low
    STA wa_x_lo
    LDA viewport_left_high
    ADC #0
    STA wa_x_hi
    LDX dm_slot                     \ in this row, the mover is at or right of viewport_left + 69;
    LDA wa_x_lo                     \ its x is 0 columns left of that (6: BUGS #7's explosion),
    SEC                             \ or, left of the view, 80 (86): x < viewport_left, as a
    SBC movers_x_low,X              \ byte (the two are 74 apart, so the low bytes tell them)
    CMP #40
    BCC y_of_row                    \ in the view: the row above is its row
    LDA wa_x_lo                     \ C set: in the row below, 80 columns left
    SBC #80
    STA wa_x_lo
    BCS left_x
    DEC wa_x_hi
.left_x
    INY                             \ the row below
    BRA y_of_row                    \ 65C02 opcode
.row_25                             \ C clear: the first row's left, 48 columns left (&4000 -
    LDA wa_x_lo                     \ 25 rows of &280 is 48 columns of 8)
    SBC #48 - 1
    STA wa_x_lo
    BCS row_25_x
    DEC wa_x_hi
.row_25_x
    LDA #&C7                        \ the first row's y
    BRA y_known                     \ 65C02 opcode
}
.wa_rows_guess                      \ by the offset's high byte h: floor(h * 256 / &280)
FOR h = 0..63
    EQUB (h * 256) DIV &280
NEXT
.wa_rows_base_lo                    \ the start of character row k: k * &280
FOR k = 0..26
    EQUB LO(k * &280)
NEXT
.wa_rows_base_hi
FOR k = 0..26
    EQUB HI(k * &280)
NEXT

IF SKY_MODE
INCLUDE "sky.6502"                  \ the enemy helicopters over the sky: self-erasing rectangles
ELSE
INCLUDE "kindcache.6502"            \ layer 4 (decision 36): the big parts' kinds, built at run time
ENDIF

\ ---- the renderer's variables: in src/render_bss.6502 (its workspace), not in the file ----
.render_end
ASSERT render_end <= REN_BASE
