\ render.6502 - step 2 layer 2: the renderer. Runs in sideways RAM bank 4, after the bank's
\ sprite data (bank 4 is paged whenever movers are drawn, so plot_mover can be called from here;
\ src/game.6502's render_pass and render_start page it in and jump here).
\
\ The game's logic no longer draws (decision 20): plot_mover's own calls work everything out but
\ write nothing, the player's save-under is gone from the logic, and the scroll hands its new edge
\ column here (history_push) instead of writing it. Once a pass's logic is done, render brings a
\ screen up to date from what it RECORDS that screen shows (layer 3: masked, decision 24):
\   1. which movers come off: shown in another state than the live one, or overlapping a column
\      the scroll writes or leaves, or the lives digit about to be redrawn
\   2. which go on: live, on screen, and not shown (or coming off)
\   3. any shown mover overlapping one of those comes off and goes back on too, so overlapping
\      movers are always drawn in slot order (the player last) and taken off in reverse
\   4. off: each one's save block put back, the player first, then from the last slot down
\   5. the scroll: each edge column this screen has not had, oldest first, with the screen
\      start, viewport and lives digit that went with it
\   6. on: each drawn through its mask from the straight sprite data (ANDY and bank 4), saving
\      what it covers into a save block in the screen's arena (save_arena, main or shadow RAM)
\ Records are per screen: index = slot + 64 * screen. Screen 0 is main RAM, screen 1 the Master's
\ shadow RAM, at the same addresses (&4000-&7FFF); the vsync interrupt shows each in turn.

REN_BASE    = &B400 + PAD_START     \ workspace above the code and data (DATA1 ASSERTs it), to &C000;
                                    \ not in the file
rec_type    = REN_BASE + &000       \ movers_type_and_colour as drawn
rec_frame   = REN_BASE + &080       \ movers_frame_and_flip
rec_xl      = REN_BASE + &100       \ movers_x_low
rec_xh      = REN_BASE + &180       \ movers_x_high; &FF = nothing drawn
rec_y       = REN_BASE + &200       \ movers_y
rec_sl      = REN_BASE + &280       \ movers_screen_address_low
rec_sh      = REN_BASE + &300       \ movers_screen_address_high
hist0       = REN_BASE + &400       \ the edge column history: two columns of 200 bytes
hist1       = REN_BASE + &500
save_start_lo = REN_BASE + &600     \ per screen and slot (index = slot + 64 * screen): the mover's
save_start_hi = REN_BASE + &680     \ save block in that screen's save_arena (start_hi 0: none)
save_end_lo = REN_BASE + &700
save_end_hi = REN_BASE + &780
zp_save     = REN_BASE + &800       \ the game's zero page, kept while the renderer draws
rec_wxl     = REN_BASE + &900       \ per record: where it was drawn, in the world - its column
rec_wxh     = REN_BASE + &980       \ and its y, from the screen address it was drawn at, not
rec_wy      = REN_BASE + &A00       \ movers_x/y (BUGS #7): world_of_address
ASSERT zp_save + &100 <= &C000 AND rec_wy + &80 <= &C000

MOVER_SLOTS = &22                   \ MOVER_LAST + 1
save_ptr    = &9C                   \ zero page, free since layer 2 (&9C/&9D)
\ zero page the renderer may use freely (restore_game_zp gives the logic back what it reads)
d_ptr       = &C0                   \ the sprite data, (d_ptr),Y
s_ptr       = &C2                   \ the screen's character cell, (s_ptr),Y
v_ptr       = &C4                   \ the save block, (v_ptr),Y
stop_y      = &C6                   \ the Y a segment's byte loop stops at
col_ptr     = &C7                   \ the sprite column being drawn (&C7/&C8)
b_ptr       = &C9                   \ the cell of a sprite column's bottom (&C9/&CA)
rows_m1     = &CB                   \ a column's rows still to do, less 1
ds_c        = &CC                   \ a part's columns left
ds_line     = &CD                   \ the line in the cell of a part's bottom
MAX_BLOCK   = &2A0                  \ more than any mover's save block: 636 bytes at most (tools/sprites.py stats)

\ =============================================================================================
\ history_push: the scroll has built a new edge column in column_buffer (update_screen pages
\ bank 4 and jumps here). Keep it, with the view it belongs to, for each screen to apply.
\ =============================================================================================
.history_push
{
    \ layer 3 (D): the column into its slot, 8 bytes a time. A push with no scroll since the
    \ last (the original's, after a hostile collision) pushes the last column again: from its
    \ slot, since column_buffer may hold the next scroll's, built ahead (src/prebuild.6502).
    LDA col_fresh
    BNE fresh
    JMP repush
.fresh
    STZ col_fresh                   \ 65C02 opcode
    LDX hist_next
    LDA hist_dst_hi,X
    STA dst1 + 2
    STA dst2 + 2
    STA dst3 + 2
    STA dst4 + 2
    STA dst5 + 2
    STA dst6 + 2
    STA dst7 + 2
    STA dst8 + 2
    LDX #200
    LDA pre_use                     \ the prebuilt column (src/prebuild.6502), whose rows 24-199
    BEQ copy                        \ are already in this slot: only the ground's rows
    LDA pre_hist
    BEQ copy
    DEC A                           \ 65C02 opcode
    CMP hist_next
    BNE copy
    LDX #24
.copy
    LDA column_buffer - 1,X
.dst1
    STA hist0 - 1,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 2,X
.dst2
    STA hist0 - 2,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 3,X
.dst3
    STA hist0 - 3,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 4,X
.dst4
    STA hist0 - 4,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 5,X
.dst5
    STA hist0 - 5,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 6,X
.dst6
    STA hist0 - 6,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 7,X
.dst7
    STA hist0 - 7,X                 \ self-modified: hist0 or hist1
    LDA column_buffer - 8,X
.dst8
    STA hist0 - 8,X                 \ self-modified: hist0 or hist1
    TXA
    SEC
    SBC #8
    TAX
    BNE copy
.pushed
    STZ pre_hist                    \ 65C02 opcode: the slot is this push's now
    LDX hist_next
.header                             \ X = the slot
    LDA edge_screen_address_low
    STA hist_edge_lo,X
    LDA edge_screen_address_high
    STA hist_edge_hi,X
    LDA screen_start_address_low
    STA hist_ss_lo,X
    LDA screen_start_address_high
    STA hist_ss_hi,X
    LDA crtc_start_address_low
    STA hist_crtc_lo,X
    LDA crtc_start_address_high
    STA hist_crtc_hi,X
    LDA viewport_left_low
    STA hist_vl_lo,X
    LDA viewport_left_high
    STA hist_vl_hi,X
    LDA viewport_right_low
    STA hist_vr_lo,X
    LDA viewport_right_high
    STA hist_vr_hi,X
    \ the direction: viewport_left moved by +1 (right) or -1 (left) since the last push
    LDA viewport_left_low
    SEC
    SBC last_vl_lo
    TAY
    LDA viewport_left_high
    SBC last_vl_hi
    BNE went_left
    CPY #1
    BEQ went_right
.went_left
    LDA #&FF
    BNE set_dir                     \ always
.went_right
    LDA #1
.set_dir
    STA hist_dir,X
    LDA viewport_left_low
    STA last_vl_lo
    LDA viewport_left_high
    STA last_vl_hi
    INC hist_seq
    LDA hist_seq
    STA hist_seqs,X
    TXA
    EOR #1
    STA hist_next
    RTS
.repush
    LDX hist_next
    LDA hist_dst_hi,X
    STA rp_dst + 2
    TXA
    EOR #1
    TAX
    LDA hist_dst_hi,X
    STA rp_src + 2
    LDX #200
.rp_loop
.rp_src
    LDA hist0 - 1,X                 \ self-modified: the last slot
.rp_dst
    STA hist0 - 1,X                 \ self-modified: this one
    DEX
    BNE rp_loop
    JMP pushed
}

\ =============================================================================================
\ render_reset: a game has started (render_start in src/game.6502). scroll_into_world has written the scenery into the screen;
\ nothing else is drawn there yet.
\ =============================================================================================
.render_reset
{
    LDX #127
    LDA #&FF
.clear_records
    STA rec_xh,X
    DEX
    BPL clear_records
    LDX #127                        \ no save blocks
    LDA #0
.no_blocks
    STA save_start_hi,X
    DEX
    BPL no_blocks
    LDX #1
.each_screen
    LDA #LO(save_arena)             \ each screen's arena empty
    STA arena_top_lo,X
    LDA #HI(save_arena)
    STA arena_top_hi,X
    LDA hist_seq
    STA buf_seq,X
    LDA #&FF
    STA buf_lives,X
    JSR view_to_buffer
    DEX
    BPL each_screen
    LDA viewport_left_low
    STA last_vl_lo
    LDA viewport_left_high
    STA last_vl_hi
    STZ flip_pending
    STZ shown_screen
    \ the shadow screen starts as a copy of main, and shadow &3000-&3FFF as a copy of the code
    \ and data there: the renderer runs the plotters with the CPU seeing shadow RAM
    LDA acccon
    AND #&FA                        \ X = 0, D = 0: main, for the CPU and the video
    STA acccon
    STA acc_main
    ORA #&04
    STA acc_shadow
    STZ save_ptr
    LDA #&30
    STA save_ptr + 1
    LDY #0
.copy
    LDA (save_ptr),Y
    LDX acc_shadow
    STX acccon
    STA (save_ptr),Y
    LDX acc_main
    STX acccon
    INY
    BNE copy
    INC save_ptr + 1
    BPL copy                        \ up to &7FFF
    RTS
}

\ ---- the view: the zero-page values the plotter and the lives read ---------------------------
.view_to_buffer                     \ X = screen: the live view becomes that screen's
    LDA screen_start_address_low
    STA buf_ss_lo,X
    LDA screen_start_address_high
    STA buf_ss_hi,X
    LDA crtc_start_address_low
    STA buf_crtc_lo,X
    LDA crtc_start_address_high
    STA buf_crtc_hi,X
    LDA viewport_left_low
    STA buf_vl_lo,X
    LDA viewport_left_high
    STA buf_vl_hi,X
    LDA viewport_right_low
    STA buf_vr_lo,X
    LDA viewport_right_high
    STA buf_vr_hi,X
    RTS

.buffer_to_view                     \ X = screen: that screen's view becomes the live one
    LDA buf_ss_lo,X
    STA screen_start_address_low
    LDA buf_ss_hi,X
    STA screen_start_address_high
    LDA buf_crtc_lo,X
    STA crtc_start_address_low
    LDA buf_crtc_hi,X
    STA crtc_start_address_high
    LDA buf_vl_lo,X
    STA viewport_left_low
    LDA buf_vl_hi,X
    STA viewport_left_high
    LDA buf_vr_lo,X
    STA viewport_right_low
    LDA buf_vr_hi,X
    STA viewport_right_high
    RTS

.history_to_view                    \ X = history slot: the view after that scroll becomes live
    LDA hist_ss_lo,X
    STA screen_start_address_low
    LDA hist_ss_hi,X
    STA screen_start_address_high
    LDA hist_crtc_lo,X
    STA crtc_start_address_low
    LDA hist_crtc_hi,X
    STA crtc_start_address_high
    LDA hist_vl_lo,X
    STA viewport_left_low
    LDA hist_vl_hi,X
    STA viewport_left_high
    LDA hist_vr_lo,X
    STA viewport_right_low
    LDA hist_vr_hi,X
    STA viewport_right_high
    RTS

\ =============================================================================================
\ render: bring screen `back` up to date with the live game state
\ =============================================================================================
.render
{
    JSR prebuild                    \ RAM for cycles 1: the next scroll column, if there is time
    JSR wait_for_flip               \ the hidden screen is the one the last frame went to until
    JSR save_game_zp                \ it is shown (decision 26)
    LDA shown_screen                \ draw into the screen not being shown
    EOR #1
    STA back
    BEQ set_boff
    LDA #64
.set_boff
    STA boff
    JSR cpu_sees_back               \ ACCCON X: &3000-&7FFF is that screen's RAM
    LDX #2                          \ the logic's current view goes in slot 2 of buf_*
    JSR view_to_buffer

    \ ---- the scrolls this screen has not had: 0, 1 or 2, oldest first ----
    LDX back
    LDA hist_seq
    SEC
    SBC buf_seq,X
    STA pending_n
    LDA hist_next
    EOR #1
    STA pending_slot + 1            \ the newest
    LDX pending_n
    CPX #2
    BNE one_or_none
    LDA hist_next                   \ two: the older is the slot to be written next
    STA pending_slot
    JMP zones
.one_or_none
    STA pending_slot                \ one: only the newest
.zones
    \ ---- the zone: the columns the scroll writes or leaves, and the lives digit's ----
    STZ zone_n
    LDX pending_n
    BEQ no_scroll_zone
    LDY #0                          \ Y = which pending entry
    CPX #2
    BEQ add_entries
    INY                             \ one pending: it is pending_slot + 1 as well as + 0
.add_entries
    LDX pending_slot,Y
    JSR add_scroll_zone
    INY
    CPY #2
    BNE add_entries
.no_scroll_zone
    \ the lives digit is redrawn if the screen scrolls or the count changed: the four columns
    \ from the left edge, at the view it ends up with (and at the first scroll's, if two)
    STZ lives_redraw
    LDX back
    LDA buf_lives,X
    CMP lives
    BNE redraw_lives
    LDA pending_n
    BEQ lives_done
.redraw_lives
    DEC lives_redraw                \ &FF
    LDA buf_vl_lo + 2
    LDX buf_vl_hi + 2
    JSR add_lives_zone
    LDA pending_n
    CMP #2
    BNE lives_done
    LDX pending_slot
    LDA hist_vl_lo,X
    PHA
    LDA hist_vl_hi,X
    TAX
    PLA
    JSR add_lives_zone
.lives_done

    \ ---- 1. what comes off: shown here and stale (another state than the live slot, or in
    \ the zone). need: bit 7 take off, bit 6 put on ----
    STZ act_n                       \ and the list of slots that matter: shown here or live
    LDX #0
.classify
    STX ren_i
    STZ need,X
    TXA
    CLC
    ADC boff
    TAY
    LDA rec_xh,Y
    CMP #&FF
    BNE shown
    LDA movers_x_high,X
    BMI classified                  \ nothing shown, nothing there
    \ RAM for cycles 4: not shown here, and its x cannot put it on the screen (its high byte past
    \ the right edge's, or more than one below the left edge's: widths are under 256), so it
    \ cannot go on (mark_to_draw's check_if_mover_is_on_screen) and nothing else lists it
    CMP viewport_right_high
    BEQ near_screen
    BCS classified                  \ right of the screen
.near_screen
    INC A                           \ 65C02 opcode
    CMP viewport_left_high
    BCC classified                  \ left of it
    BRA listed                      \ 65C02 opcode
.shown
IF DEBUG_FULLREDRAW
    BRA stale                       \ the oracle: everything comes off and goes back on
ENDIF
    JSR record_differs              \ (keeps X, Y)
    BNE stale
    LDA rec_wxl,Y                   \ where it was drawn (BUGS #7)
    STA span_x_lo
    LDA rec_wxh,Y
    STA span_x_hi
    LDA rec_type,Y
    JSR width_of_type_A
    JSR span_in_zone
    BCC listed
.stale
    LDX ren_i
    LDA #&80
    STA need,X
.listed
    LDY act_n
    LDA ren_i
    STA act,Y
    INC act_n
.classified
    LDX ren_i
    INX
    CPX #MOVER_SLOTS
    BNE classify

    \ ---- 2. what goes on; 3. what overlaps it comes off and goes back on too ----
    JSR mark_to_draw
    JSR close_over_overlaps

    \ ---- 4. take off: the player first (drawn last), then the movers from the last slot down ----
    LDX #0
    JSR take_off
    LDY act_n
    BEQ taken_off
.taking_off
    DEY
    STY ren_k
    LDX act,Y
    BEQ taken_off                   \ the player: first in the list, already off
    JSR take_off
    LDY ren_k
    BNE taking_off
.taken_off

    \ ---- 5. the scroll, oldest column first, each with its view and the lives digit ----
    LDY #0
    LDA pending_n
    BEQ scrolled
    CMP #2
    BEQ apply_entries
    INY
.apply_entries
    STY ren_k
    LDX pending_slot,Y
    JSR write_column
    LDY ren_k
    LDX pending_slot,Y
    JSR history_to_view
    JSR ren_plot_lives
    LDX back
    LDA lives
    STA buf_lives,X
    LDY ren_k
    LDX pending_slot,Y
    LDA hist_seqs,X
    LDX back
    STA buf_seq,X
    LDY ren_k
    INY
    CPY #2
    BNE apply_entries
.scrolled
    LDX #2                          \ the logic's view again; it is this screen's now
    JSR buffer_to_view
    LDX back
    JSR view_to_buffer
    LDA buf_lives,X
    CMP lives
    BEQ lives_drawn
    JSR ren_plot_lives
    LDX back
    LDA lives
    STA buf_lives,X
.lives_drawn

    \ ---- 6. put on: slot order, the player last; ANDY paged over bank 4's first 4K ----
    LDA #&84
    STA os_ram_copy_of_currently_selected_rom
    STA romsel
    LDY #0
.putting_on
    CPY act_n
    BEQ put_on_player
    STY ren_k
    LDX act,Y
    BEQ next_put_on                 \ the player goes on last
    JSR put_on
.next_put_on
    LDY ren_k
    INY
    BRA putting_on                  \ 65C02 opcode
.put_on_player
    LDX #0
    JSR put_on
    LDA #&04
    STA os_ram_copy_of_currently_selected_rom
    STA romsel
.player_done
    LDA back                        \ for the vsync interrupt to show, at the pass lock's field
    STA flip_screen
    LDA crtc_start_address_high
    STA flip_crtc_hi
    LDA crtc_start_address_low
    STA flip_crtc_lo
    JSR cpu_sees_main
    JMP restore_game_zp
}

\ ---- ACCCON's X bit: which RAM the CPU sees at &3000-&7FFF (D, which the video shows, is the
\ vsync interrupt's). Read, change, write with interrupts off: the interrupt writes ACCCON too.
.cpu_sees_back
    LDA back
    BEQ cpu_sees_main
    SEI
    LDA acccon
    ORA #&04
    BNE set_acccon                  \ always
.cpu_sees_main
    SEI
    LDA acccon
    AND #&FB
.set_acccon
    STA acccon
    CLI
    RTS

\ ---- wait_for_flip: until the vsync interrupt has shown the last frame (decision 26: the logic
\ of the next pass runs meanwhile, and the renderer waits here) -------------------------------
.wait_for_flip
{
    BIT flip_pending
    BMI wait_for_flip
    RTS
}

\ ---- render_to_main: the game is over (or observer mode left): the newest frame on the main
\ screen, shown, so the game over text and the title go where the original put them.
.render_to_main
{
    JSR wait_for_flip               \ a flip still to come happens first
    LDA shown_screen
    BEQ done                        \ main is shown, and newest
    JSR render                      \ draws into main, the hidden one
    SEI
    LDX #&0C                        \ R12/R13 now: the text follows at once
    STX crtc_reg
    LDA crtc_start_address_high
    STA crtc_data
    INX
    STX crtc_reg
    LDA crtc_start_address_low
    STA crtc_data
    LDA acccon
    AND #&FE                        \ D = 0: the video shows main
    STA acccon
    STZ shown_screen
    STZ flip_pending
    CLI
.done
    RTS
}

\ ---- ren_plot_lives: the lives digit at the screen start, as plot_lives leaves it (its bytes do
\ not depend on what was there: src/lives_digits.6502, from tools/livesdigits.py) -------------
.ren_plot_lives
{
    LDA lives                       \ d_ptr = lives_digits + 32 * (lives AND 15)
    AND #&0F
    STA d_ptr + 1
    LDA #0
    LSR d_ptr + 1
    ROR A
    LSR d_ptr + 1
    ROR A
    LSR d_ptr + 1
    ROR A
    CLC
    ADC #LO(lives_digits)
    STA d_ptr
    LDA d_ptr + 1
    ADC #HI(lives_digits)
    STA d_ptr + 1
    LDA screen_start_address_low
    STA s_ptr
    LDA screen_start_address_high
    STA s_ptr + 1
    LDX #4                          \ 4 byte columns of 8 rows
.column
    LDY #7
.row
    LDA (d_ptr),Y
    STA (s_ptr),Y
    DEY
    BPL row
    LDA d_ptr
    CLC
    ADC #8
    STA d_ptr
    BCC data_same_page
    INC d_ptr + 1
.data_same_page
    LDA s_ptr                       \ the next cell across, round the 16K screen
    CLC
    ADC #8
    STA s_ptr
    BCC screen_same_page
    LDA s_ptr + 1
    INC A                           \ 65C02 opcode
    BPL in_ring
    LDA #&40
.in_ring
    STA s_ptr + 1
.screen_same_page
    DEX
    BNE column
    RTS
}
INCLUDE "lives_digits.6502"

\ ---- write_column: X = history slot. The original update_screen's loop, from the history:
\ 200 bytes down the column, a character row (8 bytes) at a time, unrolled (layer 3, D) -----
.write_column
{
    LDA hist_edge_lo,X
    STA edge_screen_address_low
    LDA hist_edge_hi,X
    STA edge_screen_address_high
    LDA hist_src_hi,X               \ the slot: the 8 operands' high byte
    STA src0 + 2
    STA src1 + 2
    STA src2 + 2
    STA src3 + 2
    STA src4 + 2
    STA src5 + 2
    STA src6 + 2
    STA src7 + 2
    LDX #&C8                        \ the history's bytes from the top: X - 1 - line
.group
    LDY #0
.src0
    LDA hist0 - 1 - 0,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src1
    LDA hist0 - 1 - 1,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src2
    LDA hist0 - 1 - 2,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src3
    LDA hist0 - 1 - 3,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src4
    LDA hist0 - 1 - 4,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src5
    LDA hist0 - 1 - 5,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src6
    LDA hist0 - 1 - 6,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    INY
.src7
    LDA hist0 - 1 - 7,X             \ self-modified: hist0 or hist1
    STA (edge_screen_address),Y
    TXA
    SEC
    SBC #8
    BEQ done
    TAX
    LDA edge_screen_address_low     \ down a character row: &280, round the 16K screen
    CLC
    ADC #&80
    STA edge_screen_address_low
    LDA edge_screen_address_high
    ADC #&02
    BPL in_ring
    SEC
    SBC #&40
.in_ring
    STA edge_screen_address_high
    JMP group
.done
    RTS
}
.hist_dst_hi                         \ history_push's operands' high byte, by slot
    EQUB HI(hist0 - 8), HI(hist1 - 8)
ASSERT HI(hist0 - 8) = HI(hist0 - 1) AND HI(hist1 - 8) = HI(hist1 - 1) AND LO(hist0) = LO(hist1)
ASSERT HI(column_buffer - 8) = HI(column_buffer - 1)
.hist_src_hi
    EQUB HI(hist0 - 1), HI(hist1 - 1)
ASSERT LO(hist0 - 1) = LO(hist1 - 1)
ASSERT HI(hist0 - 8) = HI(hist0 - 1) AND HI(hist1 - 8) = HI(hist1 - 1)   \ the 8 operands share a high byte

\ ---- the zone ---------------------------------------------------------------------------------
\ add_scroll_zone: X = history slot. A right scroll writes the column at the new right edge and
\ leaves the one at the old left edge (whose memory the new column reuses, a row up); a left
\ scroll the mirror image.
.add_scroll_zone
{
    LDA hist_dir,X
    BMI left
    LDA hist_vr_lo,X                \ right: arriving = new viewport_right
    STA zone_tmp_lo
    LDA hist_vr_hi,X
    STA zone_tmp_hi
    JSR add_zone_column
    LDA hist_vl_lo,X                \ leaving = new viewport_left - 1
    SEC
    SBC #1
    STA zone_tmp_lo
    LDA hist_vl_hi,X
    SBC #0
    STA zone_tmp_hi
    JMP add_zone_column
.left
    LDA hist_vl_lo,X                \ left: arriving = new viewport_left
    STA zone_tmp_lo
    LDA hist_vl_hi,X
    STA zone_tmp_hi
    JSR add_zone_column
    LDA hist_vr_lo,X                \ leaving = new viewport_right + 1
    CLC
    ADC #1
    STA zone_tmp_lo
    LDA hist_vr_hi,X
    ADC #0
    STA zone_tmp_hi
    JMP add_zone_column
}

\ add_lives_zone: A/X = a viewport_left (low/high); the four columns the lives digit covers
.add_lives_zone
{
    STA zone_tmp_lo
    STX zone_tmp_hi
    LDA #4
    STA zone_count
.each
    JSR add_zone_column
    INC zone_tmp_lo
    BNE same_page
    INC zone_tmp_hi
.same_page
    DEC zone_count
    BNE each
    RTS
}

.add_zone_column                    \ zone_tmp -> the list; keeps X and Y
{
    PHX
    LDX zone_n
    LDA zone_tmp_lo
    STA zone_lo,X
    LDA zone_tmp_hi
    STA zone_hi,X
    INC zone_n
    PLX
    RTS
}

\ span_in_zone: does [span_x - 1, span_x + A + 1] hold a zone column? C set if so. Keeps Y.
.span_in_zone
{
    CLC
    ADC #2
    STA span_w2
    LDX zone_n
    BEQ none
.each
    DEX
    LDA zone_lo,X                   \ d = column - span_x + 1
    SEC
    SBC span_x_lo
    STA span_d
    LDA zone_hi,X
    SBC span_x_hi
    STA span_d + 1
    LDA span_d
    CLC
    ADC #1
    STA span_d
    LDA span_d + 1
    ADC #0
    BNE next                        \ outside: negative or too far
    LDA span_w2
    CMP span_d
    BCS hit                         \ d <= width + 2
.next
    TXA
    BNE each
.none
    CLC
    RTS
.hit
    SEC
    RTS
}

.width_of_type_A                    \ A = movers_type_and_colour -> A = width; keeps Y
    AND #&7F
    TAX
    LDA mover_types_width_table,X
    RTS

\ ---- what goes on, and what overlaps it --------------------------------------------------
\ mark_to_draw: need bit 6 for every live slot on screen (the logic's view) that this screen
\ does not show, or is taking off.
.mark_to_draw
{
    LDY #0
.each
    CPY act_n
    BEQ done
    STY ren_k
    LDX act,Y
    STX ren_i
    LDA need,X
    BMI candidate                   \ coming off: goes back on if still there
    TXA
    CLC
    ADC boff
    TAY
    LDA rec_xh,Y
    CMP #&FF
    BNE next                        \ shown and staying
.candidate
    LDY ren_i
    LDA movers_x_high,Y
    BMI next                        \ no mover in the slot
    JSR get_mover_Y_x
    LDA movers_type_and_colour,Y
    AND #&7F
    TAX
    JSR check_if_mover_is_on_screen \ carry set if not
    BCS next
    LDX ren_i
    LDA need,X
    ORA #&40
    STA need,X
.next
    LDY ren_k
    INY
    BRA each                        \ 65C02 opcode
.done
    RTS
}

\ close_over_overlaps: a shown mover that overlaps one coming off or going on comes off and
\ goes back on too, so overlapping movers are always drawn in slot order and taken off in
\ reverse (a mover's save block holds what was under it, earlier movers included). Over a
\ short list of the slots that matter: each one shown or going on, with a rectangle covering
\ where it is shown and where it goes, a column and two rows to spare.
.close_over_overlaps
{
    STZ list_n
    LDY #0
.gather
    CPY act_n
    BEQ gathered
    STY ren_k
    LDX act,Y
    STX ren_i
    TXA
    CLC
    ADC boff
    TAY
    LDA rec_xh,Y
    CMP #&FF
    BNE shown
    LDA need,X
    AND #&40
    BEQ not_listed
    JSR list_live                   \ going on, not shown: where it goes
    BRA listed                      \ 65C02 opcode
.shown
    JSR list_recorded               \ where it is shown...
    LDX ren_i
    LDA need,X
    AND #&40
    BEQ listed
    JSR widen_by_live               \ ...and where it goes
.listed
    INC list_n
.not_listed
    LDY ren_k
    INY
    BRA gather                      \ 65C02 opcode
.gathered
.again
    STZ list_changed
    LDX #0
.each_a
    CPX list_n
    BEQ swept
    LDY list_slot,X
    LDA need,Y
    BNE next_a                      \ already coming off or going on
    LDY #0
.each_b
    CPY list_n
    BEQ next_a
    STY list_b
    LDA list_slot,Y
    TAY
    LDA need,Y
    BEQ next_b                      \ staying too: no reason
    LDY list_b
    JSR list_overlap                \ X, Y list entries: C set if they overlap
    BCC next_b
    LDY list_slot,X                 \ a overlaps b: a comes off and goes back on
    LDA #&C0
    STA need,Y
    STA list_changed
    BRA next_a                      \ 65C02 opcode
.next_b
    LDY list_b
    INY
    BRA each_b                      \ 65C02 opcode
.next_a
    INX
    BRA each_a                      \ 65C02 opcode
.swept
    LDA list_changed
    BNE again
    RTS
}

\ list entry list_n for slot ren_i: its recorded rectangle (Y = slot + boff)
.list_recorded
{
    LDX list_n
    LDA ren_i
    STA list_slot,X
    LDA rec_type,Y
    AND #&7F
    STA list_type
    LDA rec_wxl,Y                   \ where it was drawn (BUGS #7)
    STA list_x_lo
    LDA rec_wxh,Y
    STA list_x_hi
    LDA rec_wy,Y
    JMP list_finish
}

\ list entry list_n for slot ren_i: its live rectangle
.list_live
{
    LDX list_n
    LDY ren_i
    TYA
    STA list_slot,X
    LDA movers_type_and_colour,Y
    AND #&7F
    STA list_type
    LDA movers_screen_address_low,Y \ where it will be drawn (BUGS #7), in the logic's view
    LDX movers_screen_address_high,Y
    JSR world_of_address
    LDA wa_x_lo
    STA list_x_lo
    LDA wa_x_hi
    STA list_x_hi
    LDX list_n
    LDA wa_y
}
    \ falls through
.list_finish                        \ A = y; list_type, list_x: entry X's rectangle
{
    STA list_y
    SEC
    SBC #2
    BCS y1_ok
    LDA #0
.y1_ok
    STA list_y1,X
    LDY list_type
    LDA list_y
    CLC
    ADC mover_types_height_table,Y
    BCS y2_top
    ADC #2
    BCC y2_ok
.y2_top
    LDA #&FF
.y2_ok
    STA list_y2,X
    LDA list_x_lo                   \ x1 = x - 1
    SEC
    SBC #1
    STA list_x1_lo,X
    LDA list_x_hi
    SBC #0
    STA list_x1_hi,X
    LDA list_x_lo                   \ x2 = x + width + 1
    SEC                             \ (the +1)
    ADC mover_types_width_table,Y
    STA list_x2_lo,X
    LDA list_x_hi
    ADC #0
    STA list_x2_hi,X
    RTS
}

\ widen entry list_n (slot ren_i, recorded) to cover its live rectangle as well
.widen_by_live
{
    LDA list_n
    PHA
    LDA #MOVER_SLOTS                \ build the live one in the spare entry...
    STA list_n
    JSR list_live
    PLA
    STA list_n
    TAX                             \ ...and take the union
    LDY #MOVER_SLOTS
    LDA list_x1_lo,Y
    CMP list_x1_lo,X
    LDA list_x1_hi,Y
    SBC list_x1_hi,X
    BCS x1_kept
    LDA list_x1_lo,Y
    STA list_x1_lo,X
    LDA list_x1_hi,Y
    STA list_x1_hi,X
.x1_kept
    LDA list_x2_lo,X
    CMP list_x2_lo,Y
    LDA list_x2_hi,X
    SBC list_x2_hi,Y
    BCS x2_kept
    LDA list_x2_lo,Y
    STA list_x2_lo,X
    LDA list_x2_hi,Y
    STA list_x2_hi,X
.x2_kept
    LDA list_y1,Y
    CMP list_y1,X
    BCS y1_kept
    STA list_y1,X
.y1_kept
    LDA list_y2,Y
    CMP list_y2,X
    BCC y2_kept
    STA list_y2,X
.y2_kept
    RTS
}

\ list_overlap: entries X and Y. C set if each starts no later than the other ends, in x
\ (16 bits) and in y.
.list_overlap
{
    LDA list_x2_lo,Y                \ x1 of X <= x2 of Y
    CMP list_x1_lo,X
    LDA list_x2_hi,Y
    SBC list_x1_hi,X
    BCC no
    LDA list_x2_lo,X                \ x1 of Y <= x2 of X
    CMP list_x1_lo,Y
    LDA list_x2_hi,X
    SBC list_x1_hi,Y
    BCC no
    LDA list_y2,Y                   \ y1 of X <= y2 of Y
    CMP list_y1,X
    BCC no
    LDA list_y2,X                   \ y1 of Y <= y2 of X
    CMP list_y1,Y
    RTS                             \ C as it stands
.no
    CLC
    RTS
}

\ ---- take off and put on -------------------------------------------------------------------
\ take_off: X = slot. If it comes off and is shown here, put its save block back.
.take_off
{
    LDA need,X
    BPL out
    TXA
    CLC
    ADC boff
    TAY
    LDA rec_xh,Y
    CMP #&FF
    BEQ out
    JSR restore_block
    LDY rb_index
    LDA #&FF
    STA rec_xh,Y
.out
    RTS
}

\ put_on: X = slot. If it goes on, draw it masked, saving what it covers, and record it.
.put_on
{
    LDA need,X
    AND #&40
    BNE going_on
    RTS
.going_on
    STX dm_slot
    TXA
    CLC
    ADC boff
    STA dm_index
    LDX back                        \ room for its block, or make some
    LDA arena_top_lo,X
    CLC
    ADC #LO(MAX_BLOCK)
    LDA arena_top_hi,X
    ADC #HI(MAX_BLOCK)
    CMP #HI(save_arena_end)
    BCC room
    JSR compact
.room
    LDX back
    LDY dm_index
    LDA arena_top_lo,X              \ the block starts at the arena's top: its header there,
    STA save_start_lo,Y             \ where parts 2 and 3 start (0: none)
    STA mark_part.header_lo
    SEC                             \ v_ptr = the start - 4: the first column's record goes at
    SBC #4                          \ v_ptr + 8, after the header (draw_column)
    STA v_ptr
    LDA arena_top_hi,X
    STA save_start_hi,Y
    STA mark_part.header_lo + 1
    SBC #0
    STA v_ptr + 1
    LDA v_ptr                       \ mark_part's base: the start - 8
    SEC
    SBC #4
    STA mark_part.base_lo
    LDA v_ptr + 1
    SBC #0
    STA mark_part.base_hi
    LDA arena_top_lo,X
    CLC
    ADC #1
    STA mark_part.header_hi
    LDA arena_top_hi,X
    ADC #0
    STA mark_part.header_hi + 1
    LDA #0
    LDY #7
.no_parts
    STA (v_ptr),Y                   \ the header, at v_ptr + 4 to + 7
    DEY
    CPY #4
    BCS no_parts
    JSR draw_mover                  \ (draw_column moves v_ptr on)
    LDX back                        \ the block ends after the last cell: v_ptr + 8
    LDY dm_index
    LDA v_ptr
    CLC
    ADC #8
    STA arena_top_lo,X
    STA save_end_lo,Y
    LDA v_ptr + 1
    ADC #0
    STA arena_top_hi,X
    STA save_end_hi,Y
    LDX dm_slot
    JSR record_live                 \ X = slot, Y = slot + boff
.out
    RTS
}

\ mark_part2, mark_part3: the part about to be drawn starts at v_ptr + 8 (its first record),
\ as an offset from the block's start (base = the start - 8), into the block's header (put_on
\ set the operands). Keeps A, X, Y.
.mark_part2
    PHY
    LDY #0
    BRA mark_part                   \ 65C02 opcode
.mark_part3
    PHY
    LDY #2
.mark_part
{
    PHA
    LDA v_ptr
    SEC
base_lo = * + 1
    SBC #0                          \ self-modified: the block's start - 8
header_lo = * + 1
    STA &FFFF,Y                     \ self-modified: the header
    LDA v_ptr + 1
base_hi = * + 1
    SBC #0
header_hi = * + 1
    STA &FFFF,Y
    PLA
    PLY
    RTS
}

\ ---- drawing a mover ----------------------------------------------------------------------
\ draw_mover: slot dm_slot, its sprites as plot_mover chooses them (one, two or three parts,
\ the second raised by sprites_y_offset and the third eight rows above that), clipped to the
\ viewport as the plotter clips (viewport_left to viewport_right inclusive), through the mask
\ and pixel tables for its colour and flip. Saves what it covers into the screen's arena.
.draw_mover
{
    LDX dm_slot
    LDA movers_type_and_colour,X
    STA dm_typecol
    AND #&7F
    STA dm_type
    LDA movers_frame_and_flip,X
    STA dm_flip                     \ bit 7
    AND #&3F
    STA dm_frame
    LDA movers_screen_address_low,X
    STA dm_scr_lo
    LDA movers_screen_address_high,X
    STA dm_scr_hi
    \ the visible columns, j from 0 at the mover's left: jmin = viewport_left - x if the mover
    \ starts left of it, else 0; jmax = viewport_right - x (255 if further)
    LDA viewport_left_low
    SEC
    SBC movers_x_low,X
    STA dm_jmin
    LDA viewport_left_high
    SBC movers_x_high,X
    BCS left_of_view                \ viewport_left >= x
    STZ dm_jmin                     \ 65C02 opcode
    BRA jmin_done                   \ 65C02 opcode
.left_of_view
    BEQ jmin_done                   \ high 0: the low byte is it
    LDA #&FF
    STA dm_jmin
.jmin_done
    LDA viewport_right_low
    SEC
    SBC movers_x_low,X
    STA dm_jmax
    LDA viewport_right_high
    SBC movers_x_high,X
    BCS not_right_of_view
    RTS                             \ the mover starts right of the viewport
.not_right_of_view
    BEQ jmax_done
    LDA #&FF
    STA dm_jmax
.jmax_done
    \ the tables: pixels by colour and flip, masks by flip (plot_mover and
    \ get_mover_type_and_colour's rules: most enemies white)
    LDY #HI(unflipped_green_pixel_table)
    LDA dm_typecol
    BPL green
    CMP #&85                        \ MOVER_TYPE_ENEMY | MOVER_TYPE_HELICOPTER_WITH_MISSILE
    BEQ green
    CMP #&95                        \ MOVER_TYPE_ENEMY | MOVER_TYPE_HEAVY_GUN and above
    BCS green
    CMP #&87                        \ MOVER_TYPE_ENEMY | MOVER_TYPE_HELICOPTER_WITH_SOLDIER
    BEQ green
    INY                             \ white: the next page
.green
    STY draw_column.pix_operand + 1
    STY draw_column.pix_operand_2 + 1
    BIT dm_flip
    BMI flipped
    LDA #LO(unflipped_green_pixel_table)
    STA draw_column.pix_operand
    STA draw_column.pix_operand_2
    LDA #LO(unflipped_mask_table)
    STA draw_column.mask_operand
    STA draw_column.mask_operand_2
    LDA #HI(unflipped_mask_table)
    STA draw_column.mask_operand + 1
    STA draw_column.mask_operand_2 + 1
    BRA parts                       \ 65C02 opcode
.flipped
    LDA #LO(flipped_green_pixel_table)
    STA draw_column.pix_operand
    STA draw_column.pix_operand_2
    LDA #LO(flipped_mask_table)
    STA draw_column.mask_operand
    STA draw_column.mask_operand_2
    LDA #HI(flipped_mask_table)
    STA draw_column.mask_operand + 1
    STA draw_column.mask_operand_2 + 1
.parts
    LDX dm_type                     \ part one: the animation's sprite, at the bottom
    LDA dm_frame
    CLC
    ADC mover_types_first_sprite_animation_offsets,X
    TAY
    LDA animation_table,Y
    LDY #0
    JSR ren_draw_sprite
    LDX dm_type
    LDA mover_types_parts,X
    CMP #&02
    BCS nothing                     \ one part
    LDA dm_frame                    \ part two: raised by sprites_y_offset
    ADC mover_types_second_sprite_offset,X    \ (C clear)
    TAY
    LDA sprites_y_offset,Y
    STA dm_raise
    TXA
    CLC
    ADC #&1C                        \ the second parts' mover types
    TAX
    LDA dm_frame
    CLC
    ADC mover_types_first_sprite_animation_offsets,X
    TAY
    LDA animation_table,Y
    LDY dm_raise
    JSR mark_part2
    JSR ren_draw_sprite
    LDX dm_type
    LDA mover_types_parts,X
    BNE nothing                     \ two parts
    LDA dm_raise                    \ part three: eight rows above part two
    CLC
    ADC #&08
    TAY
    LDA mover_types_third_sprite,X
    JSR mark_part3
    JSR ren_draw_sprite
.nothing
    RTS
}

\ ren_draw_sprite: A = sprite, Y = rows it is raised. Each visible column of its straight data:
\ the first row drawn and the count, then the indices top-down. Flipped, column c of n is
\ drawn at j = n - 1 - c, as the plotter walks a flipped sprite's columns backwards. The
\ column's bottom steps 8 bytes a column (back 8 when flipped), round the 16K screen; its line
\ in the character cell is the same for every column of the part (ds_line), so draw_column
\ keeps the bottom's cell (b_ptr) and raises from there.
.ren_draw_sprite
{
    STY ds_raise
    TAX
    STX ds_sprite
    LDA straight_sprite_hi,X
    BNE known
    RTS                             \ an unused table entry
.known
    STA col_ptr + 1
    LDA straight_sprite_lo,X
    STA col_ptr
    LDA sprite_column_count,X
    STA ds_c                        \ columns left
    STA ds_n
    STZ ds_clip                     \ 65C02 opcode: whether any column can be clipped: not if
    LDA dm_jmin                     \ jmin is 0 and jmax n - 1 or more
    BNE clips
    LDA dm_jmax
    CMP ds_c
    BCS no_clip
.clips
    DEC ds_clip                     \ &FF
.no_clip
    LDA dm_scr_lo                   \ the part's bottom, raised once
    LDX dm_scr_hi
    LDY ds_raise
    JSR raise_address
    TAY
    AND #&07
    STA ds_line
    TYA
    AND #&F8
    STA b_ptr
    STX b_ptr + 1
    LDA dm_slot                     \ step 2 layer 4: the player's part, if it cannot be clipped,
    ORA ds_clip                     \ may be one of the kinds compiled to code
    BNE generic
    JSR compiled_part
    BCS generic                     \ not a kind, or a row that would pass &7FFF
    RTS
.generic
    BIT dm_flip
    BPL draw_column
    LDA ds_c                        \ flipped: the bottom 8 * (n - 1) on
    DEC A                           \ 65C02 opcode
    ASL A
    ASL A
    ASL A
    CLC
    ADC b_ptr
    STA b_ptr
    LDA b_ptr + 1
    ADC #0
    BPL flipped_in_ring
    SEC
    SBC #&40
.flipped_in_ring
    STA b_ptr + 1
}
    \ falls through
\ draw_column: the part's columns from col_ptr, ds_c of them, each from its bottom's cell
\ b_ptr raised by its first row. Y = the line in the character cell indexes the screen (s_ptr =
\ the cell), the data and the save block together; each cell has 8 bytes of the save block (the
\ lines it does not draw are left unused), so moving up a cell is the data 8 back, the save
\ block 8 on and the screen a character row (&280) up. Saves each screen byte, then writes
\ (byte AND mask) EOR pixel, as the plotter does with the player. Each column's record (count
\ - 1, the lowest byte's address) goes 8 bytes after the last cell before it (v_ptr + 8: v_ptr
\ is that cell's base), its cells after the record; restore_block walks them the same way.
.draw_column
{
    BRA each                        \ 65C02 opcode
.empty
    LDA col_ptr                     \ an empty column: 2 bytes
    CLC
    ADC #2
    STA col_ptr
    BCC to_next
    INC col_ptr + 1
.to_next
    JMP next
.clip_test                          \ j = n - c unflipped, c - 1 flipped (c = columns left)
    LDA ds_c
    BIT dm_flip
    BMI flipped_j
    LDA ds_n
    SEC
    SBC ds_c
    BRA have_j                      \ 65C02 opcode
.flipped_j
    DEC A                           \ 65C02 opcode
.have_j
    CMP dm_jmin
    BCC to_next                     \ left of the viewport
    STA ds_j
    LDA dm_jmax
    CMP ds_j
    BCS visible                     \ not right of it
    JMP next
.each
    LDY #1
    LDA (col_ptr),Y                 \ the count
    BEQ empty
    DEC A                           \ 65C02 opcode: count - 1, the record's and the cell loop's
    STA rows_m1
    LDY #8
    STA (v_ptr),Y                   \ the record: count - 1 (then the address)
    LDA ds_line                     \ the lowest byte's line: the part's line - the first row
    SEC                             \ drawn (below 0: a cell up for each 8)
    SBC (col_ptr)                   \ 65C02 opcode
    TAX
    LDA rows_m1                     \ col_ptr on to the next column: 2 + count bytes (the data
    SEC                             \ is found back from there)
    ADC #2
    ADC col_ptr
    STA col_ptr
    BCC on_same_page
    INC col_ptr + 1
.on_same_page
    BIT ds_clip
    BMI clip_test
.visible
    LDA b_ptr                       \ the cell of the column's bottom...
    STA s_ptr
    LDA b_ptr + 1
    STA s_ptr + 1
    TXA                             \ ...raised by its first row
    BPL raised
.up_cell
    TAX
    LDA s_ptr
    SEC
    SBC #&80
    STA s_ptr
    LDA s_ptr + 1
    SBC #&02
    CMP #&40
    BCS up_in_ring
    ADC #&40
.up_in_ring
    STA s_ptr + 1
    TXA
    CLC
    ADC #8
    BCC up_cell
.raised                             \ A = the line of the lowest byte drawn
    TAX
    ORA s_ptr                       \ the record's address
    LDY #9
    STA (v_ptr),Y
    INY
    LDA s_ptr + 1
    STA (v_ptr),Y
    LDA v_ptr                       \ the cells after it
    CLC
    ADC #11
    STA v_ptr
    BCC save_on_page
    INC v_ptr + 1
.save_on_page
    \ the data: the byte for line Y of the first cell is data[count - 1 - (line - Y)], so
    \ d_ptr = the column + 2 + count - 1 - line = col_ptr - 1 - line = col_ptr + (line EOR &FF) - &100
    TXA
    TAY                             \ Y = the line
    EOR #&FF
    CLC
    ADC col_ptr
    STA d_ptr
    LDA col_ptr + 1
    ADC #&FF
    STA d_ptr + 1
.cell                               \ Y = the line it starts on: does the column end in this cell?
    TYA
    SEC
    SBC rows_m1                     \ line - (rows left - 1)
    BCS last_cell                   \ 0 or more: it ends here
    EOR #&FF                        \ no: rows left after this cell, less 1: rows - line - 2
    STA rows_m1
.byte                               \ down to line 0
    LDA (d_ptr),Y                   \ the pixel/mask index
    TAX
    LDA (s_ptr),Y
    STA (v_ptr),Y                   \ saved
mask_operand = * + 1
    AND &FFFF,X                     \ self-modified: the mask table for the flip
pix_operand = * + 1
    EOR &FFFF,X                     \ self-modified: the pixel table for the colour and flip
    STA (s_ptr),Y
    DEY
    BPL byte
    LDA d_ptr                       \ the next cell: the data 8 back...
    SEC
    SBC #8
    STA d_ptr
    BCS data_same_page
    DEC d_ptr + 1
.data_same_page
    LDA v_ptr                       \ ...the save block 8 on...
    CLC
    ADC #8
    STA v_ptr
    BCC save_same_page
    INC v_ptr + 1
.save_same_page
    LDA s_ptr                       \ ...the screen a character row up, round the 16K...
    SEC
    SBC #&80
    STA s_ptr
    LDA s_ptr + 1
    SBC #&02
    CMP #&40
    BCS in_ring
    ADC #&40
.in_ring
    STA s_ptr + 1
    LDY #7                          \ ...from its bottom line
    BRA cell                        \ 65C02 opcode
.last_cell                          \ A = line - rows left + 1: the last line drawn
    DEC A                           \ 65C02 opcode: the line below it
    STA stop_y
.part_byte
    LDA (d_ptr),Y
    TAX
    LDA (s_ptr),Y
    STA (v_ptr),Y
mask_operand_2 = * + 1
    AND &FFFF,X                     \ self-modified, as mask_operand
pix_operand_2 = * + 1
    EOR &FFFF,X                     \ self-modified, as pix_operand
    STA (s_ptr),Y
    DEY
    CPY stop_y
    BNE part_byte
.next                               \ v_ptr: this column's last cell (the next record 8 on)
    DEC ds_c
    BEQ done
    BIT dm_flip                     \ the next column's bottom
    BMI step_back
    LDA b_ptr
    CLC
    ADC #8
    STA b_ptr
    BCC to_each
    LDA b_ptr + 1
    INC A                           \ 65C02 opcode
    BPL forward_in_ring
    LDA #&40
.forward_in_ring
    STA b_ptr + 1
    JMP each
.step_back
    LDA b_ptr
    SEC
    SBC #8
    STA b_ptr
    BCS to_each
    LDA b_ptr + 1
    DEC A                           \ 65C02 opcode
    CMP #&40
    BCS back_in_ring
    LDA #&7F
.back_in_ring
    STA b_ptr + 1
.to_each
    JMP each
.done
    RTS
}

.compiled_direct                    \ a kind in HAZEL: no bank to page
    JMP (compiled_vec)

\ compiled_part: the player's part (not clipped) as code, if its sprite, flip and line are one of
\ tools/compiled.py's kinds: the kind's code in its bank (through compiled_call), from the
\ part's bottom left cell (b_ptr), and an entry in the save block for restore_block: 11 bytes
\ as a column's record and cell, with count - 1 = &FF and the kind, then that cell's address.
\ Carry clear if drawn; set if not a kind, or if a row would run past &7FFF (nothing drawn: b_ptr
\ and ds_c are as the generic path wants them).
.compiled_part
{
    LDA dm_flip
    AND #&80
    ORA ds_line
    LDX #COMPILED_KINDS - 1
.search
    CMP ck_flipline,X
    BNE next
    LDY ck_sprite,X
    CPY ds_sprite
    BEQ found
.next
    DEX
    BPL search
    SEC
    RTS
.found
    STX ck_kind
    LDA b_ptr
    STA &C0
    LDA b_ptr + 1
    STA &C1
    LDA ck_draw_lo,X
    STA compiled_vec
    LDA ck_draw_hi,X
    STA compiled_vec + 1
    LDA ck_bank,X
    BEQ in_hazel                    \ bank 0: HAZEL, paged in through play
    LDX #&84                        \ ANDY and bank 4 again after
    JSR compiled_call
    BRA called                      \ 65C02 opcode
.in_hazel
    JSR compiled_direct
.called
    BCS unsafe
    LDY #8                          \ its entry
    LDA #&FF
    STA (v_ptr),Y
    INY
    LDA ck_kind
    STA (v_ptr),Y
    LDA v_ptr
    CLC
    ADC #11
    STA v_ptr
    BCC on_page
    INC v_ptr + 1
.on_page
    LDA &C0
    STA (v_ptr)                     \ 65C02 opcode
    LDY #1
    LDA &C1
    STA (v_ptr),Y
    CLC
    RTS
.unsafe                             \ the code's row pointers used b_ptr and ds_c
    LDA &C0
    STA b_ptr
    LDA &C1
    STA b_ptr + 1
    LDA ds_n
    STA ds_c
    SEC
    RTS
}

\ up_a_cell: AX = a character cell's top line; returns AX = the bottom line of the cell above
\ (&279 lower, round the 16K screen), as the plotter moves up a group.
.up_a_cell
{
    SEC
    SBC #&79
    PHA
    TXA
    SBC #&02
    CMP #&40
    BCS in_ring
    ADC #&40
.in_ring
    TAX
    PLA
    RTS
}

\ raise_address: AX up Y rows (Y may be 0). A row up is one byte lower inside a cell; from a
\ cell's top line it is the cell above's bottom line.
.raise_address
{
    STX ra_hi                       \ RAM for cycles 4: in one step, not a cell at a time
    STA ra_lo
    STY ra_rows
    AND #&07                        \ the line in the cell
    CMP ra_rows
    BCC up
    LDA ra_lo                       \ it stays in the cell
    SEC
    SBC ra_rows
    LDX ra_hi
    RTS
.up                                 \ d = rows - line - 1: 0 is the cell above's bottom line
    EOR #&FF
    CLC
    ADC ra_rows
    TAY
    AND #&07
    EOR #&07                        \ the line it ends on: 7 - (d AND 7)
    STA ra_rows
    LDA ra_lo
    AND #&F8
    ORA ra_rows
    STA ra_lo
    TYA
    LSR A
    LSR A
    LSR A
    TAY                             \ cells up, less 1
    LDA ra_lo
    SEC
    SBC raise_cells_lo,Y
    STA ra_lo
    LDA ra_hi
    SBC raise_cells_hi,Y
    CMP #&40                        \ round the 16K screen
    BCS in_ring
    ADC #&40
.in_ring
    TAX
    LDA ra_lo
    RTS
}
.raise_cells_lo                     \ (n + 1) character rows: (n + 1) * &280
    EQUB &80, &00, &80, &00, &80, &00, &80, &00
.raise_cells_hi
    EQUB &02, &05, &07, &0A, &0C, &0F, &11, &14

\ ---- taking a mover off ------------------------------------------------------------------
\ restore_block: Y = slot + boff. Its save block, a part at a time from the last (parts of one
\ mover can overlap, so the bytes the later part saved go back first); within a part, its columns
\ in any order (they never overlap): each record (count - 1, address) and the cells after it, put
\ back on the screen as draw_column took them, walked as draw_column wrote them (v_ptr the last
\ cell before, the record at v_ptr + 8). Frees the block, popping the arena if it was the last.
.restore_block
{
    STY rb_index
    LDA save_start_lo,Y             \ the header: where parts 2 and 3 start
    STA v_ptr
    LDA save_start_hi,Y
    STA v_ptr + 1
    LDY #3
.header
    LDA (v_ptr),Y
    STA rb_part2,Y
    DEY
    BPL header
    LDY rb_index                    \ the walk ends when v_ptr + 8 is the block's end
    LDA save_end_lo,Y
    SEC
    SBC #8
    STA rb_end
    LDA save_end_hi,Y
    SBC #0
    STA rb_end + 1
    LDX #2                          \ part 3, then part 2: from its start to rb_end
.each_part
    LDA rb_part2,X
    ORA rb_part2 + 1,X
    BEQ no_part
    LDY rb_index                    \ v_ptr = its start - 8
    LDA save_start_lo,Y
    CLC
    ADC rb_part2,X
    STA rb_p8
    LDA save_start_hi,Y
    ADC rb_part2 + 1,X
    STA rb_p8 + 1
    LDA rb_p8
    SEC
    SBC #8
    STA rb_p8
    STA v_ptr
    LDA rb_p8 + 1
    SBC #0
    STA rb_p8 + 1
    STA v_ptr + 1
    PHX
    JSR columns
    PLX
    LDA rb_p8                       \ the part before ends where this one starts
    STA rb_end
    LDA rb_p8 + 1
    STA rb_end + 1
.no_part
    DEX
    DEX
    BPL each_part
    LDY rb_index                    \ part 1: after the header, v_ptr = the start + 4 - 8
    LDA save_start_lo,Y
    SEC
    SBC #4
    STA v_ptr
    LDA save_start_hi,Y
    SBC #0
    STA v_ptr + 1
    JSR columns
    LDY rb_index
    JMP blocks_done
.columns                            \ the columns from v_ptr + 8 to rb_end + 8
    LDA v_ptr
    CMP rb_end
    BNE more
    LDA v_ptr + 1
    CMP rb_end + 1
    BNE more
    RTS
.more
    LDY #10                         \ the record
    LDA (v_ptr),Y
    STA s_ptr + 1
    DEY
    LDA (v_ptr),Y
    TAX                             \ the address's low byte
    DEY
    LDA (v_ptr),Y
    BMI compiled                    \ &FF: a compiled part (ren_draw_sprite), X = its kind
    STA rows_m1                     \ count - 1
    LDA v_ptr                       \ the cells after it
    CLC
    ADC #11
    STA v_ptr
    BCC cells_on_page
    INC v_ptr + 1
.cells_on_page
    TXA
    AND #&F8
    STA s_ptr
    TXA
    AND #&07
    TAY
.cell                               \ as draw_column: does the column end in this cell?
    TYA
    SEC
    SBC rows_m1
    BCS last_cell
    EOR #&FF
    STA rows_m1
.byte
    LDA (v_ptr),Y
    STA (s_ptr),Y
    DEY
    BPL byte
    LDA v_ptr                       \ the next cell: the save block 8 on...
    CLC
    ADC #8
    STA v_ptr
    BCC save_same_page
    INC v_ptr + 1
.save_same_page
    LDA s_ptr                       \ ...the screen a character row up, round the 16K
    SEC
    SBC #&80
    STA s_ptr
    LDA s_ptr + 1
    SBC #&02
    CMP #&40
    BCS in_ring
    ADC #&40
.in_ring
    STA s_ptr + 1
    LDY #7
    BRA cell                        \ 65C02 opcode
.last_cell
    DEC A                           \ 65C02 opcode
    STA stop_y
.part_byte
    LDA (v_ptr),Y
    STA (s_ptr),Y
    DEY
    CPY stop_y
    BNE part_byte
    JMP columns
.compiled                           \ its entry: the kind, then the part's bottom left cell
    LDA v_ptr
    CLC
    ADC #11
    STA v_ptr
    BCC kind_on_page
    INC v_ptr + 1
.kind_on_page
    LDA (v_ptr)                     \ 65C02 opcode
    STA &C0
    LDY #1
    LDA (v_ptr),Y
    STA &C1
    LDA ck_restore_lo,X
    STA compiled_vec
    LDA ck_restore_hi,X
    STA compiled_vec + 1
    LDA ck_bank,X
    BEQ in_hazel                    \ bank 0: HAZEL
    LDX #&04                        \ bank 4 again after
    JSR compiled_call
    JMP columns
.in_hazel
    JSR compiled_direct
    JMP columns
.blocks_done
    LDX back                        \ the block is free; the arena shrinks if it was the last
    LDA save_end_lo,Y
    CMP arena_top_lo,X
    BNE freed
    LDA save_end_hi,Y
    CMP arena_top_hi,X
    BNE freed
    LDA save_start_lo,Y
    STA arena_top_lo,X
    LDA save_start_hi,Y
    STA arena_top_hi,X
.freed
    LDA #0
    STA save_start_hi,Y
    RTS
}

\ compact: slide this screen's live save blocks down to the start of its arena, in address
\ order, and point arena_top after them. Blocks are only bytes, so they move freely. Each is
\ moved once (a mover drawn wholly clipped has an empty block, which can share its start
\ with the next: picking blocks by address alone picked it for ever).
.compact
{
    LDA #LO(save_arena)
    STA cp_cursor_lo
    LDA #HI(save_arena)
    STA cp_cursor_hi
    LDX #MOVER_SLOTS - 1            \ none moved yet
.not_moved
    STZ cp_moved,X                  \ 65C02 opcode
    DEX
    BPL not_moved
.next_block
    LDA #&FF                        \ the lowest live block not yet moved (an empty one, start =
    STA cp_best                     \ end, is moved once too: it may share its start)
    STA cp_best_lo
    STA cp_best_hi
    LDX #0
.scan
    LDA cp_moved,X
    BNE skip
    TXA
    CLC
    ADC boff
    TAY
    LDA save_start_hi,Y
    BEQ skip                        \ none
    LDA save_start_lo,Y             \ below the best so far?
    CMP cp_best_lo
    LDA save_start_hi,Y
    SBC cp_best_hi
    BCS skip
    STY cp_best
    STX cp_best_slot
    LDA save_start_lo,Y
    STA cp_best_lo
    LDA save_start_hi,Y
    STA cp_best_hi
.skip
    INX
    CPX #MOVER_SLOTS
    BNE scan
    LDY cp_best
    CPY #&FF
    BEQ all_moved
    LDX cp_best_slot
    INC cp_moved,X
    LDA save_start_lo,Y             \ move [start, end) to the cursor, upwards in address
    STA v_ptr
    LDA save_start_hi,Y
    STA v_ptr + 1
    LDA cp_cursor_lo
    STA s_ptr
    LDA cp_cursor_hi
    STA s_ptr + 1
    LDA save_end_lo,Y
    SEC
    SBC save_start_lo,Y
    STA cp_len_lo
    LDA save_end_hi,Y
    SBC save_start_hi,Y
    STA cp_len_hi
    LDA cp_cursor_lo
    STA save_start_lo,Y
    CLC
    ADC cp_len_lo
    STA save_end_lo,Y
    STA cp_next_lo
    LDA cp_cursor_hi
    STA save_start_hi,Y
    ADC cp_len_hi
    STA save_end_hi,Y
    STA cp_next_hi
    LDY #0
.move
    LDA cp_len_lo
    ORA cp_len_hi
    BEQ moved
    LDA (v_ptr),Y
    STA (s_ptr),Y
    INY
    BNE counted
    INC v_ptr + 1
    INC s_ptr + 1
.counted
    LDA cp_len_lo
    BNE len_low
    DEC cp_len_hi
.len_low
    DEC cp_len_lo
    BRA move                        \ 65C02 opcode
.moved
    LDA cp_next_lo
    STA cp_cursor_lo
    LDA cp_next_hi
    STA cp_cursor_hi
    JMP next_block
.all_moved
    LDX back
    LDA cp_cursor_lo
    STA arena_top_lo,X
    LDA cp_cursor_hi
    STA arena_top_hi,X
    RTS
}

\ ---- records -----------------------------------------------------------------------------
\ X = slot (the live tables), Y = slot + boff (the records)
.record_differs                     \ Z clear if the record and the live slot differ; keeps X, Y
{
    LDA rec_type,Y
    CMP movers_type_and_colour,X
    BNE out
    LDA rec_frame,Y
    CMP movers_frame_and_flip,X
    BNE out
    LDA rec_xl,Y
    CMP movers_x_low,X
    BNE out
    LDA rec_xh,Y
    CMP movers_x_high,X
    BNE out
    LDA rec_y,Y
    CMP movers_y,X
    BNE out
    LDA rec_sl,Y
    CMP movers_screen_address_low,X
    BNE out
    LDA rec_sh,Y
    CMP movers_screen_address_high,X
.out
    RTS
}

.record_live                        \ the live slot is now what this screen shows
    LDA movers_type_and_colour,X
    STA rec_type,Y
    LDA movers_frame_and_flip,X
    STA rec_frame,Y
    LDA movers_x_low,X
    STA rec_xl,Y
    LDA movers_x_high,X
    STA rec_xh,Y
    LDA movers_y,X
    STA rec_y,Y
    LDA movers_screen_address_low,X
    STA rec_sl,Y
    LDA movers_screen_address_high,X
    STA rec_sh,Y
    STY rl_index                    \ and where that is in the world (BUGS #7): the view in
    LDA movers_screen_address_low,X \ zero page is this screen's now
    PHA
    LDA movers_screen_address_high,X
    TAX
    PLA
    JSR world_of_address
    LDY rl_index
    LDA wa_x_lo
    STA rec_wxl,Y
    LDA wa_x_hi
    STA rec_wxh,Y
    LDA wa_y
    STA rec_wy,Y
    RTS

\ world_of_address: AX = a screen address; wa_x (16 bits) and wa_y = the world column and the y
\ (movers_y's sense: &C7 at the top row) of that byte, by the view in zero page (its screen
\ start and viewport_left). A character row is &280 bytes: the row is guessed from the offset's
\ high byte (wa_rows_guess, out by at most one) and settled against wa_rows_base.
.world_of_address
{
    SEC
    SBC screen_start_address_low
    STA wa_off
    TXA
    SBC screen_start_address_high
    AND #&3F                        \ round the 16K screen
    STA wa_off + 1
    TAX
    LDY wa_rows_guess,X
    LDA wa_off                      \ at or past the next row's start: that row
    CMP wa_rows_base_lo + 1,Y
    LDA wa_off + 1
    SBC wa_rows_base_hi + 1,Y
    BCC row_known
    INY
.row_known
    LDA wa_off                      \ the column: (offset - the row's start) / 8
    SEC
    SBC wa_rows_base_lo,Y
    STA wa_t
    LDA wa_off + 1
    SBC wa_rows_base_hi,Y
    LSR A
    ROR wa_t
    LSR A
    ROR wa_t
    LSR A
    ROR wa_t
    LDA wa_t
    CLC
    ADC viewport_left_low
    STA wa_x_lo
    LDA viewport_left_high
    ADC #0
    STA wa_x_hi
    TYA                             \ the line from the top: row * 8 + the line in the cell
    ASL A
    ASL A
    ASL A
    STA wa_t
    LDA wa_off
    AND #&07
    ORA wa_t
    EOR #&FF                        \ y = &C7 - that
    SEC
    ADC #&C7
    STA wa_y
    RTS
}
.wa_rows_guess                      \ by the offset's high byte h: floor(h * 256 / &280)
FOR h = 0..63
    EQUB (h * 256) DIV &280
NEXT
.wa_rows_base_lo                    \ the start of character row k: k * &280
FOR k = 0..26
    EQUB LO(k * &280)
NEXT
.wa_rows_base_hi
FOR k = 0..26
    EQUB HI(k * &280)
NEXT

\ ---- the renderer's variables (bank 4 is RAM) ----------------------------------------------
.back           EQUB 0              \ the screen being drawn: 0 main, 1 shadow
.acc_main       EQUB 0              \ ACCCON with the CPU on main RAM, and on shadow
.acc_shadow     EQUB 0
.boff           EQUB 0              \ 64 * back
.hist_next      EQUB 0              \ the history slot written next
.hist_seq       EQUB 0              \ pushes so far
.last_vl_lo     EQUB 0
.last_vl_hi     EQUB 0
.hist_edge_lo   EQUB 0, 0
.hist_edge_hi   EQUB 0, 0
.hist_ss_lo     EQUB 0, 0
.hist_ss_hi     EQUB 0, 0
.hist_crtc_lo   EQUB 0, 0
.hist_crtc_hi   EQUB 0, 0
.hist_vl_lo     EQUB 0, 0
.hist_vl_hi     EQUB 0, 0
.hist_vr_lo     EQUB 0, 0
.hist_vr_hi     EQUB 0, 0
.hist_dir       EQUB 0, 0
.hist_seqs      EQUB 0, 0
\ per screen (0, 1), and slot 2 for the logic's live view while a screen is drawn
.buf_seq        EQUB 0, 0
.buf_lives      EQUB 0, 0
.buf_ss_lo      EQUB 0, 0, 0
.buf_ss_hi      EQUB 0, 0, 0
.buf_crtc_lo    EQUB 0, 0, 0
.buf_crtc_hi    EQUB 0, 0, 0
.buf_vl_lo      EQUB 0, 0, 0
.buf_vl_hi      EQUB 0, 0, 0
.buf_vr_lo      EQUB 0, 0, 0
.buf_vr_hi      EQUB 0, 0, 0
.pending_n      EQUB 0
.pending_slot   EQUB 0, 0
.lives_redraw   EQUB 0
.zone_n         EQUB 0
.zone_lo        SKIP 12
.zone_hi        SKIP 12
.zone_tmp_lo    EQUB 0
.zone_tmp_hi    EQUB 0
.zone_count     EQUB 0
.span_x_lo      EQUB 0
.span_x_hi      EQUB 0
.span_w2        EQUB 0
.span_d         EQUB 0, 0
.ren_i          EQUB 0
.ren_k          EQUB 0
.need           SKIP MOVER_SLOTS
\ the masked renderer's
.arena_top_lo   EQUB 0, 0           \ per screen: the end of its arena's used part
.arena_top_hi   EQUB 0, 0
.list_n         EQUB 0
.act_n          EQUB 0
.act            SKIP MOVER_SLOTS
.list_b         EQUB 0
.list_changed   EQUB 0
.list_type      EQUB 0
.list_x_lo      EQUB 0
.list_x_hi      EQUB 0
.list_y         EQUB 0
.list_slot      SKIP MOVER_SLOTS + 1
.list_x1_lo     SKIP MOVER_SLOTS + 1
.list_x1_hi     SKIP MOVER_SLOTS + 1
.list_x2_lo     SKIP MOVER_SLOTS + 1
.list_x2_hi     SKIP MOVER_SLOTS + 1
.list_y1        SKIP MOVER_SLOTS + 1
.list_y2        SKIP MOVER_SLOTS + 1
.dm_slot        EQUB 0
.rl_index       EQUB 0
.wa_off         EQUB 0, 0
.wa_t           EQUB 0
.wa_x_lo        EQUB 0
.wa_x_hi        EQUB 0
.wa_y           EQUB 0
.dm_index       EQUB 0
.dm_typecol     EQUB 0
.dm_type        EQUB 0
.dm_flip        EQUB 0
.dm_frame       EQUB 0
.dm_scr_lo      EQUB 0
.dm_scr_hi      EQUB 0
.dm_jmin        EQUB 0
.dm_jmax        EQUB 0
.dm_raise       EQUB 0
.ds_raise       EQUB 0
.ds_sprite      EQUB 0              \ the part's sprite
.ck_kind        EQUB 0              \ compiled_part: the kind found
.ds_n           EQUB 0
.ds_j           EQUB 0
.ds_fr          EQUB 0
.ds_clip        EQUB 0
.ra_rows        EQUB 0
.ra_lo          EQUB 0
.ra_hi          EQUB 0
.rb_index       EQUB 0
.rb_part2       EQUB 0, 0           \ the header: part 2's start, part 3's (offsets)
.rb_part3       EQUB 0, 0
.rb_end         EQUB 0, 0
.rb_p8          EQUB 0, 0
.cp_cursor_lo   EQUB 0
.cp_cursor_hi   EQUB 0
.cp_best        EQUB 0
.cp_best_slot   EQUB 0
.cp_moved       SKIP MOVER_SLOTS
.cp_best_lo     EQUB 0
.cp_best_hi     EQUB 0
.cp_len_lo      EQUB 0
.cp_len_hi      EQUB 0
.cp_next_lo     EQUB 0
.cp_next_hi     EQUB 0
.render_end
ASSERT render_end <= REN_BASE
