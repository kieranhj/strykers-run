\ prebuild.6502 - step 2 layer 3, RAM for cycles item 1 (docs/briefs/step2-layer3-ram-for-cycles.md):
\ the next scroll's column, built while the renderer waits for the flip.
\
\ In bank 4 below &9000 (DATA1, after the scenery): ANDY covers this whenever the renderer draws
\ (ROMSEL &84), so it runs only with ROMSEL &04 - from render, before it waits, and from the
\ scroll's install_prebuilt (src/game.6502), which pages bank 4 to call it.
\
\ After a scroll has been pushed to the history, the next wait (if the flip is far enough off) runs
\ the 8 layers' walk for the same direction on the real state, into column_buffer, keeps the state
\ it leaves, and puts the state back as it was. The next scroll, if it is in that direction from the
\ same viewport, keeps the column and takes that state instead of clearing and walking
\ (start_column, install_prebuilt). Nothing else changes the layers' state between scrolls, and the
\ walk's only inputs are that state, the edges' low bytes (set here as the scroll will set them)
\ and the scenery data. column_buffer is free once its column is pushed: a push with no scroll
\ since the last one (the original's, after a hostile collision) takes the last column from its
\ history slot, which holds the same bytes (history_push). The walk never writes above row 192 (a
\ cloud 170 rows up, 23 high: the scenery data, 2026-10-17), inside the 200-byte buffer.
\
\ Zero page, measured (2026-10-17, 3 x 20,000 frames): the walk writes the 16 bytes in pre_zp_list
\ and &F4; the logic reads none of them after a walk before writing it, so the scroll need not set
\ them; and the walk reads none before writing it but &B9, &C8/&C9 - see "usable?" below.

PRE_LAYERS = scenery_layer_sprite_banks   \ the layers' state: 7 tables of 8 and unused_variable
PRE_LAYERS_N = scenery_layer_addresses_low + 8 - scenery_layer_sprite_banks
ASSERT PRE_LAYERS_N = 57
PRE_HIGH = scenery_layer_sprite_addresses_high - scenery_layer_sprite_banks   \ 0: a layer is idle
PRE_LOW = scenery_layer_sprite_addresses_low - scenery_layer_sprite_banks
ASSERT PRE_LOW = PRE_HIGH + 8
PRE_ZP_N = 16
PRE_T2_MIN = &D6                    \ one field to go: start only if User VIA T2's high byte is at
                                    \ least this (about 9,000 us of the field left; a prebuild
                                    \ takes about 2,500)

.pre_zp_list                        \ the zero page the walk writes (measured)
    EQUB &A7, &B4, &B5, &B7, &B8, &B9, &C8, &C9, &CB, &CC, &CD, &CE, &CF, &D0, &F8, &F9
.pre_old_layers SKIP PRE_LAYERS_N
.pre_new_layers SKIP PRE_LAYERS_N
.pre_old_y      SKIP 8
.pre_new_y      SKIP 8
.pre_old_zp     SKIP PRE_ZP_N
.pre_old_ops    SKIP 4              \ the walk's two flip opcodes, plot_scenery_mask_opcode and its
.pre_new_ops    SKIP 4              \ operand
.pre_old_view   SKIP 2              \ viewport_left_low, viewport_right_low
.pre_first      SKIP 1
.pre_more       SKIP 1              \ non-zero: more of the state changed than the sprite addresses
.pre_hist       SKIP 1              \ item 3: 1 + the history slot holding rows 24-199 of the column,
                                    \ 0 none (history_push)

\ prebuild: render calls this before it waits for the flip
.prebuild
{
    LDA pre_valid
    ORA col_fresh
    BNE out                         \ built (or found unusable) since the last scroll, or the last
                                    \ column is still to be pushed
    LDX last_dir
    BEQ out                         \ no scroll yet this game
    BIT flip_pending
    BPL out                         \ the flip has been: nothing to wait for
    LDA flip_target                 \ fields to the flip: 2, or 1 and the rest of this one
    SEC
    SBC field_count
    CMP #2
    BCS time
    LDA usrvia_t2ch                 \ T2 counts down from &FFFF at each vsync, at 1 MHz
    CMP #PRE_T2_MIN
    BCS time
.out
    RTS
.time
    LDX #PRE_LAYERS_N - 1           \ keep everything the walk changes
.save_layers
    LDA PRE_LAYERS,X
    STA pre_old_layers,X
    DEX
    BPL save_layers
    LDX #7
.save_y
    LDA scenery_layers_y_positions,X
    STA pre_old_y,X
    DEX
    BPL save_y
    LDX #PRE_ZP_N - 1
.save_zp
    LDY pre_zp_list,X
    LDA &0000,Y
    STA pre_old_zp,X
    DEX
    BPL save_zp
    LDA use_flipped_or_unflipped_scenery_sprite_opcode_one
    STA pre_old_ops
    LDA use_flipped_or_unflipped_scenery_sprite_opcode_two
    STA pre_old_ops + 1
    LDA plot_scenery_mask_opcode
    STA pre_old_ops + 2
    LDA plot_scenery_mask_opcode + 1
    STA pre_old_ops + 3
    LDA viewport_left_low           \ the edges as the scroll will move them: the walk reads only
    STA pre_old_view                \ their low bytes (&00B2,Y)
    CLC
    ADC last_dir
    STA viewport_left_low
    LDA viewport_right_low
    STA pre_old_view + 1
    CLC
    ADC last_dir
    STA viewport_right_low
    JSR initialise_column_buffer    \ main RAM, as the scroll starts
    LDX last_dir
    JSR prebuild_layers             \ main RAM: the walk; bank 4 again after, pre_bank what it left

    LDX #PRE_LAYERS_N - 1           \ keep what the walk left, put the state back, and note
    LDA #0                          \ whether more changed than the sprite addresses
    STA pre_more
.keep_layers
    LDA PRE_LAYERS,X
    STA pre_new_layers,X
    CPX #PRE_HIGH
    BCC compare
    CPX #PRE_LOW + 8
    BCC restore                     \ the sprite addresses: the scroll always takes them
.compare
    CMP pre_old_layers,X
    BEQ restore
    INC pre_more                    \ (counted: the new value may be 0)
.restore
    LDA pre_old_layers,X
    STA PRE_LAYERS,X
    DEX
    BPL keep_layers
    LDX #7
.keep_y
    LDA scenery_layers_y_positions,X
    STA pre_new_y,X
    CMP pre_old_y,X
    BEQ same_y
    INC pre_more
.same_y
    LDA pre_old_y,X
    STA scenery_layers_y_positions,X
    DEX
    BPL keep_y
    LDX #PRE_ZP_N - 1
.keep_zp
    LDY pre_zp_list,X
    LDA pre_old_zp,X
    STA &0000,Y
    DEX
    BPL keep_zp
    LDA use_flipped_or_unflipped_scenery_sprite_opcode_one
    STA pre_new_ops
    LDA use_flipped_or_unflipped_scenery_sprite_opcode_two
    STA pre_new_ops + 1
    LDA plot_scenery_mask_opcode
    STA pre_new_ops + 2
    LDA plot_scenery_mask_opcode + 1
    STA pre_new_ops + 3
    LDA pre_old_ops
    STA use_flipped_or_unflipped_scenery_sprite_opcode_one
    LDA pre_old_ops + 1
    STA use_flipped_or_unflipped_scenery_sprite_opcode_two
    LDA pre_old_ops + 2
    STA plot_scenery_mask_opcode
    LDA pre_old_ops + 3
    STA plot_scenery_mask_opcode + 1
    LDA pre_old_view
    STA viewport_left_low
    LDA pre_old_view + 1
    STA viewport_right_low
    LDA viewport_left_low           \ for the scroll from this view
    STA pre_view_low
    LDA viewport_left_high
    STA pre_view_high

    \ usable? Not if the walk started a sprite on the edge being drawn in a layer it walked before
    \ any layer that was showing one: that first unpack reads table pointers (&B9, &C8/&C9) left by
    \ whatever ran before the scroll (the multiply, in play), which the prebuild cannot know - 3%
    \ of walks.
    LDX #7                          \ the first layer walked that was showing a sprite
.find_first
    LDA pre_old_layers + PRE_HIGH,X
    BNE first_found
    DEX
    BPL find_first
.first_found
    STX pre_first
    LDX #7
.check_started
    CPX pre_first
    BEQ usable                      \ (X = &FF ends it too: pre_first is &FF if none)
    LDA pre_new_layers + PRE_HIGH,X
    BEQ check_next                  \ still idle
    CPX #4                          \ started: C set on the right edge's layers
    LDA last_dir                    \ 1 right, &FF left
    BCC left_layer
    CMP #1
    BEQ unusable                    \ a right layer, drawn on a right scroll
    BNE check_next
.left_layer
    CMP #&FF
    BEQ unusable                    \ a left layer, drawn on a left scroll
.check_next
    DEX
    BPL check_started
    BMI usable                      \ always
.unusable
    LDA #&80                        \ tried: nothing to use until the next scroll
    STA pre_valid
    RTS
.usable
    LDA last_dir
    STA pre_valid                   \ built for this direction
    \ Item 3: rows 24-199 of the column (the ground's 24 rows are the scroll's) straight into the
    \ history slot the push will fill, if neither screen still needs what it holds: a screen at
    \ most one push behind needs only the newest slot (render's pending columns).
    LDA hist_seq
    SEC
    SBC buf_seq
    CMP #2
    BCS no_copy
    LDA hist_seq
    SEC
    SBC buf_seq + 1
    CMP #2
    BCC slot_free
.no_copy
    RTS
.slot_free
    LDX hist_next
    LDA hist_dst_hi,X
    STA pc_dst1 + 2
    STA pc_dst2 + 2
    STA pc_dst3 + 2
    STA pc_dst4 + 2
    STA pc_dst5 + 2
    STA pc_dst6 + 2
    STA pc_dst7 + 2
    STA pc_dst8 + 2
    LDX #200
.pc_copy
    LDA column_buffer - 1,X
.pc_dst1
    STA hist0 - 1,X
    LDA column_buffer - 2,X
.pc_dst2
    STA hist0 - 2,X
    LDA column_buffer - 3,X
.pc_dst3
    STA hist0 - 3,X
    LDA column_buffer - 4,X
.pc_dst4
    STA hist0 - 4,X
    LDA column_buffer - 5,X
.pc_dst5
    STA hist0 - 5,X
    LDA column_buffer - 6,X
.pc_dst6
    STA hist0 - 6,X
    LDA column_buffer - 7,X
.pc_dst7
    STA hist0 - 7,X
    LDA column_buffer - 8,X
.pc_dst8
    STA hist0 - 8,X
    TXA
    SEC
    SBC #8
    TAX
    CMP #24
    BNE pc_copy
    LDX hist_next
    INX
    STX pre_hist
    RTS
}

\ put_prebuilt_state: install_prebuilt, in place of the walk: the state the prebuild's walk left
\ (the zero page it wrote is not read before it is written again: not set). A = the bank it left
\ paged.
.put_prebuilt_state
{
    FOR n = 0..15
        LDA pre_new_layers + PRE_HIGH + n
        STA PRE_LAYERS + PRE_HIGH + n
    NEXT
    LDA pre_more
    BEQ ops
    LDX #PRE_LAYERS_N - 1
.layers_loop
    LDA pre_new_layers,X
    STA PRE_LAYERS,X
    DEX
    BPL layers_loop
    LDX #7
.y_loop
    LDA pre_new_y,X
    STA scenery_layers_y_positions,X
    DEX
    BPL y_loop
.ops
    LDA pre_new_ops
    STA use_flipped_or_unflipped_scenery_sprite_opcode_one
    LDA pre_new_ops + 1
    STA use_flipped_or_unflipped_scenery_sprite_opcode_two
    LDA pre_new_ops + 2
    STA plot_scenery_mask_opcode
    LDA pre_new_ops + 3
    STA plot_scenery_mask_opcode + 1
    LDA pre_bank
    RTS
}
