\ zp.6502 - zero page names and fixed workspace outside the program.
\
\ Created once by tools/disasm2baron.py from the disassembly's operand comments: the game
\ reuses zero page freely, so one address often has several names, each the one the
\ disassembly uses in that routine. Hand-maintained from here on.

\ ---- zero page ----
screen_start_address                         = &00
screen_start_address_low                     = &00
screen_start_address_high                    = &01
count                                        = &02
mover_to_update                              = &03
unused                                       = &03
\ GAMEPLAY_SHIELD (decision 44, src/shield.6502): &07-&0F, the dead unpacker's bytes, read by
\ nothing in a game since BUGS #1's fix (tools/zpwatch.mjs: no access in a game, 2026-10-20)
shield                                       = &07      \ 0-SHIELD_FULL, 1/25ths of a unit
shield_wait                                  = &08      \ passes left before it refills
shield_flash                                 = &09      \ passes left of the bar's flash
hud_serial                                   = &0A      \ bumped when hud_buffer changes: the renderer redraws
hud_lives                                    = &0B      \ what hud_buffer shows: the lives,
hud_level                                    = &0C      \ the bar's filled pixels and its flash (bit 7)
hit_type                                     = &0D      \ the type the last hostile collision found
shield_ready                                 = &0E      \ 0 at a game's start (shield_new_game): set up on the first tick
shield_tmp                                   = &0F
\ GAMEPLAY_LIVES (decision 45, src/shield.6502): &10-&13, as &07-&0F
respawn_left                                 = &10      \ columns of the rewind still to go (0: none under way)
respawn_x_hi                                 = &11      \ the player's x high byte, kept while it is hidden (&FF)
invulnerable                                 = &12      \ passes left in which no hit counts
respawn_columns                              = &17      \ how far a death rewinds the view (shield_new_game)
timer_mode                                   = &18      \ decision 47: 0 off, 1 up, 2 down (shield_new_game)
time_up                                      = &19      \ decision 47: non-zero when counting down reached 0
shield_unit                                  = &1B      \ decision 50: a bullet's damage (an explosive's twice): SHIELD_FULL / the hits
shield_unit2                                 = &1C      \ twice that (shield_new_game)
shield_recharge                              = &1D      \ passes without damage before it refills (shield_new_game)
run_held                                     = &1A      \ decision 48: bit 7 set while the run key is down (check_for_player_input)
\ GAMEPLAY_TIMER (decision 47, src/timer.6502): &13-&16
timer_ready                                  = &13      \ 0 at a game's start (shield_new_game)
timer_hi                                     = &14      \ the seconds, BCD: hundreds
timer_lo                                     = &15      \ tens and units
timer_frac                                   = &16      \ passes into this second (0-24)
LIVES_START     = 3                 \ decision 45: lives at a game's start
RESPAWN_COLUMNS = 40                \ how far the view goes back: half a screen (KC, 2026-10-21; it was 80)
RESPAWN_SAFE    = 50                \ passes of invulnerability after it (2 seconds), the bar flashing
HUD_BAR_COLUMNS = 4                 \ the bar: 6 pixels in a row (KC, 2026-10-21: contiguous), then a blank column
                                    \ (it wipes the bar's last place when the view scrolls left, as the digit's 4th does)
TIMER_COLUMNS   = 7                 \ decision 47: three digits of two byte columns, then a blank one
IF GAMEPLAY_TIMER
    HUD_COLUMNS = 4 + HUD_BAR_COLUMNS + TIMER_COLUMNS   \ the lives digit's 4 byte columns, the bar's, the timer's
ELSE
    HUD_COLUMNS = 4 + HUD_BAR_COLUMNS   \ the lives digit's 4 byte columns, then the bar's
ENDIF
HUD_TIMER       = 8 * (4 + HUD_BAR_COLUMNS)   \ the timer's first byte in hud_buffer
HUD_BYTES       = 8 * HUD_COLUMNS
IF GAMEPLAY_SHIELD
    HUD_KEY            = hud_serial  \ what the renderer compares to redraw the top line's zone
    LIVES_ZONE_COLUMNS = HUD_COLUMNS \ and how many columns it covers (one range: render.6502 add_lives_zone)
ELSE
    HUD_KEY            = lives
    LIVES_ZONE_COLUMNS = 4
ENDIF
