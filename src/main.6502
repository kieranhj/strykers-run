\ main.6502 - Stryker's Run (Enhanced), BBC Master 128: the whole disc in one assembly.
\
\ One assembly so the game and the four sideways RAM banks can name each other's labels.
\ Every file the disc holds is a SECTION here. The reference build is the Stairway to Hell
\ disc (reference/sth/StrykersRun.ssd, decision 1): tools/compare.py checks each file's bytes.
\
\   baron --warn 2 -o build/strykers.ssd --title "STRYKERS RUN" --opt 2 --symbols ... src/main.6502

\ RELEASE, SHIFT, SHIFT_END and the DEBUG_ flags are -D symbols build.ps1 passes on every build;
\ a bare invocation must pass them all too.
\ The relocation test (PLAN.md Phase 2, tools/lockstep.mjs and tools/tracediff.mjs):
\   -D SHIFT=n        moves the game DOWN n bytes (assembled at &0E00 - n) and each bank's
\                     contents UP n bytes (padding at the start of the bank)
\   -D SHIFT_END=1    the control build: the game where it belongs and the banks' padding at
\                     their ends, where it moves nothing - so both discs have the same files
\                     at the same sizes and load in exactly the same time
\ The game moves down, not up, because its resident part already ends at &3FFF, under the
\ screen. &0D00 is DFS's NMI page and, at &0DF0, the paged ROMs' workspace pointers: free once
\ the stub has selected *TAPE and (test builds only) taken the ROMs out of the ROM type table.
\ Test builds once also changed two places the original was thought to depend on where its data
\ happens to be (BUGS.md #1, fixed, and #2, closed, in layer 5): no longer. SHIFT=0 is the shipping
\ build and must stay byte-identical to the reference.
GAME_DOWN = SHIFT * (1 - SHIFT_END)
\ The banks move by whole pages only (SHIFT rounded down): their music must stay page-aligned,
\ which bank5.6502 ASSERTs. So SHIFT=&40 tests the game alone at an odd offset.
PAD_START = (SHIFT AND &FF00) * (1 - SHIFT_END)
PAD_END   = (SHIFT AND &FF00) * SHIFT_END
\ Debug flags, 0 or 1, passed by build.ps1 on EVERY build (Baron cannot default a -D symbol:
\ DEFINED() is true by the pass that would define it). Every one is stamped into INFO and !BOOT.
\   DEBUG_LIVES   infinite lives (the scripted relocation test plays further)
\   DEBUG_FULLREDRAW  the renderer takes every mover off and puts it back on every pass: the
\                 oracle for its change tracking (tools/passlock.mjs, the two builds' screens)
\ Gameplay flags (decision 43), off in the shipping build, which with all of them off is the
\ original game; each changes how it plays:
\   GAMEPLAY_SHIELD  a recharging shield in place of lives as hit points (decision 44, src/shield.6502)
\   GAMEPLAY_LIVES   with it, each death a life, the view rewound to respawn (decision 45)
ASSERT GAMEPLAY_SHIELD >= GAMEPLAY_LIVES, "GAMEPLAY_LIVES needs GAMEPLAY_SHIELD"
\   GAMEPLAY_TIMER   1: a timer counting up, a bonus for speed; 2: counting down, game over at 0
\                    (decision 47, src/timer.6502; on the shield's HUD, so with GAMEPLAY_SHIELD)
ASSERT GAMEPLAY_SHIELD * 2 >= GAMEPLAY_TIMER AND GAMEPLAY_TIMER <= 2, "GAMEPLAY_TIMER (1 or 2) needs GAMEPLAY_SHIELD"
\   GAMEPLAY_OPTIONS "6 GAME RULES" on the title: the lives, the rewind, the timer (decision 46,
\                    src/options.6502; with GAMEPLAY_LIVES and GAMEPLAY_TIMER, whose settings it sets)
ASSERT GAMEPLAY_OPTIONS = 0 OR (GAMEPLAY_LIVES <> 0 AND GAMEPLAY_TIMER <> 0), "GAMEPLAY_OPTIONS needs GAMEPLAY_LIVES and GAMEPLAY_TIMER"
ASSERT SHIFT = 0 OR (GAMEPLAY_TIMER = 0 AND GAMEPLAY_OPTIONS = 0), "GAMEPLAY_TIMER and GAMEPLAY_OPTIONS do not fit the relocation test builds' banks (256 bytes smaller): build them unshifted"
\   GAMEPLAY_RUN     a run key (SHIFT): held, the player runs at a jump's speed, a column a pass
\                    (decision 48), for as long as its meter lasts (decision 52: with GAMEPLAY_SHIELD,
\                    whose game start and RAM it uses)
ASSERT GAMEPLAY_SHIELD >= GAMEPLAY_RUN, "GAMEPLAY_RUN needs GAMEPLAY_SHIELD"
\   GAMEPLAY_JUMP    the jump on UP's press, after one update's crouch, again on each landing while
\                    UP is held (decision 53); the original jumps on its release
\   GAMEPLAY_FIRE    firing on the move: the bullet out at once, one update's shooting pose, as a
\                    grenade is thrown (decision 54); the original stands still for 4 updates
\   GAMEPLAY_ARMOUR  the player's vehicles take ARMOUR_HITS hits, each a bullet's impact, before the
\                    one that wrecks them (decision 62; with GAMEPLAY_SHIELD, whose RAM it uses)
ASSERT GAMEPLAY_SHIELD >= GAMEPLAY_ARMOUR, "GAMEPLAY_ARMOUR needs GAMEPLAY_SHIELD"
ARMOUR_HITS = 3                     \ KC, 2026-10-22: "3 hits before the wreck"
GAMEPLAY_ANY = GAMEPLAY_SHIELD OR GAMEPLAY_LIVES OR GAMEPLAY_TIMER OR GAMEPLAY_OPTIONS OR GAMEPLAY_RUN OR GAMEPLAY_JUMP OR GAMEPLAY_FIRE OR GAMEPLAY_ARMOUR   \ the OR of every GAMEPLAY_ flag: their builds need not keep the main block's
                                    \ addresses, so its unexecuted padding goes (src/game.6502), room for their hooks
DEBUG_ANY = DEBUG_LIVES OR DEBUG_FULLREDRAW   \ the OR of every DEBUG_ flag (GAMEPLAY_ flags are not debug: RELEASE allows them)
\ Renderer flag, on by default (1): SKY_HELI, the enemy helicopters drawn over the sky as
\ self-erasing rectangles (decision 61, src/sky.6502); 0, decision 36's kind cache; 2, neither (a
\ control for costing). Never in the oracle: DEBUG_FULLREDRAW builds draw them as SKY_HELI=0 does.
ASSERT SKY_HELI <= 2, "SKY_HELI is 0, 1 or 2"
SKY_MODE = SKY_HELI * (1 - DEBUG_FULLREDRAW)
\ HUD_RUPTURE (decision 67, with GAMEPLAY_SHIELD): the HUD's character row a CRTC frame of its own,
\ read from HUD_ROW, drawn there once and only when it changes; no copy at every scroll
ASSERT GAMEPLAY_SHIELD >= HUD_RUPTURE, "HUD_RUPTURE needs GAMEPLAY_SHIELD (its HUD)"
HUD_ROW   = &0B80                  \ 640 bytes to &0DFF, below &3000 (one copy for both screens)
RUP_E1    = &2900 - 111 * 64 + 256 \ T1 from the vsync to the middle of the HUD's row (row 111 at &2900)
RUP_E2    = RUP_E1 + 512           \ to the middle of M's first row
RUP_K_E2  = RUP_E2 + 1             \ T1's counts from T2's at each re-arm (the + 1 as decision 65 measured)
RUP_K_PAL = &2900 + 1 - 11            \ row 111's write within the cycles it had without the rupture (tools/split.mjs)
RUP_R4_M  = &25                    \ M's vertical total: 38 rows, with H's 1 the original's 39
\ Look flag, off by default: DITHER_HILLS, the hills band's far, mid and fore ranges dithered (blue
\ 4/16, red 6/16, red 2/16) in the mountain sprites themselves (tools/ditherhills.py; an experiment,
\ branch dither-hills, KC 2026-10-22: "Cool far, warm near")
VERSION_LINE = "v0.1"
INCLUDE "../build/build_time.6502"   \ BUILD_TIME, written by tools/build_stamp.py

INCLUDE "os.6502"
INCLUDE "zp.6502"

\ ---------------------------------------------------------------------------------------------
\ MGAME: the game. Assembled at &0E00; the file loads at &1900 (below which DFS on a Model B
\ keeps its workspace) and its last bytes, run where the file put them, copy it down to &0E00.
\ The start-up code rides in the save arena's bytes (decision 33), so the file ends near &51A1.
\ ---------------------------------------------------------------------------------------------
GAME_LOAD = &1900
GAME_ORG  = &0E00 - GAME_DOWN

INCLUDE "lib/zx02depack.6502"       \ step 2 layer 4: the macro, for the tunes (src/game.6502 unpack_for_play)
SECTION MGAME, org = GAME_ORG, load = &FFFF0000 + GAME_LOAD, exec = &FFFF0000 + mgame_relocate, filename = "MGAME", cmos = TRUE
    INCLUDE "game.6502"

    \ The copy-down stub (STH's MGAME; the reference's lived at &46E0, ran at &51E0). Follows the
    \ game in the file, runs where the file put it, and copies the file down to &0E00, whole pages,
    \ itself included.
    SECTION mgame_stub, org = * - GAME_ORG + GAME_LOAD, cmos = TRUE
    .mgame_relocate
        LDA #&8C                        \ *TAPE: release the disc filing system's workspace
        JSR osbyte
    IF SHIFT
        \ Relocation test builds only (control and shifted alike): the shifted game overlays
        \ &0D00-&0DFF, whose top holds the paged ROMs' workspace pointers, so take every ROM
        \ out of the MOS's ROM type table and it offers them no service calls.
        LDX #15
        LDA #0
    .mgame_test_no_roms
        STA os_rom_type_table,X
        DEX
        BPL mgame_test_no_roms
    ENDIF
    .mgame_relocate_page
        LDY #0
    .mgame_relocate_loop
    mgame_relocate_src = * + 1
        LDA GAME_LOAD,Y
    mgame_relocate_dst = * + 1
        STA GAME_ORG,Y
        INY
        BNE mgame_relocate_loop
        INC mgame_relocate_src + 1
        INC mgame_relocate_dst + 1
        LDA mgame_relocate_dst + 1
        CMP #HI(mgame_end + &FF)        \ up to the end of the file, a whole page at a time
        BNE mgame_relocate_page
        JMP entry_point
    ENDSECTION
.mgame_end
ENDSECTION
\ MGAME loads at &1900 while the loading picture is shown from &5A80 (src/title.6502): stay below it
ASSERT mgame_end - GAME_ORG + GAME_LOAD <= &5A80, "MGAME would load over the loading picture by ", mgame_end - GAME_ORG + GAME_LOAD - &5A80

\ ---------------------------------------------------------------------------------------------
\ The sideways RAM banks. SRRUN loads each file at &1900 and copies &1900-&58FF into its bank
\ at &8000-&BFFF, so a file that starts higher in the bank (DATA2, at &8400) loads higher.
\ ---------------------------------------------------------------------------------------------
SECTION DATA1, org = &8000, load = &FFFF1900, exec = &FFFF1900, filename = "DATA1", cmos = TRUE
    SKIP PAD_START
    INCLUDE "bank4.6502"
    INCLUDE "prebuild.6502"         \ step 2 layer 3: the next column built in the wait (ROMSEL &04 only)
    INCLUDE "render_zp.6502"        \ the renderer's zero page save and restore (ROMSEL &04 only)
    INCLUDE "render_bss_zero.6502"  \ decision 32: its variables zeroed at start-up (ROMSEL &04)
IF GAMEPLAY_SHIELD
    INCLUDE "shield.6502"           \ decisions 44, 45: the shield and the respawn (the logic's: ROMSEL &04)
ENDIF
IF SKY_MODE
    INCLUDE "sky_off.6502"          \ the enemy helicopters over the sky: take_off's (ROMSEL &04)
IF GAMEPLAY_SHIELD = 0
    INCLUDE "sky_edges.6502"        \ and its edge columns (gameplay builds: at bank 4's end)
ENDIF
ENDIF
    \ step 2 layer 3: the renderer draws with ANDY paged over &8000-&8FFF, so it, its tables and
    \ its sprites start at &9000; below it, only scenery data (read by the scroll, with bank 4 alone)
    ASSERT * <= &9000 + PAD_START
    SKIP &9000 + PAD_START - *
    INCLUDE "render.6502"           \ step 2 layer 2: the renderer
    INCLUDE "sprite_columns.6502"   \ step 2 layer 3: generated by tools/sprites.py
    INCLUDE "compiled_table.6502"   \ step 2 layer 4: the player's compiled kinds (tools/compiled.py)
    INCLUDE "sprite_straight.6502"  \ step 2 layer 3: the masked renderer's sprites (and ANDY's, below)
IF GAMEPLAY_SHIELD
    INCLUDE "shield_hi.6502"        \ decisions 44-47: the HUD builder, in the room lives_digits leaves
IF SKY_MODE
    INCLUDE "sky_edges.6502"        \ the enemy helicopters over the sky: take_off's edge columns
ENDIF
ENDIF
    ASSERT * <= REN_BASE, "bank 4 overruns the renderer's workspace by ", * - REN_BASE   \ (its records would overwrite the sprites)
    SKIP PAD_END
ENDSECTION
\ decision 32: the renderer's variables, in bytes of its workspace no table uses (not in the file)
INCLUDE "render_bss.6502"

IF GAMEPLAY_SHIELD                  \ decisions 44-50: the gameplay front end in bank 5's &8000-&83FF, free
    DATA2_ORG = &8000               \ since masked drawing (the player buffer's): DATA2 loads from there
ELSE
    DATA2_ORG = &8400
ENDIF
SECTION DATA2, org = DATA2_ORG, load = &FFFF0000 + DATA2_ORG - &6700, exec = &FFFF0000 + DATA2_ORG - &6700, filename = "DATA2", cmos = TRUE
IF GAMEPLAY_SHIELD
    EQUB 0, 0, 0, 0, 0, 0, 0, 0     \ not a ROM header: the MOS looks for one in sideways RAM on BREAK
    INCLUDE "front_gameplay.6502"   \ shield_new_game and the game rules screen (start_game and the
    INCLUDE "scroll_pixel.6502"     \ the title's pixel scroller (from before the music: the scroll text's room)
IF HUD_RUPTURE
.rom_ws_save
    SKIP 16                         \ decision 67: &0DF0-&0DFF kept over a game (rupture_on/off: bank 5 paged)
ENDIF
    ASSERT * <= &8400, "bank 5's gameplay front end overruns &83FF by ", * - &8400   \ front end run with bank 5 paged)
    PRINT "bank 5 &8000-&83FF: ", &8400 - *, " bytes free"
    SKIP &8400 - *
ENDIF
    SKIP PAD_START
    INCLUDE "bank5.6502"
    \ Step 2 layer 3 (decision 25): the 50 Hz sound effect driver, run from the vsync interrupt in
    \ play with bank 5 paged in, and the game's effects (src/sfx_data.6502, from tools/sfx50.py)
    INCLUDE "lib/sfx50.6502"
    INCLUDE "sfx_data.6502"
    INCLUDE "compiled_bank5.6502"   \ step 2 layer 4: compiled kinds of the player's parts
    INCLUDE "credits.6502"          \ decision 60: the title's credit line cycling
    \ Step 2 layer 3: the sprites that live in ANDY (&8000-&8FFF, the Master's 4K that ROMSEL
    \ bit 7 pages over the first 4K of a bank), carried here and copied in at start-up
    \ (src/game.6502 initialisation). The renderer runs with ROMSEL = &84: ANDY, then bank 4.
    .andy_load
    SECTION andy_data, org = &8000, cmos = TRUE
        INCLUDE "sprite_andy.6502"
    .andy_end
    ENDSECTION
    ASSERT andy_end <= &9000
    ASSERT andy_load + (andy_end - &8000) + PAD_END <= &C000, "bank 5 overruns its 16K by ", andy_load + (andy_end - &8000) + PAD_END - &C000
    SKIP PAD_END
ENDSECTION

SECTION DATA3, org = &8000, load = &FFFF1900, exec = &FFFF1900, filename = "DATA3", cmos = TRUE
    SKIP PAD_START
    INCLUDE "bank6.6502"
    INCLUDE "compiled_bank6.6502"   \ step 2 layer 4: compiled kinds of the player's parts
IF GAMEPLAY_TIMER
    INCLUDE "timer.6502"            \ decision 47: the timer (called through timer_tick_call: ROMSEL &06)
ENDIF
    ASSERT * + PAD_END <= &C000, "bank 6 overruns its 16K by ", * + PAD_END - &C000
    SKIP PAD_END
ENDSECTION

SECTION DATA4, org = &8000, load = &FFFF1900, exec = &FFFF1D00, filename = "DATA4", cmos = TRUE
    SKIP PAD_START
    INCLUDE "bank7.6502"
    INCLUDE "compiled_bank7.6502"   \ step 2 layer 4: compiled kinds of the player's parts
IF DITHER_HILLS
    INCLUDE "mountains_one.6502"    \ decision 64: out of bank 4, for MOUNTAINS_TWO's dither
ENDIF
IF GAMEPLAY_RUN
    INCLUDE "run.6502"              \ decision 52: the run meter (timer_tick_call pages bank 7 for it)
ENDIF
IF GAMEPLAY_TIMER
    INCLUDE "timer_bonus.6502"      \ decisions 47, 59: the time bonus (timer_bonus_call pages bank 7)
ENDIF
    ASSERT * + PAD_END <= &C000, "bank 7 overruns its 16K by ", * + PAD_END - &C000
    SKIP PAD_END
ENDSECTION

\ ---------------------------------------------------------------------------------------------
\ SCREEN: the title picture, *RUN by SRRUN at &2E71.
\ ---------------------------------------------------------------------------------------------
\ Its own scope: it shares many label names with the game's sprite unpacker.
SECTION SCREEN, org = &2100, load = &FFFF2100, exec = &FFFF0000 + title.title_entry_point, filename = "SCREEN", cmos = TRUE
.title
{
    INCLUDE "title.6502"
}
ENDSECTION

INCLUDE "loader.6502"
