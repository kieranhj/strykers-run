\ timer.6502 - GAMEPLAY_TIMER (decision 47; docs/briefs/gameplay-shield.md): a game timer in seconds
\ of the design speed (25 passes), shown on the top line after the shield's bar. Its mode, timer_mode
\ (set at a game's start: the build's GAMEPLAY_TIMER, or the game rules screen's, decision 46):
\   1  counting up from 0; at the headquarters, 10 points for each second under the par (timer_limit)
\      (completion_screen: timer_bonus)
\   2  counting down from timer_limit; at 0 the game is over; at the headquarters, 10 points for
\      each second left
\   0  off: nothing shown, no bonus
\ Sideways bank 6, called through timer_tick_call and timer_bonus_call (main RAM: they page bank 6 in
\ and bank 4 back). It reads and writes only zero page and main RAM: hud_buffer, the score digits
\ (game_over_text + 20 on, font offsets: "0" &6C, 6 a digit) and lives.

\ TIMER_LIMIT (src/zp.6502, 10 minutes) is the start counting down and the par counting up; the game
\ rules screen's limit replaces it (decision 55): timer_limit, set at the game's start (BCD, high first)

\ timer_tick: once a pass (main_game_loop, after shield_tick)
TIMER_MM    = HUD_TIMER             \ decision 59: the byte offsets in hud_buffer of the minutes' two digits,
TIMER_COLON = HUD_TIMER + 32        \ the colon, the seconds' two, the point and the tenth
TIMER_SS    = HUD_TIMER + 40
TIMER_POINT = HUD_TIMER + 72
TIMER_TENTH = HUD_TIMER + 80

.timer_tick
{
    LDA timer_ready
    BNE ready
    STZ timer_hi                    \ 65C02 opcodes
    STZ timer_lo
    STZ time_up
    LDA timer_mode
    CMP #2
    BNE start_set
    LDA timer_limit                 \ decision 55
    STA timer_hi
    LDA timer_limit + 1
    STA timer_lo
.start_set
    STZ timer_frac
    LDA #0                          \ the digits' blank rows and the column after them, once
    LDX #8 * TIMER_COLUMNS - 1
.clear
    STA hud_buffer + HUD_TIMER,X
    DEX
    BPL clear
    DEC timer_ready                 \ &FF
    LDA timer_mode
    BNE start_show                  \ off: the digits stay blank
    RTS
.start_show                         \ decision 59: the colon and the point, once; the rest forced to draw
    LDA #&28                        \ a left pixel, black: the colon's rows 3 and 5, the point's 6
    STA hud_buffer + TIMER_COLON + 3
    STA hud_buffer + TIMER_COLON + 5
    STA hud_buffer + TIMER_POINT + 6
    LDA #&FF
    STA last_t
    STA last_lo
    JMP show
.ready
    LDA timer_mode
    BEQ out_off
    INC timer_frac
    LDA timer_frac
    CMP #25                         \ a second of the design speed
    BCC show                        \ (decision 59: the tenths each pass)
    STZ timer_frac
    SED
    LDA timer_mode
    CMP #2
    BNE up
    LDA timer_lo
    ORA timer_hi
    BEQ out                         \ (already over)
    SEC
    LDA timer_lo
    SBC #1
    STA timer_lo
    LDA timer_hi
    SBC #0
    STA timer_hi
    CLD
    ORA timer_lo
    BNE show
    DEC time_up                     \ time is up: shield_tick shows the skeleton, then the game is
    BRA show                        \ over (time_up_now, src/shield_hi.6502). 65C02 opcode
.out
    CLD
.out_off
    RTS
.up
    CLC
    LDA timer_lo
    ADC #1
    STA timer_lo
    LDA timer_hi
    ADC #0
    CMP #&10                        \ held at 999
    BCS held
    STA timer_hi
    CLD
    BRA show                        \ 65C02 opcode
.held
    LDA #&99
    STA timer_lo
    CLD
    BRA show                        \ 65C02 opcode
.show
\ decision 59 (KC: "make the timer be MM:SS.t"): the seconds count as before (BCD, timer_hi/lo, the
\ game's rules and the bonus read them); what is shown is worked out each pass: counting up, the
\ seconds and a tenth from the pass in the second (timer_frac, 0-24); counting down, what is left
\ (a second less once the second has begun, and the tenths of the passes left in it). Only what changed is drawn
\ (the tenth every 2-3 passes, the minutes and seconds once a second), and then hud_serial bumped
    STZ changed                     \ 65C02 opcodes
    LDX timer_frac
    LDA timer_lo
    STA shown_lo
    LDA timer_hi
    STA shown_hi
    LDA timer_mode
    CMP #2
    BNE shown_up
    TXA
    BEQ whole                       \ counting down at the second's start: S.0
    LDA timer_lo
    ORA timer_hi
    BEQ whole                       \ (or at 0: time is up)
    SED                             \ a second less, and 9 less the tenth of the pass before
    LDA timer_lo
    SEC
    SBC #1
    STA shown_lo
    LDA timer_hi
    SBC #0
    STA shown_hi
    CLD
    LDA #25                         \ the tenths of the passes left in this second (25 - frac)
    SEC
    SBC timer_frac
    TAX
    JSR tenth
    BRA shown_t                     \ 65C02 opcode
.whole
    LDA #0
    BRA shown_t
.shown_up
    JSR tenth
.shown_t
    CMP last_t
    BEQ same_tenth
    STA last_t
    LDY #TIMER_TENTH
    JSR digit
    INC changed
.same_tenth
    LDA shown_lo
    CMP last_lo
    BNE new_second
    LDA shown_hi
    CMP last_hi
    BEQ shown_done
.new_second
    LDA shown_lo
    STA last_lo
    LDA shown_hi
    STA last_hi
    INC changed
    LDA shown_lo                    \ the seconds in binary (0-999): units, + 10 a ten, + 100 a hundred
    AND #15
    STA n_lo
    STZ n_hi
    LDA shown_lo
    LSR A
    LSR A
    LSR A
    LSR A
    TAX
    BEQ tens_done
.tens
    LDA n_lo
    CLC
    ADC #10
    STA n_lo
    DEX
    BNE tens
.tens_done
    LDX shown_hi
    BEQ hundreds_done
.hundreds
    LDA n_lo
    CLC
    ADC #100
    STA n_lo
    BCC hundred_page
    INC n_hi
.hundred_page
    DEX
    BNE hundreds
.hundreds_done
    LDX #0                          \ minutes: 60s taken away
.minutes
    LDA n_lo
    SEC
    SBC #60
    TAY
    LDA n_hi
    SBC #0
    BCC minutes_done
    STA n_hi
    STY n_lo
    INX
    BRA minutes                     \ 65C02 opcode
.minutes_done
    LDA n_lo                        \ the seconds, kept: two_digits uses n_lo
    PHA
    TXA
    LDY #TIMER_MM
    JSR two_digits
    PLA
    LDY #TIMER_SS
    JSR two_digits
.shown_done
    LDA changed
    BEQ done
    INC hud_serial                  \ the renderer redraws the top line
.done
    RTS

\ tenth: X (a pass in the second, 0-24) as a tenth: 2 * X DIV 5
.tenth
    TXA
    ASL A
    LDY #&FF
.fifths
    INY
    SEC
    SBC #5
    BCS fifths
    TYA
    RTS

\ two_digits: A (0-99) as two digits at Y and Y + 16
.two_digits
    LDX #0
.ten
    CMP #10
    BCC units
    SBC #10                         \ C = 1
    INX
    BRA ten                         \ 65C02 opcode
.units
    PHA
    STY n_lo                        \ (the seconds' binary is no longer needed)
    TXA
    JSR digit
    LDA n_lo
    CLC
    ADC #16
    TAY
    PLA
    JMP digit



\ digit: A (0-9) into hud_buffer at Y (its two byte columns' rows 2-6, in black, colour 6)
.digit
    STA digit_tmp
    ASL A
    ASL A
    ADC digit_tmp                   \ 5 * A, C = 0 (at most 45)
    TAX
    LDA #5
    STA digit_tmp
.row
    LDA font_3x5,X                  \ bits 2-0: its three pixels, left to right
    LSR A                           \ C = the third
    PHY                             \ 65C02 opcodes
    TAY
    LDA left_two,Y                  \ bits 2, 1: the first byte column's two pixels
    PLY
    STA hud_buffer + 2,Y
    BCC no_third
    LDA #&28                        \ bit 0: the second's left pixel (its right one the gap)
    BNE third                       \ always
.no_third
    LDA #0
.third
    STA hud_buffer + 8 + 2,Y
    INX
    INY
    DEC digit_tmp
    BNE row
    RTS
.left_two                           \ two pixels (bit 1 left, bit 0 right) in black, as a byte
    EQUB &00, &14, &28, &3C
.digit_tmp
    EQUB 0
.font_3x5                           \ 0-9, five rows each, top down, three pixels in bits 2-0
    EQUB 7, 5, 5, 5, 7              \ 0
    EQUB 2, 6, 2, 2, 7              \ 1
    EQUB 7, 1, 7, 4, 7              \ 2
    EQUB 7, 1, 7, 1, 7              \ 3
    EQUB 5, 5, 7, 1, 1              \ 4
    EQUB 7, 4, 7, 1, 7              \ 5
    EQUB 7, 4, 7, 5, 7              \ 6
    EQUB 7, 1, 1, 1, 1              \ 7
    EQUB 7, 5, 7, 5, 7              \ 8
    EQUB 7, 5, 7, 1, 7              \ 9
}
