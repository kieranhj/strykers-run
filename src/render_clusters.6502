\ render_clusters.6502 - decision 73 (MODEL_B: one screen, drawn in the beam's order): the clusters
\ render.6502 draws as units. Bank 4 under ANDY: these run with ROMSEL &04 only (render's step 4
\ and behind the beam; group_on, which pages ANDY for put_on, cluster_build and pick_cluster are in
\ render.6502, for room).

\ ---- clusters (decision 73: one screen, drawn in the beam's order) ------------------------------
\ In the workspace after ren_vars_d (render.6502 REN_CL): list_cl, cl_thr, then the scalars.
list_cl     = REN_BASE + REN_CL         \ each list entry's cluster: a label (an entry's index), CL_STAY if
CL_STAY     = &FF                   \ its slot stays, CL_DONE once drawn
CL_DONE     = &FE
cl_zone     = REN_BASE + REN_CL + 70        \ the zone's cluster (&FF: none)
cl_from     = REN_BASE + REN_CL + 71
cl_to       = REN_BASE + REN_CL + 72
cl_best     = REN_BASE + REN_CL + 73
cl_key      = REN_BASE + REN_CL + 74
cl_cur      = REN_BASE + REN_CL + 75
cl_y        = REN_BASE + REN_CL + 76
cl_pdef     = REN_BASE + REN_CL + 79    \ the player's cluster, held for behind the beam (&FF: none)
ASSERT MOVER_SLOTS + 1 <= 35 AND REN_CL + 80 <= &800

\ group_off: A = a cluster (&FF none). Its movers off: the player first (drawn last), then the
\ others from the last slot down (the list is in slot order)
.group_off
{
    STA cl_cur
    CMP #&FF
    BEQ out
    LDA list_n
    BEQ out
    LDA list_slot                   \ the player, when listed, is entry 0
    BNE movers
    LDA list_cl
    CMP cl_cur
    BNE movers
    LDX #0
    JSR take_off
.movers
    LDY list_n
.each
    DEY
    BMI out
    LDA list_cl,Y
    CMP cl_cur
    BNE each
    LDA list_slot,Y
    BEQ each                        \ the player: above
    TAX
    STY cl_y
    JSR take_off
    LDY cl_y
    JMP each
.out
    RTS
}

\ cluster_thresholds: cl_thr for each cluster: T2's high byte's count down from &FF at which the beam has
\ passed its lowest line, a row more (its bytes are a column right in the last frame: at the right edge, the
\ row below), in the last frame's last field: the beam's line is about 4 * (&FF - T2CH) - 56, so a
\ member's lowest line 199 - y1 is passed with a row to spare from ((255 - y1) >> 2) + 4 (from 3 to 67)
DISPLAY_END_E = 64                  \ &FF - T2CH from 64: line 200 on, the display over (16,384 us from the vsync)
BB_STOP_E = 56                      \ no cluster started behind the beam from line 168 on: one started later would
                                    \ hold the zone's (the scroll's column, the lives digit) past the blank's start
.cluster_thresholds
{
    LDX list_n
.clear
    LDA #0
    STA cl_thr,X                    \ (labels are entry indices: list_n + 1 bytes from cl_thr cover them)
    DEX
    BPL clear
    LDX list_n
.each
    DEX
    BMI out
    LDY list_cl,X
    CPY #CL_DONE
    BCS each
    LDA list_y1,X
    EOR #&FF
    LSR A
    LSR A
    ADC #4                          \ (C clear from the LSR's bit 1... or not: a line either way)
    CMP cl_thr,Y
    BCC each
    STA cl_thr,Y
    BCS each                        \ always
.out
    RTS
}

\ behind_beam: in the last frame's last field, while it displays, each cluster (but the zone's) whose lowest
\ line the beam has passed, off and on; then, its display over (or T's vsync passed), back. field_count is
\ read before T2: a vsync between the two leaves T2 high, so nothing seems passed and it goes round again.
.behind_beam
{
.loop
    LDA flip_target
    SEC
    SBC field_count
    CMP #1
    BNE out                         \ T's vsync has passed: late, the rest ahead of the beam
    LDA #&FF
    SEC
    SBC usrvia_t2ch
    CMP #BB_STOP_E
    BCS ending                      \ the display nearly over: the zone's next, in the blank
    STA cl_e
    LDX list_n
.each
    DEX
    BMI loop                        \ none passed yet: again
    LDY list_cl,X
    CPY #CL_DONE
    BCS each
    CPY cl_zone
    BEQ each
    LDA cl_thr,Y
    CMP cl_e
    BEQ ready
    BCS each
.ready
    TYA
    PHA
    JSR group_off
    PLA
    JSR group_on
    JMP loop
.ending                             \ until the display is over: the scroll's column is on screen until
    LDA flip_target                 \ then, as the last frame's left column a row down
    SEC
    SBC field_count
    CMP #1
    BNE out
    LDA #&FF
    SEC
    SBC usrvia_t2ch
    CMP #DISPLAY_END_E
    BCC ending
.out
    RTS
}
cl_thr      = REN_BASE + REN_CL + 35           \ (each cluster's: labels are entry indices)

IF PLAYER_HOLD
\ player_first (KC, 2026-10-25: "tighten up the timing for the player sprite plotting"): the player's
\ cluster straight after the zone's, in the blank if it can be: the eye is on the player, who stays put
\ while the screen scrolls under them. Taken off and put on with the beam inside it, part of it is
\ shown missing for a field (the flicker); so it goes now only if it can be done before the beam reaches
\ its top line in T, allowing PLAYER_E (T2 counts of 4 lines) for it. Else it is held (cl_pdef): the
\ others go ahead of the beam, then player_behind draws it once the beam has passed it, whole a field late.
PLAYER_E = 28                       \ 112 lines: its take off and put on together, about p90 (jsbeeb, 2026-10-25;
                                    \ 36 held more and tore more, beamcheck seed 1)
PLAYER_SPARE = 4                    \ player_behind's row more
.player_first
{
    LDA #&FF
    STA cl_pdef
    LDA list_n
    BEQ out
    LDA list_slot                   \ the player, when listed, is entry 0
    BNE out
    LDA list_cl
    CMP #CL_DONE
    BCS out                         \ done with the zone's, or staying
    STA cl_pdef
    LDA #0                          \ its top: its entries' greatest list_y2 (y counts up the screen)
    STA cl_key
    LDX list_n
.top
    DEX
    BMI topped
    LDA list_cl,X
    CMP cl_pdef
    BNE top
    LDA list_y2,X
    CMP cl_key
    BCC top
    STA cl_key
    BCS top                         \ always
.topped
    LDA #255                        \ the count at which the beam reaches its top line, 199 - y2:
    SEC                             \ (255 - y2) >> 2, as cluster_thresholds counts
    SBC cl_key
    LSR A
    LSR A
    STA cl_key
    LDA flip_target                 \ the beam's count now: field_count read before T2 (behind_beam)
    SEC
    SBC field_count
    BMI now                         \ T has gone: the beam is in a later field, from its top
    BEQ in_t
    LDA #0                          \ T's not begun: still the blank before it, so as at its vsync
    BEQ budget                      \ (always)
.in_t
    LDA #&FF
    SEC
    SBC usrvia_t2ch
.budget
    CLC
    ADC #PLAYER_E
    BCS out                         \ (held)
    CMP cl_key
    BCS out                         \ not done before the beam reaches it: held
.now
    LDA cl_pdef
    PHA
    JSR group_off
    PLA
    JSR group_on
    LDA #&FF
    STA cl_pdef
.out
    RTS
}

\ player_behind: a held player's cluster, once the beam has passed its lowest line (cl_thr: a row to
\ spare) in T, or at once if T has gone (the beam is above it, from the next field's top)
.player_behind
{
    LDX cl_pdef
    CPX #&FF
    BEQ out
.wait
    LDA flip_target
    SEC
    SBC field_count
    BMI go                          \ T has gone
    BNE wait                        \ T's not begun
    LDA #&FF
    SEC
    SBC usrvia_t2ch
    SEC                             \ a row more than the others' threshold: its bytes reached a row past
    SBC #PLAYER_SPARE               \ it in T (jsbeeb, 2026-10-25: rows 23-24 with the beam at row 23)
    BCC wait
    CMP cl_thr,X
    BCC wait
.go
    TXA
    PHA
    JSR group_off
    PLA
    JSR group_on
.out
    RTS
}
ENDIF
cl_e        = REN_BASE + REN_CL + 77
