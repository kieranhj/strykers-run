\ shield.6502 - GAMEPLAY_SHIELD (decision 44; docs/briefs/gameplay-shield.md): a recharging shield of
\ two units, in place of the original's lives as hit points (each hit a life). Bank 4 under ANDY:
\ called by the logic, which runs with ROMSEL &04 (measured at not_game_over, the hostile collision
\ and every hit on the player, 3,000 passes, 2026-10-20). Its hooks in the main block: shield_hit
\ before kill_player, shield_tick in main_game_loop, hit_type in check_for_hostile_collision, and
\ shield_new_game (main RAM: start_game runs with bank 5 paged).

SHIELD_UNIT  = 25                   \ a unit: the refill's second, at the design speed's 25 passes
SHIELD_FULL  = 2 * SHIELD_UNIT
SHIELD_WAIT  = 125                  \ passes without damage before it refills: 5 seconds
SHIELD_FLASH = 12                   \ passes the bar flashes after a hit

\ shield_hit: the player hit on foot (kill_mover_Y's path for the player, just before kill_player).
\ The damage by what hit: 2 units for an explosive (grenade &10, bomb &11, rocket &12, mine &13,
\ shell &1B), else 1, stopping at 0. With the shield at 0 the hit is the original's: RTS goes on to
\ kill_player (a life), and the shield is full again. Otherwise the shield takes it and kill_player
\ is skipped: its return address dropped, on to plot_mover with Y = 0, as kill_player's hits with
\ lives left went (to_plot_mover_2957).
.shield_hit
{
IF GAMEPLAY_LIVES
    LDA invulnerable                \ decision 45: just respawned, nothing counts
    BNE skipped
ENDIF
    LDX hostile_mover               \ the player ran into it: its type as the collision found it
    BEQ by_update                   \ (kill_mover may have made it an explosion since);
    BMI by_update                   \ 0 or none: the mover being updated hit the player
    LDA hit_type
    BRA_JMP typed                   \ 65C02 opcode
.by_update
    LDX mover_to_update
    LDA #0                          \ not a mover slot: 1 unit
    CPX #&22
    BCS typed
    LDA movers_type_and_colour,X
.typed
    AND #&7F
    LDX shield_unit                 \ decision 50: the game rules' (or SHIELD_UNIT)
    CMP #&10                        \ MOVER_TYPE_GRENADE
    BCC damage
    CMP #&14                        \ MOVER_TYPE_TANK: the grenade, bomb, rocket and mine below it
    BCC double
    CMP #&1B                        \ MOVER_TYPE_SHELL
    BNE damage
.double
    LDX shield_unit2
.damage
    STX shield_tmp
    LDA shield_recharge             \ decision 50: the game rules' (or SHIELD_WAIT)
    STA shield_wait
    LDA #SHIELD_FLASH
    STA shield_flash
    LDA shield
    BEQ through
    SEC
    SBC shield_tmp
    BCS taken
    LDA #0                          \ the damage stops at 0
.taken
    STA shield
    LDA #9                          \ decision 69: its own sound, a metallic tink (effect 8, src/sfx_gameplay.6502)
    JSR shield_sound
.skipped
    PLA                             \ the death skipped: its sounds and kill_player
    PLA
    LDY #0                          \ MOVER_PLAYER
    JMP to_plot_mover_2957
.through
    LDA #SHIELD_FULL                \ a life goes (kill_player): the shield full again
    STA shield
    STZ_LDA shield_wait             \ 65C02 opcode
    RTS
}

IF MB_GAMEPLAY = 0
    INCLUDE "shield_tick.6502"      \ the tick and the refill's tone (MB_GAMEPLAY: in bank 7, decision 76)
ELSE
\ shield_sound: shield_hit's (shield_tick.6502's own copy is in bank 7 with it)
.shield_sound
{
    LDY sound_muted
    BNE done
    STA sfx_request + 1
.done
    RTS
}
ENDIF

IF GAMEPLAY_LIVES
\ ---- decision 45: lives that respawn -----------------------------------------------------------
\ Every death is the skeleton (kill_player, under GAMEPLAY_LIVES). When its animation is over,
\ update_player comes here: with lives left, the view goes back RESPAWN_COLUMNS columns, a column a
\ pass (the renderer's history holds a scroll a pass a screen), the player hidden and the rest of the
\ logic stopped; then the player stands there, shield full, safe for RESPAWN_SAFE passes. With none,
\ the game is over as the original's.
.player_dead
{
    LDA lives
    BNE rewind
    LDA #&50
    STA game_over_cooldown
    DEC lives                       \ Set to negative to indicate game over
    RTS
.rewind
    LDA respawn_columns             \ RESPAWN_COLUMNS, or the game rules screen's (decision 46)
    STA respawn_left
    LDA movers_x_high
    STA respawn_x_hi
    LDA #&FF                        \ the player hidden: no mover in slot 0 for the renderer or the edge
    STA movers_x_high               \ (its x low byte goes on: the trigger points read it)
    RTS
}

\ player_or_rewind: main_game_loop's update_player, or while a rewind is under way a column of it:
\ the player (hidden) and the view one column back, the frame drawn and shown, and the pass ends
\ there (the projectiles and the movers stand still)
.player_or_rewind
{
    LDA respawn_left
    BNE rewind
    JMP update_player
.rewind
    LDA viewport_left_low           \ at the world's start: no further back
    ORA viewport_left_high
    BEQ arrived
    LDA movers_x_low                \ the player a column back, and its screen address with it (the
    BNE same_page                   \ renderer places it by that, so it must be right when it shows)
    DEC respawn_x_hi
.same_page
    DEC movers_x_low
    LDX movers_screen_address_high
    LDA movers_screen_address_low
    LDY #0                          \ &0008: a column
    JSR subtract_delta_from_screen_address_in_AX
    STA movers_screen_address_low
    STX movers_screen_address_high
    JSR rewind_column               \ main RAM: scroll_screen_left, then the frame
    DEC respawn_left
    BNE pass_over
.arrived
    JSR respawn
.pass_over
    PLA                             \ main_game_loop's JSR: the rest of the pass skipped
    PLA
    JMP main_game_loop
}

.respawn
{
    STZ_LDA respawn_left            \ 65C02 opcodes
    LDA respawn_x_hi
    STA movers_x_high               \ the player back, where the view has left it
    STZ_LDA movers_type_and_colour  \ MOVER_TYPE_PLAYER: a soldier again
    STZ_A movers_frame_and_flip     \ standing, facing right
    STZ_A flip
    STZ_A frame
    STZ_A player_y_velocity
    STZ_A player_jump_direction
    STZ_A player_firing_cooldown
    LDA #SHIELD_FULL
    STA shield
    STZ_LDA shield_wait
    LDA #RESPAWN_SAFE
    STA invulnerable
    STA shield_flash                \ the bar flashes while it lasts
    RTS
}
ENDIF
