\ render_bss.6502 - the renderer's variables (decision 32): not in the
\ file; in bytes of the renderer's workspace (render.6502, REN_BASE on) that no table uses, and
\ zeroed once at start-up (src/render_bss_zero.6502, from unpack_for_play) as the file's zeros were. Each region
\ is within one page, so no table here crosses one.

SECTION ren_vars_z, org = REN_BASE + REN_Z, cmos = CMOS
.ren_vars_z_start
.acc_main       SKIP 1              \ ACCCON with the CPU on main RAM, and on shadow
.acc_shadow     SKIP 1
.last_vl_lo     SKIP 1
.last_vl_hi     SKIP 1
.hist_edge_lo   SKIP 2
.hist_edge_hi   SKIP 2
.hist_ss_lo     SKIP 2
.hist_ss_hi     SKIP 2
.hist_crtc_lo   SKIP 2
.hist_crtc_hi   SKIP 2
.hist_vl_lo     SKIP 2
.hist_vl_hi     SKIP 2
.hist_vr_lo     SKIP 2
.hist_vr_hi     SKIP 2
.hist_dir       SKIP 2
.hist_seqs      SKIP 2
\ per screen (0, 1), and slot 2 for the logic's live view while a screen is drawn
.buf_seq        SKIP 2
.buf_lives      SKIP 2
.buf_ss_lo      SKIP 3
.buf_ss_hi      SKIP 3
.buf_crtc_lo    SKIP 3
.buf_crtc_hi    SKIP 3
.buf_vl_lo      SKIP 3
.buf_vl_hi      SKIP 3
.buf_vr_lo      SKIP 3
.buf_vr_hi      SKIP 3
.pending_slot   SKIP 2
.zone_lo        SKIP 4              \ the columns two scrolls write or leave
.zone_hi        SKIP 4
.lz_lo          SKIP 2              \ the lives digit's ranges (add_lives_zone), at one or two views:
.lz_hi          SKIP 2              \ each by its last column
.lz_n           SKIP 1
.span_w2        SKIP 1
\ the masked renderer's
.arena_top_lo   SKIP 2           \ per screen: the end of its arena's used part
.arena_top_hi   SKIP 2
.act            SKIP MOVER_SLOTS
IF SKY_MODE
\ sky mode (src/sky.6502): the rectangle being drawn or erased, by character row q (0 at its bottom):
\ its left cell, its top line, its lines, its block in the image
.sky_rl         SKIP SKY_ROWS
.sky_rh         SKIP SKY_ROWS
.sky_rt         SKIP SKY_ROWS
.sky_rn         SKIP SKY_ROWS
.sky_rb         SKIP SKY_ROWS
.sky_rc         SKIP SKY_ROWS       \ 8 * its first column, from the first drawn (one split at &8000)
.sky_ry         SKIP SKY_ROWS       \ 8 * its last
.sky_ytop       SKIP 1              \ 8 * its last column drawn, from the first
.sky_d1         SKIP 1              \ its columns drawn, as the image numbers them
.sky_d2         SKIP 1
.sky_e1         SKIP 1              \ sky_edges: the old rectangle's columns still drawn
.sky_e2         SKIP 1
.sky_wx         SKIP 2              \ sky_edges: the rectangle's column 0 in the world, a column's,
.sky_cx         SKIP 2              \ the geometry's first
.sky_c0         SKIP 1
ELSE
\ the kind cache (layer 4, decision 36: src/kindcache.6502): per slot its key (sprite, line, pixel
\ table), the save blocks drawn from it, when it was last drawn, and its bytes by character row
.kc_sprite      SKIP KC_SLOTS       \ &FF: empty
.kc_line        SKIP KC_SLOTS
.kc_plo         SKIP KC_SLOTS
.kc_phi         SKIP KC_SLOTS
.kc_ref         SKIP KC_SLOTS
.kc_age         SKIP KC_SLOTS
.kc_gcnt        SKIP KC_SLOTS * KC_GROUPS
.kc_clock       SKIP 1              \ renders, for kc_age
.kc_want        SKIP 1              \ the kind asked for: its sprite (&FF none), line, pixel and mask
.kc_want_line   SKIP 1              \ tables, flip
.kc_want_plo    SKIP 1
.kc_want_phi    SKIP 1
.kc_want_mlo    SKIP 1
.kc_want_mhi    SKIP 1
.kc_want_flip   SKIP 1
.kc_raise       SKIP 1              \ the part's rows raised (ren_draw_sprite's Y)
.kc_cur         SKIP 1
.kc_pl          SKIP KC_GROUPS      \ the character rows' left cells, for a draw or a restore
.kc_ph          SKIP KC_GROUPS
.kc_sv          SKIP 2
.kc_off         SKIP 2              \ a row's place in its slot's arrays
.kc_cnt         SKIP 1
.kc_q           SKIP 1
.kc_gi          SKIP 1
\ what a build keeps from one wait to the next (src/kindcache_build.6502)
.kb_active      SKIP 1              \ non-zero: a build is under way (render_reset clears it)
.kb_sprite      SKIP 1              \ its kind: sprite, line, pixel and mask tables, flip (as kc_want)
.kb_line        SKIP 1
.kb_plo         SKIP 1
.kb_phi         SKIP 1
.kb_mlo         SKIP 1
.kb_mhi         SKIP 1
.kb_flip        SKIP 1
.kb_col         SKIP 2              \ the next column to fill
.kg_c           SKIP 1              \ columns left
.kg_j8          SKIP 1              \ 8 * the next column's j
.kg_slot        SKIP 1
.kg_best        SKIP 1
.kg_n_lo        SKIP 1              \ the part's bytes
.kg_n_hi        SKIP 1
.kg_tc          SKIP KC_GROUPS      \ its bytes by character row
.kg_e           SKIP KC_GROUPS      \ each row's bytes written so far
ENDIF
.cp_cursor_lo   SKIP 1
.cp_cursor_hi   SKIP 1
.cp_y           SKIP 1
.cp_n           SKIP 1
.ren_vars_z_end
ENDSECTION
ASSERT ren_vars_z_end - ren_vars_z_start <= &DE, "ren_vars_z overruns its hole"
ASSERT HI(ren_vars_z_start) = HI(ren_vars_z_end - 1)

SECTION ren_vars_a, org = REN_BASE + &380, cmos = CMOS
.ren_vars_a_start
.list_slot      SKIP MOVER_SLOTS + 1
.list_x1_lo     SKIP MOVER_SLOTS + 1
.list_x1_hi     SKIP MOVER_SLOTS + 1
.ren_vars_a_end
ENDSECTION
ASSERT ren_vars_a_end - ren_vars_a_start <= &78, "ren_vars_a overruns its hole"
ASSERT HI(ren_vars_a_start) = HI(ren_vars_a_end - 1)

SECTION ren_vars_d, org = REN_BASE + REN_D, cmos = CMOS
.ren_vars_d_start
.list_x2_lo     SKIP MOVER_SLOTS + 1
.list_x2_hi     SKIP MOVER_SLOTS + 1
.list_y1        SKIP MOVER_SLOTS + 1
IF SKY_MODE = 0
.kg_byl         SKIP KC_GROUPS      \ kc_build: where each character row's arrays start (offsets,
.kg_byh         SKIP KC_GROUPS      \ masks, pixels)
.kg_bml         SKIP KC_GROUPS
.kg_bmh         SKIP KC_GROUPS
ENDIF
.ren_vars_d_end
ENDSECTION
ASSERT ren_vars_d_end - ren_vars_d_start <= &80, "ren_vars_d overruns its hole"
ASSERT HI(ren_vars_d_start) = HI(ren_vars_d_end - 1)

SECTION ren_vars_h0, org = REN_BASE + &4C8, cmos = CMOS
.ren_vars_h0_start
.list_y2        SKIP MOVER_SLOTS + 1
IF SKY_MODE = 0
.kg_bpl         SKIP KC_GROUPS
.kg_bph         SKIP KC_GROUPS
ENDIF
.ren_vars_h0_end
ENDSECTION
ASSERT ren_vars_h0_end - ren_vars_h0_start <= &38, "ren_vars_h0 overruns its hole"
ASSERT HI(ren_vars_h0_start) = HI(ren_vars_h0_end - 1)

SECTION ren_vars_h1, org = REN_BASE + &5C8, cmos = CMOS
.ren_vars_h1_start
.cp_list        SKIP MOVER_SLOTS    \ compact: the live blocks (slot + boff), by start address
.cp_start_lo    SKIP 1
.cp_start_hi    SKIP 1
.cp_len_lo      SKIP 1
.cp_len_hi      SKIP 1
.cp_next_lo     SKIP 1
.cp_stop        SKIP 1
.ren_vars_h1_end
ENDSECTION
ASSERT ren_vars_h1_end - ren_vars_h1_start <= &38, "ren_vars_h1 overruns its hole"
ASSERT HI(ren_vars_h1_start) = HI(ren_vars_h1_end - 1)

