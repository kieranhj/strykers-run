\ loader.6502 - the boot: !BOOT, INFO and SRRUN.
\
\ The Stairway to Hell disc booted a BASIC menu (LOAD) offering the standard or the enhanced
\ version; for the enhanced one it did *TV255,1 and *FX200,3 then *RUN SRRUN. This disc is the
\ enhanced version only (decision 3), so !BOOT does those two things itself, prints the build
\ stamp and runs SRRUN. SRRUN is the STH file, byte for byte.
\ INCLUDEd by src/main.6502 outside any section.

\ ---------------------------------------------------------------------------------------------
\ SRRUN: show the title picture, fill banks 4-7, run the game. Runs at &0A00.
\
\ 2026-10-24 (KC: "do the file packing"): SCREEN, DATA1-4 and MGAME are on the disc as ZX02 streams
\ (tools/packdisc.py, after Baron), 59-62% of their size, so the load reads ~33K less. Each is
\ loaded at its catalogue load address (OSFILE 5 reads it, OSFILE &FF loads there) and unpacked:
\ SCREEN to &2100, then run; DATA1-4 into banks 4-7 from &8000; MGAME to &1900, in place (its
\ stream ends at &5A80, under the loading picture: packdisc.py checks the margin), then its stub
\ copies it down to &0E00 as before. STH's SRRUN *RAN SCREEN, *LOADed each DATAn to &1900 and
\ copied 16K into its bank, then *RAN MGAME.
\ "ZX02" in this file is how the tools know the disc's files are packed (tools/dfs.py game_files).
\ It runs through &0AFF into &0B00 (the soft keys' page, unused while it runs).
\ ---------------------------------------------------------------------------------------------
srrun_bank = &70                \ the bank being filled, 4 to 7
PACK_FILES = (SHIFT = 0)        \ the relocation test builds load unpacked (tools/packdisc.py lays them out only)

SECTION SRRUN, org = &0A00, load = &FFFF0A00, exec = &FFFF0A00, filename = "SRRUN", cmos = TRUE
IF PACK_FILES
{
zxsrc = &71                     \ the depacker's zero page: user zero page, not the filing system's
zxdst = &73                     \ &B0-&CF, which it is called between
zxofs = &75
zxbit = &76
zxwrk = &77

.srrun
    LDX #LO(srrun_screen)
    LDY #HI(srrun_screen)
    JSR srrun_load                  \ SCREEN: the loading picture's code, unpacked to &2100 and run
    LDA #LO(&2100)
    LDY #HI(&2100)
    JSR srrun_unpack
    JSR title.title_entry_point
    LDA #4
    STA srrun_bank
.srrun_load_loop
    LDX #LO(srrun_data)
    LDY #HI(srrun_data)
    JSR srrun_load                  \ DATAn, unpacked into bank n + 3 from &8000
    SEI
    LDA srrun_bank
    STA romsel
    LDA #LO(&8000)
    LDY #HI(&8000)
    JSR srrun_unpack
    LDA romsel_copy                 \ give the MOS its ROM back
    STA romsel
    CLI
    INC srrun_data_digit            \ DATA1 -> DATA2 -> ...
    INC srrun_bank
    LDA srrun_bank
    CMP #8
    BNE srrun_load_loop
    LDX #LO(srrun_mgame)
    LDY #HI(srrun_mgame)
    JSR srrun_load                  \ MGAME, unpacked in place to where it always loaded
    LDA #LO(GAME_LOAD)
    LDY #HI(GAME_LOAD)
    JSR srrun_unpack
    JMP mgame_relocate              \ its copy-down stub, which runs the game

\ The file named at YX loaded at its own load address; zxsrc points at it
.srrun_load
    STX srrun_block
    STY srrun_block + 1
    LDA #5                          \ OSFILE 5: its catalogue entry, the load address at block + 2
    JSR srrun_osfile
    LDA #&FF
    STA srrun_block + 6             \ not 0: OSFILE &FF loads at the file's own address
    JSR srrun_osfile
    LDA srrun_block + 2
    STA zxsrc
    LDA srrun_block + 3
    STA zxsrc + 1
    RTS
.srrun_osfile
    LDX #LO(srrun_block)
    LDY #HI(srrun_block)
    JMP osfile

\ Unpack the stream at zxsrc to YA
.srrun_unpack
    STA zxdst
    STY zxdst + 1
.zx_unpack
    ZX02_DEPACKER

.srrun_screen
    EQUS "SCREEN", 13
.srrun_data
    EQUS "DATA"
.srrun_data_digit
    EQUS "1", 13
.srrun_mgame
    EQUS "MGAME", 13
    EQUS "ZX02"                     \ the tools' sign that this disc's files are packed
.srrun_block                        \ OSFILE's control block (not in the file)
    ASSERT srrun_block + 18 <= &0C00, "SRRUN overruns &0BFF by ", srrun_block + 18 - &0C00
}
ELSE                                \ relocation test builds (SHIFT): the files as Baron wrote them, so the
                                    \ control and the shifted build load in exactly the same time (lockstep)
.srrun
    LDX #LO(srrun_run_screen)
    LDY #HI(srrun_run_screen)
    JSR oscli                       \ *RUN SCREEN: the title picture
    LDA #4
    STA srrun_bank
.srrun_load_loop
    LDX #LO(srrun_load_data)
    LDY #HI(srrun_load_data)
    JSR oscli                       \ *LOAD DATAn - each file has its own load address
    JSR srrun_copy_to_bank
    INC srrun_load_data_digit       \ DATA1 -> DATA2 -> ...
    INC srrun_bank
    LDA srrun_bank
    CMP #8
    BNE srrun_load_loop
    LDX #LO(srrun_run_game)
    LDY #HI(srrun_run_game)
    JMP oscli                       \ *RUN MGAME

\ Copy &1900-&58FF to &8000-&BFFF in bank srrun_bank.
.srrun_copy_to_bank
    LDA #&19
    STA srrun_copy_src + 2
    LDA #&80
    STA srrun_copy_dst + 2
    SEI
    LDA srrun_bank
    STA romsel
.srrun_copy_page
    LDY #0
.srrun_copy_loop
srrun_copy_src = *
    EQUB &B9 : EQUW 0               \ LDA &xx00,Y - absolute; the page is set above
srrun_copy_dst = *
    EQUB &99 : EQUW 0               \ STA &xx00,Y
    INY
    BNE srrun_copy_loop
    INC srrun_copy_src + 2
    INC srrun_copy_dst + 2
    LDA srrun_copy_dst + 2
    CMP #&C0
    BNE srrun_copy_page
    LDA romsel_copy                 \ give the MOS its ROM back
    STA romsel
    CLI
    RTS

.srrun_run_screen
    EQUS "RUN SCREEN", 13
.srrun_load_data
    EQUS "LOAD DATA"
srrun_load_data_digit = *
    EQUS "1", 13
.srrun_run_game
    EQUS "RUN MGAME", 13
ENDIF
ENDSECTION

\ ---------------------------------------------------------------------------------------------
\ The build stamp (beeb-port-kit's boot_stamp): INFO is a disc file *TYPE reads. !BOOT *TYPEs it
\ on a debug build (RELEASE=0) but not on a release build (KC, 2026-10-24; it printed the stamp
\ itself before), then *TV255,1, *FX200,3, *RUN SRRUN.
\ ---------------------------------------------------------------------------------------------
INCLUDE "lib/boot_stamp.6502"

BOOT_STAGE = &0900
INFO_STAGE = &7E00

MACRO BUILD_STAMP
    BOOT_STAMP_HEAD "Stryker's Run (Enhanced), Master 128"
    BOOT_FLAG DEBUG_LIVES, "DEBUG_LIVES"
    BOOT_FLAG DEBUG_FULLREDRAW, "DEBUG_FULLREDRAW"
    BOOT_FLAG SHIFT, "SHIFT: relocation test"
    BOOT_STAMP_TIME
ENDMACRO

SECTION Info, org = INFO_STAGE, guard = INFO_STAGE + 256, filename = "INFO"
.infofile
    BUILD_STAMP
.infofile_end
ENDSECTION

SECTION Boot, org = BOOT_STAGE, guard = BOOT_STAGE + 256, filename = "!BOOT", exec = &FFFF0000 + bootfile
.bootfile
    LDA #0                          \ OSBYTE 0, X = 1: X = the MOS. 3 the Master 128 (MOS 3.20, 3.50),
    LDX #1                          \ 5 the Master Compact (MOS 5.x); 1 a BBC B, 2 a B+ (the B and the
    JSR osbyte                      \ Master measured in jsbeeb, 2026-10-21; it has no Compact or B+).
    CPX #3                          \ The game needs a Master's 65C12, sideways RAM 4-7, shadow RAM,
    BEQ boot_on_a_master            \ ANDY and HAZEL: anything else stops here, before loading
    CPX #5                          \ (6502 opcodes only up to here, so a B runs it)
    BEQ boot_on_a_master
    LDX #boot_refused - boot_text
    JMP boot_print                  \ the reason, then back to the prompt (boot_print's RTS)
.boot_on_a_master
    LDX #0                          \ MODE 7's cursor off for the load (KC, 2026-10-24): VDU 23,1,0;0;0;0;
.boot_cursor_off
    LDA boot_cursor_vdu,X
    JSR oswrch
    INX
    CPX #10
    BNE boot_cursor_off
IF RELEASE = 0
    LDX #LO(boot_type_info)         \ a debug build shows its stamp: *TYPE INFO
    LDY #HI(boot_type_info)
    JSR oscli
ENDIF
    LDA #&90                        \ *TV255,1: display moved up a line, interlace off
    LDX #255
    LDY #1
    JSR osbyte
    LDA #200                        \ *FX200,3: ESCAPE disabled, memory cleared on BREAK
    LDX #3
    LDY #0
    JSR osbyte
    LDX #LO(boot_run)
    LDY #HI(boot_run)
    JMP oscli
.boot_print                         \ the text from boot_text + X to its 0
    LDA boot_text,X
    BEQ boot_printed
    JSR osasci
    INX
    BNE boot_print
.boot_printed
    RTS
.boot_cursor_vdu
    EQUB 23, 1, 0, 0, 0, 0, 0, 0, 0, 0
.boot_text
.boot_refused
    EQUS "Needs a BBC Master 128 or Compact.", 13
    EQUB 0
IF RELEASE = 0
.boot_type_info
    EQUS "TYPE INFO", 13
ENDIF
.boot_run
    EQUS "RUN SRRUN", 13
.bootfile_end
ENDSECTION
